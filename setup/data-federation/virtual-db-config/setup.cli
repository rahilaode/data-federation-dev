connect

# Deploy JDBC Drivers
#
# MySQL note: the Teiid MySQL translator expects an ANSI-mode session
# (Teiid Reference Guide, JDBC translators > MySQL translator > Usage) and
# escapes only single quotes in string literals
# (SQLConversionVisitor.translateSQLType -> escapeString). In the default
# MySQL sql_mode the backslash is an escape character, so the literal '\\'
# produced by Ontop IRI unfolding breaks the SQL (error 1064). Every pooled
# connection is therefore set to ANSI,NO_BACKSLASH_ESCAPES. The setting only
# applies to Teiid sessions; the global configuration of the source is not changed.
deploy /opt/jboss/jdbc/mysql-connector-java-8.0.21.jar   
/subsystem=datasources/data-source=mysql-ds:add(jndi-name=java:/mysql-dukcapil, enabled=true, use-java-context=true, driver-name=mysql-connector-java-8.0.21.jar, connection-url="jdbc:mysql://datasources-mysql:3306/dukcapil",user-name=mysql, password=mysql, new-connection-sql="set SESSION sql_mode = 'ANSI,NO_BACKSLASH_ESCAPES'")
/subsystem=datasources/data-source=mysql-ds:enable

deploy /opt/jboss/jdbc/postgresql-42.2.14.jre7.jar
/subsystem=datasources/data-source=pgsql-ds:add(jndi-name=java:/pgsql-kemensos, enabled=true, use-java-context=true, driver-name=postgresql-42.2.14.jre7.jar, connection-url="jdbc:postgresql://datasources-pgsql:5432/kemensos",user-name=postgres, password=postgres)
/subsystem=datasources/data-source=pgsql-ds:enable

# ------------------------------------------------------------------
# The VDB is NO longer deployed when the image is built.
# The VDB (government-vdb.xml) is deployed by the deployment scanner
# from the standalone/deployments folder mounted from the host, so
# ASCAM (the effector of the Execute phase) can redeploy Σ'_S without
# restarting the Teiid container.
#
# The scanner is switched to MANUAL DEPLOY MODE for XML files:
# a redeploy only happens when a <name>.dodeploy marker is created,
# so the Executor fully controls the order of execution
# (see the WildFly Core deployments README, section DEPLOYMENT MODES).
# ------------------------------------------------------------------
/subsystem=deployment-scanner/scanner=default:write-attribute(name=auto-deploy-xml, value=false)
