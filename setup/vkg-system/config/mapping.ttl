# Running example of the paper, extended with one small table per Plan branch
# (docs/running-example.md). Triples maps read the Teiid VDB "example": model src (S1,
# PostgreSQL), model reg (S2, MySQL), model v (views).
@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix ex: <http://example.org/> .

# Example 1 of the paper: m with φ_m = SELECT * FROM v_active, t_m = ex:person/{id},
# C_m = {ex:ActivePerson}, POM_m = {(ex:name, name)}; assertions a1 (class) and a2 (ex:name)
<#TM_ActivePerson> a rr:TriplesMap ;
    rr:logicalTable [ rr:sqlQuery "SELECT * FROM v.v_active" ] ;
    rr:subjectMap [ rr:template "http://example.org/person/{id}" ; rr:class ex:ActivePerson ] ;
    rr:predicateObjectMap [ rr:predicate ex:name ; rr:objectMap [ rr:column "name" ] ] .

# Every person with a nickname; ex:nickname is also filled from S2 (TM_Member). The query lists
# its columns, so a new column of person reaches no triples map (P-001 builds a new one).
<#TM_PersonNick> a rr:TriplesMap ;
    rr:logicalTable [ rr:sqlQuery "SELECT id, nickname FROM src.person" ] ;
    rr:subjectMap [ rr:template "http://example.org/person/{id}" ; rr:class ex:Person ] ;
    rr:predicateObjectMap [ rr:predicate ex:nickname ; rr:objectMap [ rr:column "nickname" ] ] .

# One triples map fills ex:phone from two columns (two assertions)
<#TM_Contact> a rr:TriplesMap ;
    rr:logicalTable [ rr:sqlQuery "SELECT id, phone, phone2 FROM src.contact" ] ;
    rr:subjectMap [ rr:template "http://example.org/contact/{id}" ; rr:class ex:Contact ] ;
    rr:predicateObjectMap [ rr:predicate ex:phone ; rr:objectMap [ rr:column "phone" ] ] ;
    rr:predicateObjectMap [ rr:predicate ex:phone ; rr:objectMap [ rr:column "phone2" ] ] .

# fax is named in the query but used in no triple (role: projection only)
<#TM_ContactEmail> a rr:TriplesMap ;
    rr:logicalTable [ rr:sqlQuery "SELECT id, email, fax FROM src.contact" ] ;
    rr:subjectMap [ rr:template "http://example.org/contact/{id}" ] ;
    rr:predicateObjectMap [ rr:predicate ex:email ; rr:objectMap [ rr:column "email" ] ] .

# net_price is an expression over price and discount (view v_net_price)
<#TM_Product> a rr:TriplesMap ;
    rr:logicalTable [ rr:sqlQuery "SELECT * FROM v.v_net_price" ] ;
    rr:subjectMap [ rr:template "http://example.org/product/{id}" ; rr:class ex:Product ] ;
    rr:predicateObjectMap [ rr:predicate ex:netPrice ; rr:objectMap [ rr:column "net_price" ] ] .

# rr:tableName: a new column of city reaches this map (X is not empty)
<#TM_City> a rr:TriplesMap ;
    rr:logicalTable [ rr:tableName "src.city" ] ;
    rr:subjectMap [ rr:template "http://example.org/city/{id}" ; rr:class ex:City ] ;
    rr:predicateObjectMap [ rr:predicate ex:cityName ; rr:objectMap [ rr:column "name" ] ] .

# Three maps over account, two classes and one without a class
<#TM_Account> a rr:TriplesMap ;
    rr:logicalTable [ rr:tableName "src.account" ] ;
    rr:subjectMap [ rr:template "http://example.org/account/{id}" ; rr:class ex:Account ] ;
    rr:predicateObjectMap [ rr:predicate ex:owner ; rr:objectMap [ rr:column "owner" ] ] .

<#TM_Customer> a rr:TriplesMap ;
    rr:logicalTable [ rr:sqlQuery "SELECT * FROM src.account" ] ;
    rr:subjectMap [ rr:template "http://example.org/customer/{id}" ; rr:class ex:Customer ] .

<#TM_AccountRecord> a rr:TriplesMap ;
    rr:logicalTable [ rr:tableName "src.account" ] ;
    rr:subjectMap [ rr:template "http://example.org/record/{id}" ] ;
    rr:predicateObjectMap [ rr:predicate ex:owner ; rr:objectMap [ rr:column "owner" ] ] .

# Over the UNION view v_events, which selects * from event
<#TM_Event> a rr:TriplesMap ;
    rr:logicalTable [ rr:sqlQuery "SELECT * FROM v.v_events" ] ;
    rr:subjectMap [ rr:template "http://example.org/event/{id}" ; rr:class ex:Event ] ;
    rr:predicateObjectMap [ rr:predicate ex:kind ; rr:objectMap [ rr:column "kind" ] ] .

# tool has no weight column; ex:weight is declared and deprecated in the ontology
<#TM_Tool> a rr:TriplesMap ;
    rr:logicalTable [ rr:sqlQuery "SELECT id, label FROM src.tool" ] ;
    rr:subjectMap [ rr:template "http://example.org/tool/{id}" ; rr:class ex:Tool ] ;
    rr:predicateObjectMap [ rr:predicate ex:label ; rr:objectMap [ rr:column "label" ] ] .

# Base tables of the notification scenarios: each table is read directly, the view that makes
# a DROP unsafe is defined in model v (v_note_body, v_memo, v_doc_cache)
<#TM_Note> a rr:TriplesMap ;
    rr:logicalTable [ rr:sqlQuery "SELECT id, body FROM src.note" ] ;
    rr:subjectMap [ rr:template "http://example.org/note/{id}" ; rr:class ex:Note ] ;
    rr:predicateObjectMap [ rr:predicate ex:noteBody ; rr:objectMap [ rr:column "body" ] ] .

<#TM_Memo> a rr:TriplesMap ;
    rr:logicalTable [ rr:sqlQuery "SELECT id, body FROM src.memo" ] ;
    rr:subjectMap [ rr:template "http://example.org/memo/{id}" ; rr:class ex:Memo ] ;
    rr:predicateObjectMap [ rr:predicate ex:memoBody ; rr:objectMap [ rr:column "body" ] ] .

<#TM_Doc> a rr:TriplesMap ;
    rr:logicalTable [ rr:sqlQuery "SELECT id, body FROM src.doc" ] ;
    rr:subjectMap [ rr:template "http://example.org/doc/{id}" ; rr:class ex:Doc ] ;
    rr:predicateObjectMap [ rr:predicate ex:docBody ; rr:objectMap [ rr:column "body" ] ] .

# staff.town_legacy (NAMEINSOURCE town) is not mapped: Teiid would query a missing column
<#TM_Staff> a rr:TriplesMap ;
    rr:logicalTable [ rr:sqlQuery "SELECT id, city FROM src.staff" ] ;
    rr:subjectMap [ rr:template "http://example.org/staff/{id}" ; rr:class ex:Staff ] ;
    rr:predicateObjectMap [ rr:predicate ex:city ; rr:objectMap [ rr:column "city" ] ] .

# S2 (MySQL)
<#TM_Member> a rr:TriplesMap ;
    rr:logicalTable [ rr:sqlQuery "SELECT member_id, nama, panggilan, phone FROM reg.member" ] ;
    rr:subjectMap [ rr:template "http://example.org/member/{member_id}" ; rr:class ex:Member ] ;
    rr:predicateObjectMap [ rr:predicate ex:fullName ; rr:objectMap [ rr:column "nama" ] ] ;
    rr:predicateObjectMap [ rr:predicate ex:nickname ; rr:objectMap [ rr:column "panggilan" ] ] ;
    rr:predicateObjectMap [ rr:predicate ex:phone ; rr:objectMap [ rr:column "phone" ] ] .
