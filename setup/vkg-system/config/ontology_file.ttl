    sql:label "Block name (column: baaAreaPolyBlockName)",
        "Block name (column: blcName)",
        "Block name (column: prlAreaPolyBlockName)" .

npdv:codeEW a owl:DatatypeProperty ;
    sql:column "facility_fixed.fclEwCode",
        "wellbore_coordinates.wlbEwCode",
        "wellbore_development_all.wlbEwCode",
        "wellbore_exploration_all.wlbEwCode",
        "wellbore_shallow_all.wlbEwCode" ;
    sql:comment "Indicator which tells if the coordinate is in the eastern or western hemisphere. Example of legal values: E, W (column: fclEwCode)",
        "Indicator which tells if the coordinate of the wellhead is on the eastern or western hemisphere. Legal values: E, W. (column: wlbEwCode)" ;
    sql:datatype "VARCHAR(1) (column: fclEwCode)",
        "VARCHAR(1) (column: wlbEwCode)" ;
    sql:label "EW code (column: fclEwCode)",
        "EW code (column: wlbEwCode)" ;
    rdfs:range xsd:string .

npdv:companyShare a owl:DatatypeProperty ;
    sql:column "company_reserves.cmpShare",
        "field_licensee_hst.fldCompanyShare" ;
    sql:comment "Company's share in percent (column: fldCompanyShare)" ;
