npdv:Pipeline a owl:Class ;
    sql:columns "pipCurrentPhase,pipDimension,pipLineGeometryWKT,pipMainGrouping,pipMedium,pipName,pipNameCurrentOperator,pipNameFromFacility,pipNameToFacility,pipNpdidFromFacility,pipNpdidOperator,pipNpdidPipe,pipNpdidToFacility (table: pipLine)" ;
    sql:label "Main pipelines. The dataset contains not infield pipelines. (table: pipLine)" ;
    sql:table "pipLine" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty npdv:name ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:pipelineMedium ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:currentStatus ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:pipelineToFacility ;
            owl:someValuesFrom owl:Thing ],
        [ a owl:Restriction ;
            owl:onProperty geo:asWKT ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:pipelineOperator ;
            owl:someValuesFrom npdv:Company ],
        [ a owl:Restriction ;
            owl:onProperty npdv:pipelineDimension ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:idNPD ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:pipelineFromFacility ;
            owl:someValuesFrom owl:Thing ],
        [ a owl:Restriction ;
            owl:onProperty npdv:pipelineMainGrouping ;
            owl:someValuesFrom rdfs:Literal ],
        npdv:Facility .

geo:asWKT a owl:DatatypeProperty ;
    rdfs:label "asWKT"@en ;
    dc:contributor "Matthew Perry" ;
    dc:creator "OGC GeoSPARQL 1.0 Standard Working Group" ;
    dc:description """
      The WKT serialization of a geometry
    """@en ;
    sql:column "apaAreaGross.apaAreaGeometryEWKT",
        "apaAreaNet.apaAreaNetGeometryWKT",
        "baaArea.baaAreaGeometryWKT",
        "dscArea.flddscAreaGeometryWKT_ED50",
        "fclPoint.fclPointGeometryWKT",
        "fldArea.flddscAreaGeometryWKT_ED50",
        "pipLine.pipLineGeometryWKT",
        "prlArea.prlAreaGeometryWKT",
        "prlAreaSplitByBlock.prlAreaGeometryWKT",
        "seaArea.seaPolyGeometryWKT",
        "seaMultiline.seaMultilineGeometryWKT",
        "wlbPoint.wlbPointGeometryWKT" ;
    rdfs:comment """
      The WKT serialization of a geometry
    """@en ;
    rdfs:domain geo:Geometry ;
    rdfs:isDefinedBy <http://www.opengis.net/ont/geosparql>,
        <http://www.opengis.net/spec/geosparql/1.0> ;
    rdfs:subPropertyOf geo:hasSerialization ;
    skos:definition """
      The WKT serialization of a geometry
    """@en .

