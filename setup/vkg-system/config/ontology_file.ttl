            owl:someValuesFrom npdv:BAA ],
        [ a owl:Restriction ;
            owl:onProperty npdv:dateSyncNPD ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:transferDirection ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:baaTransferCompany ;
            owl:someValuesFrom npdv:Company ],
        npdv:Transfer .

npdv:DiscoveryReserve a owl:Class ;
    sql:columns "dateSyncNPD,dscDateOffResEstDisplay,dscName,dscNpdidDiscovery,dscRecoverableCondensate,dscRecoverableGas,dscRecoverableNGL,dscRecoverableOil,dscReservesDateUpdated,dscReservesRC (table: discovery_reserves)" ;
    sql:label "Discovery: Reserves (table: discovery_reserves)" ;
    sql:table "discovery_reserves" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty npdv:dateSyncNPD ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:idNPD ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:dateResourceEstimate ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:recoverableOil ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:recoverableGas ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:recoverableCondensate ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:reservesForDiscovery ;
            owl:someValuesFrom npdv:Discovery ],
        [ a owl:Restriction ;
            owl:onProperty npdv:dateUpdated ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:reservesResourceClass ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:recoverableNGL ;
            owl:someValuesFrom rdfs:Literal ],
        npdv:Reserve .

npdv:Equipment a owl:Class ;
    rdfs:isDefinedBy "http://sws.ifi.uio.no/vocab/version/20130919/npd-facility" ;
    rdfs:subClassOf <http://www.ifomis.org/bfo/1.1/snap#Object> .

npdv:ExplorationWell a owl:Class ;
    npdv:definition "The Resource Management Regulations define an exploration well as a well that is drilled to prove potential petroleum deposits, or to obtain information needed to delineate a proven deposit.  The NPD grants permission for exploration drilling, and assigns the proper designation to the wellbore. Such a permit must be granted for the respective well or wellbore before drilling activity is initiated. The permit is granted on the basis of registration applications and drilling programs, and on the condition that all other permits and consents required by other authorities have been secured.  Exploration wells are divided in two categories: wildcat wells and appraisal wells.  Source: http://www.npd.no/en/Topics/Wells/Temaartikler/Established-practice-for-well-designation/" ;
    rdfs:isDefinedBy "http://sws.ifi.uio.no/vocab/version/20130919/npd-well" ;
    rdfs:subClassOf npdv:Well .

npdv:FieldInvestment a owl:Class ;
    sql:columns "dateSyncNPD,prfInformationCarrier,prfInvestmentsMillNOK,prfNpdidInformationCarrier,prfYear (table: field_investment_yearly)" ;
    sql:label "Field: Investments, yearly (table: field_investment_yearly)" ;
    sql:table "field_investment_yearly" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty npdv:productionYear ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:investmentForField ;
            owl:someValuesFrom npdv:Field ],
        [ a owl:Restriction ;
            owl:onProperty npdv:investmentNOK ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:dateSyncNPD ;
            owl:someValuesFrom rdfs:Literal ],
        <http://www.ifomis.org/bfo/1.1/span#ProcessualEntity> .

npdv:MoveableFacility a owl:Class ;
    npdv:definition "A facility or installation not intended to be permanently located on the field during the lifetime of the field; for instance, a drilling platform or a well intervention device (see § 3 of the Directions for the Framework Provisions).  Source: http://www.npd.no/en/About-us/Information-services/Dictionary/ " ;
    sql:columns "dateSyncNPD,fclCurrentRespCompanyName,fclDateUpdated,fclFactPageUrl,fclFunctions,fclKind,fclName,fclNationName,fclNpdidCurrentRespCompany,fclNpdidFacility (table: facility_moveable)" ;
    sql:comment "Mobile facilities are facilities not meant to be permanently placed on the field during the lifetime of the field, for example mobile drilling units. (table: facility_moveable)" ;
    sql:label "Facility: Moveable (table: facility_moveable)" ;
    sql:table "facility_moveable" ;
    rdfs:isDefinedBy "http://sws.ifi.uio.no/vocab/version/20130919/npd-facility" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty npdv:currentResponsibleCompany ;
            owl:someValuesFrom npdv:Company ],
        [ a owl:Restriction ;
            owl:onProperty npdv:facilityType ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:name ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:idNPD ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:dateSyncNPD ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:factPageURL ;
            owl:someValuesFrom owl:Thing ],
        [ a owl:Restriction ;
            owl:onProperty npdv:registeredInCountry ;
            owl:someValuesFrom owl:Thing ],
        npdv:Facility .

npdv:Owner a owl:Class ;
    rdfs:subClassOf npdv:Agent .

npdv:ProductionLicenceOperator a owl:Class ;
    sql:columns "cmpLongName,cmpNpdidCompany,dateSyncNPD,prlName,prlNpdidLicence,prlOperDateUpdated,prlOperDateValidFrom,prlOperDateValidTo (table: licence_oper_hst)" ;
