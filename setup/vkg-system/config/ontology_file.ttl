    gtrs-30:nextEra isc:Berriasian,
        isc:Cretaceous,
        isc:LowerCretaceous ;
    gtrs-30:previousEra isc:Jurassic,
        isc:Tithonian,
        isc:UpperJurassic .

isc:BaseJurassic a gts-30:GeochronologicBoundary,
        owl:NamedIndividual,
        skos:Concept ;
