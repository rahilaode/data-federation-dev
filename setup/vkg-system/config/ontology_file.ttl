        "NS degrees (column: wlbNsDeg)" ;
    rdfs:range xsd:integer .

npdv:factMapURL a owl:ObjectProperty ;
    sql:column "bsns_arr_area.baaFactMapUrl",
        "discovery.dscFactMapUrl",
        "facility_fixed.fclFactMapUrl",
        "field.fldFactMapUrl",
        "licence.prlFactMapUrl",
        "wellbore_development_all.wlbFactMapUrl",
        "wellbore_exploration_all.wlbFactMapUrl" ;
    sql:comment "URL to the business arrangement area's FactMap on the NPD's FactWEB (column: baaFactMapUrl)",
        "URL to the discovery's FactMap on NPDs FactWEB (column: dscFactMapUrl)",
        "URL to the facility's fact map on NPD's FactWEB (column: fclFactMapUrl)",
        "URL to the production licence's FactMap on NPD's FactWEB (column: prlFactMapUrl)",
        "URL to the wellbores's FactMap on NPD's FactWEB. (column: wlbFactMapUrl)" ;
    sql:datatype "VARCHAR(200) (column: baaFactMapUrl)",
        "VARCHAR(200) (column: dscFactMapUrl)",
        "VARCHAR(200) (column: fclFactMapUrl)",
        "VARCHAR(200) (column: fldFactMapUrl)",
        "VARCHAR(200) (column: prlFactMapUrl)",
        "VARCHAR(200) (column: wlbFactMapUrl)" ;
    sql:label "Fact map (column: baaFactMapUrl)",
        "Fact map (column: dscFactMapUrl)",
        "Fact map (column: fclFactMapUrl)",
        "Fact map (column: prlFactMapUrl)",
        "FactMap url (column: wlbFactMapUrl)" .

npdv:mainAreaLocation a owl:ObjectProperty ;
    sql:column "discovery.nmaName",
        "licence.prlMainArea",
        "seis_acquisition.seaGeographicalArea",
        "wellbore_coordinates.wlbMainArea",
        "wellbore_development_all.wlbMainArea",
        "wellbore_exploration_all.wlbMainArea",
        "wellbore_shallow_all.wlbMainArea" ;
    sql:comment "Main NCS area. Example of legal values: NORTH SEA, NORWEGIAN SEA, BARENTS SEA (column: nmaName)",
        "Name of the area on the Norwegian Continental Shelf where the wellbore is located. Example of legal values: Barents Sea, Norwegian Sea, North Sea (column: prlMainArea)",
        "Name of the area on the Norwegian Continental Shelf where the wellbore is located. Legal values: BARENTS SEA, NORWEGIAN SEA, NORTH SEA. (column: wlbMainArea)" ;
    sql:datatype "VARCHAR(100) (column: seaGeographicalArea)",
        "VARCHAR(40) (column: nmaName)",
        "VARCHAR(40) (column: prlMainArea)",
        "VARCHAR(40) (column: wlbMainArea)" ;
    sql:label "Main NCS area (column: nmaName)",
        "Main area (column: prlMainArea)",
        "Main area (column: wlbMainArea)" .

