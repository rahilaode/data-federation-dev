npdv:name a owl:DatatypeProperty ;
    sql:column "bsns_arr_area.baaName",
        "company.cmpLongName",
        "discovery.dscName",
        "facility_fixed.fclName",
        "facility_moveable.fclName",
        "field.fldName",
        "licence.prlName",
        "licence_task.prlTaskName",
        "licence_task.wlbName",
        "pipLine.pipName",
        "seis_acquisition.seaName",
        "tuf_operator_hst.tufName",
        "tuf_owner_hst.tufName",
        "tuf_petreg_licence.tufName",
        "wellbore_development_all.wlbNamePart1",
        "wellbore_development_all.wlbNamePart2",
        "wellbore_development_all.wlbWellboreName",
        "wellbore_exploration_all.wlbNamePart1",
        "wellbore_exploration_all.wlbNamePart2",
        "wellbore_exploration_all.wlbWellboreName",
        "wellbore_formation_top.lsuName",
        "wellbore_npdid_overview.wlbWell",
        "wellbore_npdid_overview.wlbWellboreName",
        "wellbore_shallow_all.wlbNamePart2",
        "wellbore_shallow_all.wlbWellboreName" ;
    sql:comment "NPD's official discovery name (column: dscName)",
        "NPD's official field name (column: fldName)",
        "Name of task as given by the NPD. This task is a part of the work obligations of the production licence. (column: prlTaskName)",
        "Name of the facility used by NPD (column: fclName)",
        "Name of the production licence (column: prlName)",
        "Name of the transportation and utilisation facility (column: tufName)",
        "Name the seismic acquisition  (column: seaName)",
        "Official name of the parent well for the wellbore based on NPD guidelines for designation of wells and wellbores. (extra column: wellbore_npdid_overview.wlbWell)",
        "Official name of the wellbore based on NPD guidelines for designation of wells and wellbores. (column: wlbName)",
        "Official name of wellbore based on NPD guidelines for designation of wells and wellbores. (column: wlbWellboreName)",
        "The business arrangement area's official name. (column: baaName)",
        "The company's official name. (column: cmpLongName)",
        "The lithostratigraphic unit's official name. (extra column: wellbore_formation_top.lsuName)" ;
    sql:datatype "INTEGER",
        "VARCHAR(100) (column: seaName)",
        "VARCHAR(20)",
        "VARCHAR(200) (column: cmpLongName)",
        "VARCHAR(40)",
        "VARCHAR(40) (column: baaName)",
        "VARCHAR(40) (column: dscName)",
        "VARCHAR(40) (column: fclName)",
        "VARCHAR(40) (column: fldName)",
        "VARCHAR(40) (column: prlTaskName)",
        "VARCHAR(40) (column: tufName)",
        "VARCHAR(40) (column: wlbWellboreName)",
        "VARCHAR(50) (column: pipName)",
        "VARCHAR(50) (column: prlName)",
        "VARCHAR(60) (column: wlbName)" ;
    sql:label "Company name (column: cmpLongName)",
        "Discovery name (column: dscName)",
        "Field name (column: fldName)",
        "Lithostrat. unit (extra column: wellbore_formation_top.lsuName)",
        "Name (column: baaName)",
        "Name (column: fclName)",
        "Production licence (column: prlName)",
        "Survey name (column: seaName)",
        "TUF (column: tufName)",
        "Task name (norwegian) (column: prlTaskName)",
        "Well name (extra column: wellbore_npdid_overview.wlbWell)",
        "Wellbore name (column: wlbName)",
        "Wellbore name (column: wlbWellboreName)" ;
    rdfs:range xsd:string .

