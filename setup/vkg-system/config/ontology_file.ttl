    sql:construction "Foreign key strat_litho_wellbore_core.wlbNpdidWellbore => wellbore_npdid_overview.wlbNpdidWellbore",
        "Foreign key wellbore_core.wlbNpdidWellbore => wellbore_npdid_overview.wlbNpdidWellbore" ;
