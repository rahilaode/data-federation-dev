    sql:column "wellbore_development_all.wlbCompletionDate",
        "wellbore_exploration_all.wlbCompletionDate",
        "wellbore_shallow_all.wlbCompletionDate" ;
    sql:comment "The date when the anchor handling started. In case of jack-ups, the completion date is the date the jacking-down started. (column: wlbCompletionDate)" ;
    sql:datatype "DATETIME (column: wlbCompletionDate)" ;
    sql:label "Completion date (column: wlbCompletionDate)" ;
    rdfs:range xsd:date .

