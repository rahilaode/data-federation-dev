isc:GSSPBaseAquitanian a gts-30:GlobalStratotypePoint,
        owl:NamedIndividual ;
    rdfs:label "GSSP of Base Aquitanian" ;
    sampling:shape isc:BaseAquitanian-location ;
    dc:source "Episodes 20/1, p. 23  28, 1997"^^xsd:string ;
    gts-30:primaryGuidingCriterion "Lemme Carrioso Section, Allessandria Province, Italy | 35m from the top of the section Magnetic  base of Chron C6Cn.2n planktonic foraminifer FAD of Paragloborotalia kugleri calcareous nannofossil near LAD Reticulofenestra bisecta (base Zone NN1) Oxygen isotopic event Mi 1."@en ;
    gts-30:status "Ratified 1996 "@en .

