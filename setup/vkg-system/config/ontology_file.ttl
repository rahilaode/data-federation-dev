isc:GSSPBaseAeronian a gts-30:GlobalStratotypePoint,
        owl:NamedIndividual ;
    rdfs:label "GSSP of Base Aeronian" ;
    sampling:shape isc:BaseAeronian-location ;
    dc:source "Episodes 8/2, p. 101 103, 1985 "^^xsd:string,
        "Geol. Series, Nat. Mus. Wales, 9, p. 36 50, 1989"^^xsd:string ;
    gts-30:primaryGuidingCriterion "Trefawr Track Section, Wales, UK |  52.0300 N 3.7000 W |  within Trefawar Formation Graptolite FAD Monograptus austerus Sequens"@en ;
    gts-30:status "Ratified 1984"@en ;
    rdfs:seeAlso <http://stratigraphy.science.purdue.edu/references/Silurian1.pdf> .

isc:GSSPBaseBajocian a gts-30:GlobalStratotypePoint,
        owl:NamedIndividual ;
    rdfs:label "GSSP of Base Bajocian" ;
    sampling:shape isc:BaseBajocian-location ;
    dc:source "Episodes 20/1, p.16  22, 1997"^^xsd:string ;
    gts-30:primaryGuidingCriterion "Murtinheira Section, Cabo Mondego, Portugal |  base of Bed AB 11 |  Ammonite FAD Hyperlioceras mundum, Hyperlioceras furcatum, Braunsina aspera, and Braunsina elegantula"@en ;
    gts-30:status "Ratified 1996"@en ;
    rdfs:seeAlso <http://stratigraphy.science.purdue.edu/references/Bajocian.pdf> .

isc:GSSPBaseBathonian a gts-30:GlobalStratotypePoint,
        owl:NamedIndividual ;
    rdfs:label "GSSP of Base Bathonian" ;
    sampling:shape isc:BaseBathonian-location ;
    gts-30:primaryGuidingCriterion "Ravin du Bes, Bas Auran area, Alpes de Haute Provence, France  | base of limestone bed RB07 |Ammonite FAD Gonolkite convergens (defines base of Zigzagiceras zigzag Zone)"@en ;
    gts-30:status "Ratified 2008"@en .

isc:GSSPBaseCalabrian a gts-30:GlobalStratotypePoint,
        owl:NamedIndividual ;
    rdfs:label "GSSP of Base Calabrian" ;
    sampling:shape isc:BaseCalabrian-location ;
    dc:source "Episodes 8/2, p. 116  120, 1985"^^xsd:string ;
    gts-30:primaryGuidingCriterion "Vrica, Italy | base of the marine claystone overlying the sapropelic marker Bed  e (Mediterranean Precession Related Sapropel, MPRS 176) | Magnetic 15 kyr after end of Olduvai (C2n) normal polarity chron"@en ;
    gts-30:status "Ratified 1985"@en .

isc:GSSPBaseCapitanian a gts-30:GlobalStratotypePoint,
        owl:NamedIndividual ;
    rdfs:label "GSSP of Base Capitanian" ;
    sampling:shape isc:BaseCapitanian-location ;
    gts-30:primaryGuidingCriterion "Nipple Hill, SE Guadalupe Mountains, Texas, U.S.A | 4.5m above the base of the outcrop section of the Pinery Limestone Member of the Bell Canyon Formation | Conodont FAD Jinogondolella postserrata |"@en ;
    gts-30:status "Ratified 2001"@en .

isc:GSSPBaseCarboniferous a gts-30:GlobalStratotypePoint,
        owl:NamedIndividual ;
    rdfs:label "GSSP of Base Carboniferous" ;
    sampling:shape isc:BaseCarboniferous-location ;
    dc:source "Episodes 14/4, p. 331 336, 1991 Newsletters on Stratigraphy, 43/2, p. 195 205, 2009 "^^xsd:string ;
    gts-30:primaryGuidingCriterion "La Serre, France | base of Bed 89 in Trench E’ at La Serre, (but FAD now known to be at base of Bed 85)  | Conodont FAD Siphonodella sulcata IMPRECISE (GSSP discovered in 2006 to have biostratigraphic problems, and can not be correlated with precision.)"@en ;
    gts-30:status "Ratified 1990"@en .

isc:GSSPBaseCenozoic a gts-30:GlobalStratotypePoint,
        owl:NamedIndividual ;
    rdfs:label "GSSP of Base Cenozoic" ;
    sampling:shape isc:BaseCenozoic-location ;
    dc:source "Episodes 29/4, p. 263  278, 2006"^^xsd:string ;
    gts-30:primaryGuidingCriterion "Oued Djerfane, west of El Kef, Tunisia | reddish layer at the base of the 50cm thick, dark boundary clay | Iridium geochemical anomaly. Associated with a major extinction horizon (dinosaurs, ammonites, foraminifers, etc.)"@en ;
    gts-30:status "Ratified 1991"@en .

isc:GSSPBaseChanghsingian a gts-30:GlobalStratotypePoint,
        owl:NamedIndividual ;
    rdfs:label "GSSP of Base Changhsingian" ;
    sampling:shape isc:BaseChanghsingian-location ;
    dc:source "Episodes 29/3, p. 175 182, 2006"^^xsd:string ;
