npdv:dateWDSSQC a owl:DatatypeProperty ;
    sql:column "wellbore_development_all.wlbWdssQcdate",
        "wellbore_exploration_all.wlbWdssQcDate" ;
    sql:comment "Date the quality control of the wellbore information was completed, so that it can be pulished on internet as a 'Well Data Summary Sheet' wellbore with more information available than other wellbores. (column: wlbWdssQcDate)" ;
    sql:datatype "DATETIME (column: wlbWdssQcDate)",
        "DATETIME (column: wlbWdssQcdate)" ;
    sql:label "WDSS QC date (column: wlbWdssQcDate)" ;
    rdfs:range xsd:date .

