ptl:ProductionLicenceLicensee a owl:Class ;
    sql:columns "cmpLongName,cmpNpdidCompany,dateSyncNPD,prlNpdidLicence,ptlLicenseeDateUpdated,ptlLicenseeInterest,ptlName (table: licence_petreg_licence_licencee)" ;
    sql:label "Production Licence: Petroleum register, Licensees (table: licence_petreg_licence_licencee)" ;
    sql:table "licence_petreg_licence_licencee" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ptl:licenceLicenceeCompany ;
            owl:someValuesFrom npdv:Company ],
        [ a owl:Restriction ;
            owl:onProperty ptl:licenceeForLicence ;
            owl:someValuesFrom npdv:ProductionLicence ],
        [ a owl:Restriction ;
            owl:onProperty npdv:dateSyncNPD ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty ptl:licenseeInterest ;
            owl:someValuesFrom rdfs:Literal ],
        npdv:Licensee .

ptl:TUFLicensee a owl:Class ;
    sql:columns "cmpLongName,cmpNpdidCompany,dateSyncNPD,ptlLicenseeDateUpdated,ptlLicenseeInterest,ptlName,tufName,tufNpdidTuf (table: tuf_petreg_licence_licencee)" ;
