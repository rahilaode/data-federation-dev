npdv:sensorLength a owl:DatatypeProperty ;
    sql:column "seaArea.seaSensorLength",
        "seaMultiline.seaSensorLength" ;
    sql:comment "Length of the senors i metres. Not relevant if Sensor type = 'Noder' (Nodes in english) (column: seaSensorLength)" ;
