<http://www.ifomis.org/bfo/1.1/snap#IndependentContinuant> a owl:Class ;
    rdfs:label "independent_continuant"^^xsd:string ;
    rdfs:comment "Definition: A continuant [snap:Continuant] that is a bearer of quality [snap:Quality] and realizable entity [snap:RealizableEntity] entities, in which other entities inhere and which itself cannot inhere in anything."^^xsd:string,
        "Examples: an organism, a heart, a leg, a person, a symphony orchestra, a chair, the bottom right portion of a human torso, the lawn and atmosphere in front of our building"^^xsd:string,
        "Synonyms: substantial entity"^^xsd:string ;
    rdfs:subClassOf <http://www.ifomis.org/bfo/1.1/snap#Continuant> ;
    owl:disjointWith <http://www.ifomis.org/bfo/1.1/snap#SpatialRegion> .

isc:BaseDevonian a gts-30:GeochronologicBoundary,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Base of Devonian"@en ;
    temporal:position isc:BaseDevonianTime ;
    gtrs-30:nextEra isc:Devonian,
        isc:Lochkovian,
        isc:LowerDevonian ;
    gtrs-30:positionalUncertainty isc:BaseDevonianUncertainty ;
    gtrs-30:previousEra isc:Pridoli,
        isc:Silurian ;
    gts-30:stratotype isc:GSSPBaseDevonian .

isc:BaseGuadalupian a gts-30:GeochronologicBoundary,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Base of Guadalupian"@en ;
    temporal:position isc:BaseGuadalupianTime ;
    gtrs-30:nextEra isc:Guadalupian,
        isc:Roadian ;
    gtrs-30:positionalUncertainty isc:BaseGuadalupianUncertainty ;
    gtrs-30:previousEra isc:Capitanian,
        isc:Cisuralian,
        isc:Kungurian ;
    gts-30:stratotype isc:GSSPBaseGuadalupian .

isc:BasePennsylvanian a gts-30:GeochronologicBoundary,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Base of Pennsylvanian"@en ;
    temporal:position isc:BasePennsylvanianTime ;
    gtrs-30:nextEra <http://dbpedia.org/resource/Pennsylvanian>,
        isc:Bashkirian,
        isc:LowerPennsylvanian,
        isc:Pennsylvanian,
        <http://sweet.jpl.nasa.gov/2.2/stateTimeGeologic.owl#Pennsylvanian> ;
    gtrs-30:positionalUncertainty isc:BasePennsylvanianUncertainty ;
    gtrs-30:previousEra isc:Mississippian,
        isc:Serpukhovian ;
    gts-30:stratotype isc:GSSPBasePennsylvanian .

isc:BaseProterozoic a gts-30:StandardGlobalNumericalAge,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Base of Proterozoic"@en ;
    temporal:position isc:BaseProterozoicTime ;
    gtrs-30:nextEra isc:Paleoproterozoic,
        isc:Proterozoic,
        isc:Siderian ;
    gtrs-30:previousEra isc:Archean,
        isc:Neoarchean .

isc:Eoarchean a gts-30:GeochronologicEra,
        owl:NamedIndividual,
