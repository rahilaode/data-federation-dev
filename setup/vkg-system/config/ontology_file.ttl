npdv:DevelopmentWell a owl:Class ;
    npdv:definition "A generic term for wells used for production of petroleum, production wells, injection wells and observation wells, and possible combinations thereof.  Source: http://www.npd.no/en/Topics/Wells/Temaartikler/Well-definitions/",
        "Under the Resource Management Regulations, this is a common designation for wells used to produce petroleum.  The NPD assigns wellbore designations based on forms submitted by the operator. Development wells are divided into the categories production, injection and observation wells.  Source: http://www.npd.no/en/Topics/Wells/Temaartikler/Established-practice-for-well-designation/" ;
    rdfs:isDefinedBy "http://sws.ifi.uio.no/vocab/version/20130919/npd-well" ;
    rdfs:subClassOf npdv:Well .

