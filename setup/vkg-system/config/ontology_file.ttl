    sql:column "wellbore_development_all.wlbEntryDate",
        "wellbore_exploration_all.wlbEntryDate",
        "wellbore_shallow_all.wlbEntryDate" ;
    sql:comment "The date when the drill bit penetrated the earth's crust / sea floor. (column: wlbEntryDate)" ;
    sql:datatype "DATETIME (column: wlbEntryDate)" ;
    sql:label "Entry date (column: wlbEntryDate)" ;
    rdfs:range xsd:date .

npdv:definition a owl:AnnotationProperty .

npdv:dependsOnTask a owl:ObjectProperty .

npdv:designLifetime a owl:DatatypeProperty ;
    sql:column "facility_fixed.fclDesignLifetime" ;
    sql:comment "The number of years the facility was designed for. (column: fclDesignLifetime)" ;
    sql:datatype "INTEGER (column: fclDesignLifetime)" ;
    sql:label "Design lifetime [year] (column: fclDesignLifetime)" ;
    rdfs:domain npdv:FixedFacility ;
    rdfs:range xsd:integer .

npdv:facilityFunction a owl:DatatypeProperty ;
    sql:column "facility_fixed.fclFunctions",
        "facility_moveable.fclFunctions" ;
    sql:comment "Tells what functions the facility covers. Examples: DRILLING, DRILLING TEMPLATE, FIELD CONTROL CENTER, FISCAL METERING, FLARE STACK, FLOTEL, FULL STABILIZATION, GAS EXPORT, GAS INJECTION, GAS INJECTOR, GAS PRODUCER, ISOLATION VALVE, LOADING BOUY, MANIFOLD, MANIFOLD STATION, OFFLOADING, OIL PRODUCER, PIG RECIVER, PIPELINE END MANIFOLD, QUARTER, RISER, RISER BASE, RISER SUPPORT, SEPARATION, SILO, STORAGE, T-CONNECTION, TERMINAL, TRAWLGEAR PROTECTION, TUNNEL, UMBILICAL SUPPORT, WATER INJECTION, WATER/GAS INJECTION, WELLHEAD, Y-CONNECTION, PROCESSING, ACCOMMODATION, SUPPORT, BOOSTER, DISTRIBUTION, WATER PRODUCER or a combination of these. (column: fclFunctions)" ;
    sql:datatype "VARCHAR(400) (column: fclFunctions)" ;
    sql:label "Functions (column: fclFunctions)" .

npdv:geodeticDatum a owl:DatatypeProperty ;
    sql:column "facility_fixed.fclGeodeticDatum",
        "wellbore_coordinates.wlbGeodeticDatum",
        "wellbore_development_all.wlbGeodeticDatum",
        "wellbore_exploration_all.wlbGeodeticDatum",
        "wellbore_shallow_all.wlbGeodeticDatum" ;
    sql:comment "Geodetic datum for the coordinates of the position of the facility. (column: fclGeodeticDatum)",
        "Reference system for coordinates. Example of legal values: ED50. (column: wlbGeodeticDatum)" ;
    sql:datatype "VARCHAR(10) (column: fclGeodeticDatum)",
        "VARCHAR(6) (column: wlbGeodeticDatum)" ;
    sql:label "Geodetic datum (column: fclGeodeticDatum)",
        "Geodetic datum (column: wlbGeodeticDatum)" ;
    rdfs:range xsd:string .

npdv:hydrocarbonType a owl:DatatypeProperty ;
