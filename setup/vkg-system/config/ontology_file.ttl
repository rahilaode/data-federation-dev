# Ontology T of the running example (OWL 2 QL). Classes and data properties are declared;
# only ex:weight has a domain and a range, because it is the property that P-001 reuses. Its
# deprecation below is the block that P-002 writes, as if column tool.weight had been dropped
# earlier; a deprecation written by hand could not be withdrawn by ASCAM (P6).
@prefix ex: <http://example.org/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/ontology> a owl:Ontology ;
    rdfs:label "Running example of ASCAM" .

ex:Person a owl:Class .
ex:ActivePerson a owl:Class .
ex:Contact a owl:Class .
ex:Product a owl:Class .
ex:City a owl:Class .
ex:Account a owl:Class .
ex:Customer a owl:Class .
ex:Event a owl:Class .
ex:Tool a owl:Class .
ex:Member a owl:Class .
ex:Note a owl:Class .
ex:Memo a owl:Class .
ex:Doc a owl:Class .
ex:Staff a owl:Class .

ex:name a owl:DatatypeProperty .
ex:nickname a owl:DatatypeProperty .
ex:phone a owl:DatatypeProperty .
ex:email a owl:DatatypeProperty .
ex:netPrice a owl:DatatypeProperty .
ex:cityName a owl:DatatypeProperty .
ex:owner a owl:DatatypeProperty .
ex:kind a owl:DatatypeProperty .
ex:label a owl:DatatypeProperty .
ex:fullName a owl:DatatypeProperty .
ex:noteBody a owl:DatatypeProperty .
ex:memoBody a owl:DatatypeProperty .
ex:docBody a owl:DatatypeProperty .
ex:city a owl:DatatypeProperty .

ex:weight a owl:DatatypeProperty ;
    rdfs:domain ex:Tool ;
    rdfs:range xsd:decimal .

# ─── ASCAM-managed blocks (do not edit by hand) ───

# ascam:begin deprecate http://example.org/weight
ex:weight owl:deprecated true ;
    dcterms:modified "2026-11-18T00:00:00+00:00"^^xsd:dateTime ;
    skos:changeNote "column tool.weight was dropped (base state of the running example)" .
# ascam:end deprecate http://example.org/weight
