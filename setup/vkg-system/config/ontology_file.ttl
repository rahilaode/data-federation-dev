        "Foreign key wellbore_exploration_all.wlbNpdidWellboreReclass => wellbore_npdid_overview.wlbNpdidWellbore" ;
    sql:datatype "INTEGER (column: wlbNpdidWellboreReclass)" ;
    sql:label "NPDID wellbore reclassified from (column: wlbNpdidWellboreReclass)" ;
    rdfs:range npdv:Wellbore .

