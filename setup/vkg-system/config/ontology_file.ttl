npdv:productionMonth a owl:DatatypeProperty ;
    sql:column "field_production_monthly.prfMonth",
        "field_production_totalt_NCS_month.prfMonth" ;
    sql:comment "Month for figure in the profile (column: prfMonth)" ;
    sql:datatype "INTEGER (column: prfMonth)" ;
    sql:label "Month (column: prfMonth)" ;
