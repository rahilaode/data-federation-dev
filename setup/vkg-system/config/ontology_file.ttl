    rdfs:range npdv:ProductionLicence .

npdv:waterDepth a owl:DatatypeProperty ;
    sql:column "facility_fixed.fclWaterDepth" ;
    sql:comment "Water depth from mean sea level at well site. (column: fclWaterDepth)" ;
    sql:datatype "DECIMAL(13,6) (column: fclWaterDepth)" ;
    sql:label "Water depth [m] (column: fclWaterDepth)" ;
    rdfs:domain npdv:FixedFacility ;
    rdfs:range xsd:decimal .

npdv:wellType a owl:DatatypeProperty ;
    sql:column "wellbore_npdid_overview.wlbWellType" ;
    sql:comment "Wellbore type. Legal values: EXPLORATION, DEVELOPMENT, SHALLOW (extra column: wellbore_npdid_overview.wlbWellType)" ;
    sql:datatype "VARCHAR(20)" ;
    sql:label "Type (extra column: wellbore_npdid_overview.wlbWellType)" ;
    rdfs:domain npdv:Well ;
    rdfs:range xsd:string .

npdv:wellboreDrillingDays a owl:DatatypeProperty ;
    sql:column "wellbore_exploration_all.wlbDrillingDays" ;
    sql:comment "Number of days from wellbore entry to wellbore completion. (column: wlbDrillingDays)" ;
    sql:datatype "INTEGER (column: wlbDrillingDays)" ;
    sql:label "Drilling days (column: wlbDrillingDays)" ;
    rdfs:domain npdv:ExplorationWellbore ;
    rdfs:range xsd:integer .

npdv:wellboreHoleDepth a owl:DatatypeProperty ;
    sql:column "wellbore_casing_and_lot.wlbHoleDepth" ;
    sql:comment "Total depth below kelly bushing of a wellbore section drilled with a certain diameter. (column: wlbHoleDepth)" ;
    sql:datatype "DECIMAL(13,6) (column: wlbHoleDepth)" ;
    sql:label "Hole depth[m] (column: wlbHoleDepth)" ;
    rdfs:domain npdv:WellboreCasingAndLeakoffTest ;
    rdfs:range xsd:decimal .

npdv:wellborePlannedPurpose a owl:DatatypeProperty ;
    sql:column "wellbore_development_all.wlbPurposePlanned",
        "wellbore_exploration_all.wlbPurposePlanned" ;
    sql:comment "Pre-drill purpose of the wellbore. Legal values for exploration wellbores: WILDCAT, APPRAISAL. Example of legal values for development wellbores: OBSERVATION, NOT AVAILABLE, PRODUCTION, INJECTION. (column: wlbPurposePlanned)" ;
    sql:datatype "VARCHAR(40) (column: wlbPurposePlanned)" ;
    sql:label "Purpose - planned (column: wlbPurposePlanned)" ;
    rdfs:range xsd:string .

npdv:wellborePurpose a owl:DatatypeProperty ;
    sql:column "wellbore_exploration_all.wlbPurpose" ;
    sql:comment "Post-drill classification of the wellbore. Legal values for exploration wellbores: WILDCAT, APPRAISAL. Example of legal values for development wellbores: OBSERVATION, NOT AVAILABLE, PRODUCTION, INJECTION.  (column: wlbPurpose)" ;
    sql:datatype "VARCHAR(40) (column: wlbPurpose)" ;
    sql:label "Purpose (column: wlbPurpose)" ;
    rdfs:domain npdv:ExplorationWellbore ;
    rdfs:range xsd:string .

npdv:wellboreStratumBottomDepth a owl:DatatypeProperty ;
    sql:column "strat_litho_wellbore.lsuBottomDepth",
        "wellbore_formation_top.lsuBottomDepth" ;
    sql:comment "Depth in meters to the bottom of the lithostratigraphic unit. (column: lsuBottomDepth)" ;
    sql:datatype "DECIMAL(13,6) (column: lsuBottomDepth)" ;
    sql:label "Bottom depth [m] (column: lsuBottomDepth)" ;
    rdfs:domain npdv:WellboreStratum ;
    rdfs:range xsd:decimal .

npdv:wellboreStratumTopDepth a owl:DatatypeProperty ;
    sql:column "strat_litho_wellbore.lsuTopDepth",
        "wellbore_formation_top.lsuTopDepth" ;
    sql:comment "Measured length along the wellbore from kelly bushing to start of lithostratigraphic unit. Always the group/formation/member which the bit goes into. Note that in some situations, for example highly deviated wells, faults, drilling beyond salt walls, this might not be a true stratigraphic top. The start of a unit will be its stratigraphic base when drilled from underneath. In case of intercalating formations several top depths may occur for the same formation designating the top depths of the sub-packages. For some intervals in some wells only groups are interpreted and no formation tops have been assigned. Members have been assigned only near the type well area. In some cases informal names have been used for formations that are not described in the official nomenclature yet. These are marked with . NPD interpretations. May be subject to changes. (column: lsuTopDepth)" ;
    sql:datatype "DECIMAL(13,6) (column: lsuTopDepth)" ;
    sql:label "Top depth [m] (column: lsuTopDepth)" ;
    rdfs:domain npdv:WellboreStratum ;
    rdfs:range xsd:decimal .

ptl:ProductionLicenceNotification a owl:Class ;
    sql:columns "dateSyncNPD,prlName,prlNpdidLicence,ptlMessage,ptlMessageDateUpdated,ptlMessageDocumentNo,ptlMessageKindDesc,ptlMessageRegisteredDate (table: licence_petreg_message)" ;
    sql:label "Production Licence: Petroleum register, Notifications (table: licence_petreg_message)" ;
    sql:table "licence_petreg_message" ;
    rdfs:isDefinedBy "http://sws.ifi.uio.no/vocab/version/20130919/npd-org" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ptl:messageType ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty ptl:messageNo ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty ptl:dateMessageRegistered ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:messageForLicence ;
            owl:someValuesFrom npdv:ProductionLicence ],
        [ a owl:Restriction ;
            owl:onProperty npdv:dateSyncNPD ;
            owl:someValuesFrom rdfs:Literal ],
        <http://www.ifomis.org/bfo/1.1/snap#Continuant> .

ptl:TUFLicenceeCompany a owl:ObjectProperty ;
    sql:construction "Foreign key tuf_petreg_licence_licencee.cmpNpdidCompany => company.cmpNpdidCompany" ;
    rdfs:domain ptl:TUFLicensee ;
    rdfs:range npdv:Company .

ptl:TUFLicenceeForTUF a owl:ObjectProperty ;
    sql:construction "Foreign key tuf_petreg_licence_licencee.tufNpdidTuf => tuf_petreg_licence.tufNpdidTuf" ;
    rdfs:domain ptl:TUFLicensee ;
    rdfs:range ptl:TUFacility .

ptl:TUFNotification a owl:Class ;
    sql:columns "dateSyncNPD,ptlMessage,ptlMessageDateUpdated,ptlMessageDocumentNo,ptlMessageKindDesc,ptlMessageRegisteredDate,ptlName,tufName,tufNpdidTuf (table: tuf_petreg_message)" ;
    sql:label "Transportation and Utilization Facilities: Petroleum register, Notifications (table: tuf_petreg_message)" ;
    sql:table "tuf_petreg_message" ;
    rdfs:isDefinedBy "http://sws.ifi.uio.no/vocab/version/20130919/npd-org" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ptl:messageForTUF ;
            owl:someValuesFrom ptl:TUFacility ],
        [ a owl:Restriction ;
            owl:onProperty npdv:dateSyncNPD ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty ptl:messageNo ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty ptl:messageType ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty ptl:dateMessageRegistered ;
            owl:someValuesFrom rdfs:Literal ],
        <http://www.ifomis.org/bfo/1.1/snap#Continuant> .

ptl:TUFOperatorForLicence a owl:ObjectProperty ;
    sql:construction "Foreign key tuf_operator_hst.tufNpdidTuf => tuf_petreg_licence.tufNpdidTuf" ;
