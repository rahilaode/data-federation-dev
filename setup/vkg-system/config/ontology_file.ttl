    sql:table "tuf_petreg_licence_licencee" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ptl:licenseeInterest ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty ptl:TUFLicenceeCompany ;
            owl:someValuesFrom npdv:Company ],
        [ a owl:Restriction ;
            owl:onProperty ptl:TUFLicenceeForTUF ;
            owl:someValuesFrom ptl:TUFacility ],
        [ a owl:Restriction ;
            owl:onProperty npdv:dateSyncNPD ;
            owl:someValuesFrom rdfs:Literal ],
        npdv:Licensee .

