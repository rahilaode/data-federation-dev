npdv:ProductionWell a owl:Class ;
    npdv:definition "A development well used for production of petroleum or of water for injection purposes.  Source: http://www.npd.no/en/Topics/Wells/Temaartikler/Well-definitions/" ;
    rdfs:isDefinedBy "http://sws.ifi.uio.no/vocab/version/20130919/npd-well" ;
    rdfs:subClassOf npdv:RecoveryWell .

npdv:ProductionWellbore a owl:Class ;
    rdfs:subClassOf npdv:Wellbore .

npdv:Prospect a owl:Class ;
    npdv:definition "A possible petroleum trap with a mappable, delimited volume of rock.  Source: http://www.npd.no/en/About-us/Information-services/Dictionary/" ;
    rdfs:isDefinedBy "http://sws.ifi.uio.no/vocab/version/20130919/npd-geology" ;
    rdfs:subClassOf <http://www.ifomis.org/bfo/1.1/snap#Site> .

npdv:ReClassToDevWellbore a owl:Class ;
    rdfs:subClassOf npdv:Wellbore .

npdv:ReClassToTestWellbore a owl:Class ;
    rdfs:subClassOf npdv:Wellbore .

npdv:ReEntryWellbore a owl:Class ;
    rdfs:subClassOf npdv:Wellbore .

npdv:Recovery a owl:Class ;
    npdv:definition "The production of petroleum, including the drilling of production wells, injection, assisted recovery, treatment and storage of petroleum for transport, and loading of petroleum for transportation by ship, as well as the construction, location, operation and use of installations used for recovery.   Source: http://www.npd.no/en/About-us/Information-services/Dictionary/" ;
    rdfs:isDefinedBy "http://sws.ifi.uio.no/vocab/version/20130919/npd-prod" ;
    rdfs:subClassOf <http://www.ifomis.org/bfo/1.1/span#ProcessualEntity> .

npdv:Refining a owl:Class ;
    npdv:definition "The refining of crude oil is really a distillation process. The components with different boiling points are separated in a distillation tower. When heated, the oil is converted to gas, which condenses again at different temperatures to, among others, petrol, paraffin, diesel, heating oils, coke and sulphur.  Source: http://www.npd.no/en/About-us/Information-services/Dictionary/" ;
    rdfs:isDefinedBy "http://sws.ifi.uio.no/vocab/version/20130919/npd-prod" ;
    rdfs:subClassOf <http://www.ifomis.org/bfo/1.1/span#ProcessualEntity> .

npdv:RegularSeismicSurvey a owl:Class ;
    rdfs:subClassOf npdv:SeismicSurvey .

npdv:RichGas a owl:Class ;
    npdv:definition "A mixture of wet and dry gas (methane, ethane, propane, butanes, etc.).  Source: http://www.npd.no/en/About-us/Information-services/Dictionary/" ;
    rdfs:isDefinedBy "http://sws.ifi.uio.no/vocab/version/20130919/npd-prod" ;
    rdfs:subClassOf npdv:Gas .

npdv:Rig a owl:Class ;
    npdv:definition "A derrick, essential machinery and additional equipment used when drilling for oil or gas on land or from a drilling platform at sea.  Source: http://www.npd.no/en/About-us/Information-services/Dictionary/" ;
    rdfs:isDefinedBy "http://sws.ifi.uio.no/vocab/version/20130919/npd-facility" ;
    rdfs:subClassOf npdv:Equipment .

npdv:Riser a owl:Class ;
    npdv:definition "A pipe that transports liquid up from the well to the production or drilling platform.  Source: http://www.npd.no/en/About-us/Information-services/Dictionary/" ;
    rdfs:isDefinedBy "http://sws.ifi.uio.no/vocab/version/20130919/npd-facility" ;
    rdfs:subClassOf npdv:Equipment .

npdv:RouteSurvey a owl:Class ;
    rdfs:subClassOf npdv:Survey .

npdv:Royalty a owl:Class ;
    npdv:definition "A fee payable to the Government, calculated on the basis of the volume and the value of produced petroleum, at the shipping point on the production site. The fee is demanded pursuant to § 4-9, paragraph 1 of the Petroleum Act.  Source: http://www.npd.no/en/About-us/Information-services/Dictionary/" ;
    rdfs:isDefinedBy "http://sws.ifi.uio.no/vocab/version/20130919/npd-org" ;
    rdfs:subClassOf <http://www.ifomis.org/bfo/1.1/snap#Continuant> .

npdv:SDFI a owl:DatatypeProperty ;
    sql:column "bsns_arr_area_licensee_hst.baaLicenseeSdfi",
        "bsns_arr_area_transfer_hst.baaTransferSdfi",
        "field_licensee_hst.fldSdfiShare",
        "licence_licensee_hst.prlLicenseeSdfi",
        "licence_transfer_hst.prlTransferSdfi" ;
    sql:comment "State's Direct Financial Interest in percent (column: fldSdfiShare)",
        "The Norwegian State's Direct Financial Interest in percent (only for the history) (column: baaLicenseeSdfi)",
        "The Norwegian State's Direct Financial Interest in percent (only for the history) (column: baaTransferSdfi)",
        "The Norwegian State's Direct Financial Interest in percent (only for the history) (column: prlLicenseeSdfi)",
        "The Norwegian State's Direct Financial Interest in percent (only for the history) (column: prlTransferSdfi)" ;
    sql:datatype "DECIMAL(13,6) (column: baaLicenseeSdfi)",
        "DECIMAL(13,6) (column: baaTransferSdfi)",
        "DECIMAL(13,6) (column: fldSdfiShare)",
        "DECIMAL(13,6) (column: prlLicenseeSdfi)",
        "DECIMAL(13,6) (column: prlTransferSdfi)" ;
    sql:label "SDFI [%] (column: baaLicenseeSdfi)",
        "SDFI [%] (column: baaTransferSdfi)",
        "SDFI [%] (column: fldSdfiShare)",
        "SDFI [%] (column: prlLicenseeSdfi)",
        "SDFI [%] (column: prlTransferSdfi)" ;
    rdfs:range xsd:decimal .

npdv:SDFITransfer a owl:Class ;
    rdfs:subClassOf npdv:Transfer .

npdv:SeabedSeismicSurvey a owl:Class ;
    rdfs:subClassOf npdv:SeismicSurvey .

npdv:SeismicAreaBAA a owl:Class ;
    rdfs:subClassOf npdv:BAA .

npdv:SemisubConcreteFacility a owl:Class ;
    rdfs:subClassOf npdv:Facility .

npdv:SemisubSteelFacility a owl:Class ;
    rdfs:subClassOf npdv:Facility .

npdv:ShallowWell a owl:Class ;
    npdv:definition "Shallow boreholes are defined in Section 2 of the Resource Management Regulations: Holes drilled in order to acquire information on the properties of the rock and/or to conduct geotechnical surveys to determine the location of facilities, and which are not drilled to prove or delimit a petroleum deposit or to produce or inject petroleum, water or other medium.  In reality, the definition includes two types of boreholes that are regulated by different provisions:      1. For route surveys and other soil surveys, boreholes can be drilled to study the subsurface before a facility is placed. These boreholes cannot be drilled deeper than 200 metres below the seabed, cf. Section 30 of the Petroleum Regulations.     2. When exploring for petroleum, “shallow drillings” can be carried out, cf. Section 4 of the Petroleum Regulations. These are boreholes that are drilled to acquire data on geological development of the rocks to explore for petroleum. In addition to the information on the geology at the drill site, the information can be linked with seismic data to calibrate seismic reflectors against geological units and to depth-convert seismic data. These boreholes previously had a depth restriction of 200 metres, but the Norwegian Petroleum Directorate (NPD) can now stipulate the depth. For drilling deeper than 200 metres below the seabed, an application for consent must be submitted to the Petroleum Safety Authority Norway, in addition to registration of the borehole with the NPD, cf. Section 25 of the Management Regulations.  Source: http://www.npd.no/en/Topics/Wells/Temaartikler/Established-practice-for-well-designation/" ;
    rdfs:isDefinedBy "http://sws.ifi.uio.no/vocab/version/20130919/npd-well" ;
    rdfs:subClassOf npdv:Well .

npdv:SidetrackWellbore a owl:Class ;
    npdv:definition "A wellbore with a sidetrack" ;
    rdfs:isDefinedBy "http://sws.ifi.uio.no/vocab/version/20130919/npd-well" ;
    rdfs:subClassOf npdv:Wellbore .

npdv:SingleWellTemplateFacility a owl:Class ;
    rdfs:subClassOf npdv:Facility .

npdv:SiteSurvey a owl:Class ;
    rdfs:subClassOf npdv:Survey .

npdv:SlidingScaleBAA a owl:Class ;
    rdfs:subClassOf npdv:BAA .

npdv:SubseaCompletedWell a owl:Class ;
    npdv:definition "Development well completed with the wellhead either on the seabed or on a template, and connected to a production or injection facility.  Source: http://www.npd.no/en/Topics/Wells/Temaartikler/Well-definitions/" ;
    rdfs:isDefinedBy "http://sws.ifi.uio.no/vocab/version/20130919/npd-well" ;
    rdfs:subClassOf npdv:DevelopmentWell .

npdv:SubseaStructureFacility a owl:Class ;
    rdfs:subClassOf npdv:Facility .

npdv:SurveyMultilineArea a owl:Class ;
    sql:columns "seaBoatTotalKm,seaCdpTotalKm,seaCompanyReported,seaDateFinalized,seaDateStarting,seaFactMapUrl,seaFactPageUrl,seaMarketAvailable,seaMultilineGeometryWKT,seaPlanBoatKm,seaPlanCdpKm,seaPlanFromDate,seaPlanToDate,seaSensorLength,seaSensorNumbers,seaSensorType,seaSourceNumber,seaSourcePressure,seaSourceSize,seaSourceType,seaStatus,seaSurveyName,seaSurveyTypeMain,seaSurveyTypePart (table: seaMultiline)" ;
