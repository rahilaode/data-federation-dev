    sql:comment "The date the area is valid from (column: prlAreaPolyDateValidFrom)" ;
    sql:datatype "DATETIME (column: prlAreaPolyDateValidFrom)" ;
    sql:label "Date valid from (column: prlAreaPolyDateValidFrom)" ;
    rdfs:range xsd:date .

npdv:dateLicenceValidTo a owl:DatatypeProperty ;
    sql:column "licence.prlDateValidTo",
        "licence_phase_hst.prlDateValidTo" ;
    sql:comment "Date the production licence is valid to. (column: prlDateValidTo)" ;
    sql:datatype "DATETIME (column: prlDateValidTo)" ;
    sql:label "Date valid to (column: prlDateValidTo)" ;
    rdfs:range xsd:date .

npdv:dateTransferValidFrom a owl:DatatypeProperty ;
    sql:column "bsns_arr_area_transfer_hst.baaTransferDateValidFrom",
        "licence_transfer_hst.prlTransferDateValidFrom" ;
    sql:comment "Date the transfer is valid from (column: prlTransferDateValidFrom)",
        "The date the transfer is valid from (column: baaTransferDateValidFrom)" ;
    sql:datatype "DATETIME (column: baaTransferDateValidFrom)",
        "DATETIME (column: prlTransferDateValidFrom)" ;
    sql:label "Date valid from (column: baaTransferDateValidFrom)",
        "Date valid from (column: prlTransferDateValidFrom)" ;
    rdfs:range xsd:date .

npdv:discoveryWellbore a owl:ObjectProperty ;
    sql:construction "Foreign key discovery.wlbNpdidWellbore => wellbore_npdid_overview.wlbNpdidWellbore",
        "Foreign key field.wlbNpdidWellbore => wellbore_npdid_overview.wlbNpdidWellbore" ;
    rdfs:range npdv:DiscoveryWellbore,
        npdv:Wellbore .

npdv:drillingOperatorCompany a owl:ObjectProperty ;
    sql:construction "Foreign key wellbore_development_all.wlbDrillingOperator => company.cmpLongName",
        "Foreign key wellbore_exploration_all.wlbDrillingOperator => company.cmpLongName" ;
    rdfs:range npdv:Company .

npdv:facilityType a owl:DatatypeProperty ;
    sql:column "facility_fixed.fclKind",
        "facility_moveable.fclKind" ;
    sql:comment "Kind of facility. Example of legal values: CONCRETE STRUCTURE, CONDEEP 3 SHAFTS, CONDEEP 4 SHAFTS, CONDEEP MONOSHAFT, DORIS, FPSO, FSU, JACKET 12 LEGS, JACKET 4 LEGS, JACKET 6 LEGS, JACKET 8 LEGS, JACKET TRIPOD, JACK-UP 3 LEGS, JACK-UP 4 LEGS, LOADING SYSTEM, MONOTOWER, MULTI WELL TEMPLATE, ONSHORE FACILITY, SEMISUB CONCRETE, SEMISUB STEEL, SINGLE WELL TEMPLATE, SUBSEA STRUCTURE, TLP CONCRETE, TLP STEEL, VESSEL (column: fclKind)" ;
    sql:datatype "VARCHAR(40) (column: fclKind)" ;
    sql:label "Kind (column: fclKind)" ;
    rdfs:range xsd:string .

npdv:inLithostratigraphicUnit a owl:ObjectProperty ;
    sql:column "strat_litho_wellbore.lsuNpdidLithoStrat",
        "strat_litho_wellbore_core.lsuNpdidLithoStrat",
        "wellbore_formation_top.lsuNpdidLithoStrat" ;
    sql:comment "NPD's unique id for lithostratigraphic units. (column: lsuNpdidLithoStrat)" ;
    sql:datatype "INTEGER (column: lsuNpdidLithoStrat)" ;
    sql:label "NPDID lithostrat. unit (column: lsuNpdidLithoStrat)" .

npdv:isActive a owl:DatatypeProperty ;
    sql:column "baaArea.baaAreaPolyActive",
        "licence.prlStatus" ;
    sql:comment "Current status of production licence. Example of legal values: ACTIVE, INACTIVE (column: prlStatus)" ;
    sql:datatype "VARCHAR(40) (column: baaAreaPolyActive)",
        "VARCHAR(40) (column: prlStatus)" ;
    sql:label "Status (column: prlStatus)" .

npdv:isDiscoveryWellbore a owl:DatatypeProperty ;
    sql:column "wellbore_development_all.wlbDiscoveryWellbore",
        "wellbore_exploration_all.wlbDiscoveryWellbore" ;
    sql:comment "Indicator which telles if the wellbore made a new discovery. Legal values: YES, NO. (column: wlbDiscoveryWellbore)" ;
    sql:datatype "VARCHAR(3) (column: wlbDiscoveryWellbore)" ;
    sql:label "Discovery wellbore (column: wlbDiscoveryWellbore)" .

npdv:isMarketAvailable a owl:DatatypeProperty ;
    sql:column "seaArea.seaMarketAvailable",
        "seaMultiline.seaMarketAvailable" ;
    sql:comment "Indicator which tells if the seismic data is available on the market or not. Legal values, 'Yes' , 'No'. (column: seaMarketAvailable)" ;
    sql:datatype "VARCHAR(20) (column: seaMarketAvailable)" ;
    sql:label "Marked available (column: seaMarketAvailable)" .

npdv:isMultilateral a owl:DatatypeProperty ;
    sql:column "wellbore_development_all.wlbMultilateral",
        "wellbore_exploration_all.wlbMultilateral" ;
    sql:comment "Indicator telling if the parent well is multilateral, meaning it has more than one branch radiating from the main borehole. Example of legal values: YES, NO. See also NPD guidelines for designation of wells and wellbores. (column: wlbMultilateral)" ;
    sql:datatype "VARCHAR(3) (column: wlbMultilateral)" ;
    sql:label "Multilateral (column: wlbMultilateral)" .

npdv:isStratigraphical a owl:DatatypeProperty ;
    sql:column "apaAreaNet.apaAreaType",
        "licence_area_poly_hst.prlAreaPolyStratigraphical",
        "prlArea.prlAreaPolyStratigraphical",
        "prlAreaSplitByBlock.prlAreaPolyStratigraphical" ;
    sql:comment "Indicator which tells if the production licence is stratigraphical or not. A stratigraphical production licence is vertically limited by stratigraphic units (upper an lower). This means that many production licences may cover the same area on a 2D map. Legal values: YES, NO (column: prlAreaPolyStratigraphical)" ;
    sql:datatype "VARCHAR(4) (column: prlAreaPolyStratigraphical)",
        "VARCHAR(40) (column: apaAreaType)" ;
    sql:label "Stratigraphcal (column: prlAreaPolyStratigraphical)" .

