npdv:stratigraphicLevel a owl:DatatypeProperty ;
    sql:column "wellbore_formation_top.lsuLevel" ;
    sql:comment "Indicates the level of the lithostratigraphic unit. Legal values: GROUP, FORMATION, MEMBER. (extra column: wellbore_formation_top.lsuLevel)" ;
    sql:datatype "VARCHAR(9)" ;
    sql:label "Level (extra column: wellbore_formation_top.lsuLevel)" ;
    rdfs:domain npdv:LithostratigraphicUnit .

npdv:stratigraphicParent a owl:ObjectProperty ;
    sql:column "wellbore_formation_top.lsuNpdidLithoStratParent" ;
    sql:comment "NPD's unique id for the lithostratigraphic unit, referring to the parent unit. Will be empty if Level = GROUP. (extra column: wellbore_formation_top.lsuNpdidLithoStratParent)" ;
    sql:datatype "INTEGER" ;
    sql:label "NPDID parent lithostrat. unit (extra column: wellbore_formation_top.lsuNpdidLithoStratParent)" ;
    rdfs:domain npdv:LithostratigraphicUnit ;
    rdfs:range npdv:LithostratigraphicUnit .

