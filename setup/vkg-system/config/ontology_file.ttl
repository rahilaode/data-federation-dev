npdv:AwardArea a owl:Class ;
    sql:columns "apaAreaNetGeometryWKT,apaAreaType,blkId,blkLabel,blkName,prvName,qdrName,urlNPD (table: apaAreaNet)" ;
    sql:label "APA (Awards in predefined areas) net areas. (table: apaAreaNet)" ;
    sql:table "apaAreaNet" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty npdv:provinceLocation ;
            owl:someValuesFrom owl:Thing ],
        [ a owl:Restriction ;
            owl:onProperty npdv:blockId ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty geo:asWKT ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:blockLocation ;
            owl:someValuesFrom owl:Thing ],
        [ a owl:Restriction ;
            owl:onProperty npdv:quadrantLocation ;
            owl:someValuesFrom owl:Thing ],
        [ a owl:Restriction ;
            owl:onProperty npdv:npdPageURL ;
            owl:someValuesFrom owl:Thing ],
        npdv:Area .

npdv:FieldStatus a owl:Class ;
    sql:columns "dateSyncNPD,fldName,fldNpdidField,fldStatus,fldStatusDateUpdated,fldStatusFromDate,fldStatusToDate (table: field_activity_status_hst)" ;
    sql:label "Field: Status (table: field_activity_status_hst)" ;
    sql:table "field_activity_status_hst" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty npdv:dateStatusFrom ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:status ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:statusForField ;
            owl:someValuesFrom npdv:Field ],
        [ a owl:Restriction ;
            owl:onProperty npdv:dateSyncNPD ;
            owl:someValuesFrom rdfs:Literal ],
        <http://www.ifomis.org/bfo/1.1/snap#Quality> .

npdv:Operator a owl:Class ;
    npdv:definition "The agent who, on behalf of the licensee, is in charge of the day-to-day management of the petroleum activity.  Source: http://www.npd.no/en/About-us/Information-services/Dictionary/" ;
    rdfs:isDefinedBy "http://sws.ifi.uio.no/vocab/version/20130919/npd-org" ;
    rdfs:subClassOf npdv:Agent .

npdv:Petroleum a owl:Class ;
    npdv:definition "Collective term for hydrocarbons. The term covers all liquid and gaseous hydrocarbons found in a natural state in the substrate, and also other substances recovered in connection with such hydrocarbons.   Source: http://www.npd.no/en/About-us/Information-services/Dictionary/" ;
    rdfs:isDefinedBy "http://sws.ifi.uio.no/vocab/version/20130919/npd-prod" ;
    rdfs:subClassOf <http://www.ifomis.org/bfo/1.1/snap#ObjectAggregate> .

npdv:Plan a owl:Class ;
    rdfs:isDefinedBy "http://sws.ifi.uio.no/vocab/version/20130919/npd-org" ;
    rdfs:subClassOf <http://www.ifomis.org/bfo/1.1/span#ProcessualEntity> .

npdv:Reserve a owl:Class ;
    npdv:definition "Remaining, recoverable, saleable volumes of petroleum which the licensees have decided to recover and the authorities have given permission to recover.  Source: http://www.npd.no/en/About-us/Information-services/Dictionary/" ;
    rdfs:isDefinedBy "http://sws.ifi.uio.no/vocab/version/20130919/npd-prod" ;
    rdfs:subClassOf <http://www.ifomis.org/bfo/1.1/snap#ObjectAggregate> .

npdv:SeismicSurveyProgress a owl:Class ;
    sql:columns "seaNpdidSurvey,seaProgressDate,seaProgressDescription,seaProgressText,seaProgressText2 (table: seis_acquisition_progress)" ;
    sql:label "Seismic Surveys: Last updates (table: seis_acquisition_progress)" ;
    sql:table "seis_acquisition_progress" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty npdv:statusForSurvey ;
            owl:someValuesFrom npdv:SeismicSurvey ],
        [ a owl:Restriction ;
            owl:onProperty npdv:dateSurveyProgress ;
            owl:someValuesFrom rdfs:Literal ],
        <http://www.ifomis.org/bfo/1.1/span#Occurrent> .

npdv:ShallowWellbore a owl:Class ;
    npdv:definition "Hole drilled in order to acquire information on the rock characteristics and/or carry out geotechnical examinations for the location of installationsand which are not drilled to discover or delimit a petroleum deposit or to produce or inject petroleum, water or other medium.  Source: http://www.npd.no/en/About-us/Information-services/Dictionary/ " ;
    sql:columns "dateSyncNPD,wlbCompletionDate,wlbCompletionYear,wlbDateUpdated,wlbDateUpdatedMax,wlbDrillPermit,wlbDrillingFacility,wlbDrillingOperator,wlbEntryDate,wlbEntryYear,wlbEwCode,wlbEwDeg,wlbEwDesDeg,wlbEwMin,wlbEwSec,wlbEwUtm,wlbGeodeticDatum,wlbMainArea,wlbNamePart1,wlbNamePart2,wlbNamePart3,wlbNamePart4,wlbNamePart5,wlbNamePart6,wlbNpdidWellbore,wlbNsCode,wlbNsDecDeg,wlbNsDeg,wlbNsMin,wlbNsSec,wlbNsUtm,wlbProductionLicence,wlbSeismicLocation,wlbTotalDepth,wlbUtmZone,wlbWaterDepth,wlbWell,wlbWellboreName (table: wellbore_shallow_all)" ;
    sql:label "Wellbore: Shallow (table: wellbore_shallow_all)" ;
    sql:table "wellbore_shallow_all" ;
    rdfs:isDefinedBy "http://sws.ifi.uio.no/vocab/version/20130919/npd-well" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty npdv:degreesEW ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:dateSyncNPD ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:minutesNS ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:wellboreCompletionYear ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:shallowWellboreForLicence ;
            owl:someValuesFrom npdv:ProductionLicence ],
        [ a owl:Restriction ;
            owl:onProperty npdv:dateUpdated ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:wellboreTotalDepth ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:wellboreNamePart4 ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:utmNS ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:minutesEW ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:wellboreNamePart2 ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:idNPD ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:dateUpdatedMax ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:name ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:degreesNS ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:utmEW ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:wellboreNamePart3 ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:wellboreWaterDepth ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:mainAreaLocation ;
            owl:someValuesFrom owl:Thing ],
        [ a owl:Restriction ;
            owl:onProperty npdv:secondsNS ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:decimalDegreesEW ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:drillPermit ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:decimalDegreesNS ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:utmZone ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:wellboreEntryYear ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:wellboreNamePart1 ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:secondsEW ;
            owl:someValuesFrom rdfs:Literal ],
        npdv:Wellbore .

npdv:TUFOperator a owl:Class ;
    sql:columns "cmpLongName,cmpNpdidCompany,dateSyncNPD,tufName,tufNpdidTuf,tufOperDateValidFrom,tufOperDateValidTo (table: tuf_operator_hst)" ;
    sql:label "Transportation and Utilization Facilities: Operators (table: tuf_operator_hst)" ;
    sql:table "tuf_operator_hst" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty npdv:dateSyncNPD ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty ptl:TUFOperatorCompany ;
            owl:someValuesFrom npdv:Company ],
        [ a owl:Restriction ;
            owl:onProperty npdv:dateTUFOperatorValidFrom ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty ptl:TUFOperatorForLicence ;
            owl:someValuesFrom ptl:TUFacility ],
        npdv:Operator .

npdv:WellboreCore a owl:Class ;
    sql:columns "dateSyncNPD,wlbCoreDateUpdated,wlbCoreIntervalBottom,wlbCoreIntervalTop,wlbCoreIntervalUom,wlbCoreNumber,wlbCoreSampleAvailable,wlbName,wlbNpdidWellbore,wlbNumberOfCores,wlbTotalCoreLength (table: wellbore_core)" ;
    sql:label "Wellbore: Cores (table: wellbore_core)" ;
    sql:table "wellbore_core" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty npdv:isCoreSampleAvailable ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:coreNo ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:dateSyncNPD ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:coreForWellbore ;
            owl:someValuesFrom npdv:Wellbore ],
        <http://www.ifomis.org/bfo/1.1/snap#Object> .

npdv:WellboreCorePhoto a owl:Class ;
    sql:columns "wlbCoreNumber,wlbCorePhotoDateUpdated,wlbCorePhotoImgUrl,wlbCorePhotoTitle,wlbName,wlbNpdidWellbore (table: wellbore_core_photo)" ;
    sql:label "Wellbore: Core photos (table: wellbore_core_photo)" ;
    sql:table "wellbore_core_photo" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty npdv:corePhotoTitle ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:corePhotoURL ;
            owl:someValuesFrom owl:Thing ],
        [ a owl:Restriction ;
            owl:onProperty npdv:coreNo ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:corePhotoForWellbore ;
            owl:someValuesFrom npdv:Wellbore ],
        <http://www.ifomis.org/bfo/1.1/snap#Object> .

npdv:WellboreCoreSet a owl:Class ;
    sql:label "Wellbore Cores (extra table: wellbore_core)" ;
    sql:table "wellbore_core (ex)" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty npdv:coresForWellbore ;
            owl:someValuesFrom owl:Thing ],
        [ a owl:Restriction ;
            owl:onProperty npdv:coresTotalNo ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:coresTotalLength ;
            owl:someValuesFrom rdfs:Literal ],
        <http://www.ifomis.org/bfo/1.1/snap#ObjectAggregate> .

npdv:WellboreStratum a owl:Class ;
    sql:columns "dateSyncNPD,lsuBottomDepth,lsuLevel,lsuName,lsuNameParent,lsuNpdidLithoStrat,lsuNpdidLithoStratParent,lsuTopDepth,lsuWellboreUpdatedDate,wlbName,wlbNpdidWellbore (table: wellbore_formation_top)",
        "dateSyncNPD,lsuBottomDepth,lsuLevel,lsuName,lsuNpdidLithoStrat,lsuTopDepth,lsuWellboreUpdatedDate,wlbCompletionDate,wlbName,wlbNpdidWellbore (table: strat_litho_wellbore)" ;
    sql:comment "Lithostratigraphic units (groups, formations and members) on the Norwegian continental shelf. Exploration wellbores penetrating a particular unit. (table: strat_litho_wellbore)" ;
    sql:label "Stratigraphy: Wellbores (table: strat_litho_wellbore)",
        "Wellbore: Lithostratigraphy (table: wellbore_formation_top)" ;
    sql:table "strat_litho_wellbore",
        "wellbore_formation_top" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty npdv:wellboreStratumTopDepth ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:dateSyncNPD ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:stratumForWellbore ;
            owl:someValuesFrom npdv:Wellbore ],
        [ a owl:Restriction ;
            owl:onProperty npdv:wellboreStratumBottomDepth ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:inLithostratigraphicUnit ;
            owl:someValuesFrom owl:Thing ],
        <http://www.ifomis.org/bfo/1.1/snap#Continuant> .

npdv:belongsToWell a owl:ObjectProperty ;
    sql:column "wellbore_development_all.wlbWell",
        "wellbore_exploration_all.wlbWell",
        "wellbore_npdid_overview.wlbWell" ;
    sql:comment "Official name of the parent well for the wellbore based on NPD guidelines for designation of wells and wellbores. (column: wlbWell)" ;
    sql:datatype "VARCHAR(40) (column: wlbWell)" ;
    sql:label "Well name (column: wlbWell)" .

npdv:codeNS a owl:DatatypeProperty ;
    sql:column "facility_fixed.fclNsCode",
        "wellbore_coordinates.wlbNsCode",
        "wellbore_development_all.wlbNsCode",
        "wellbore_exploration_all.wlbNsCode",
        "wellbore_shallow_all.wlbNsCode" ;
    sql:comment "Indicator whcih tells if the coordinate of the wellhead is on the nothern or southern hemisphere. Legal values: N, S. (column: wlbNsCode)",
        "Indicator which tells if the coordinate is in the nothern or southern hemisphere. Example of legal values: N, S (column: fclNsCode)" ;
    sql:datatype "VARCHAR(1) (column: fclNsCode)",
        "VARCHAR(1) (column: wlbNsCode)" ;
    sql:label "NS code (column: fclNsCode)",
        "NS code (column: wlbNsCode)" ;
    rdfs:range xsd:string .

npdv:dateResourceEstimate a owl:DatatypeProperty ;
    sql:column "company_reserves.cmpDateOffResEstDisplay",
        "discovery_reserves.dscDateOffResEstDisplay",
        "field_reserves.fldDateOffResEstDisplay" ;
    sql:comment "Date for official estimate of the reserves (column: fldDateOffResEstDisplay)",
        "Date for official estimate of the resources (column: dscDateOffResEstDisplay)" ;
    sql:datatype "DATETIME (column: cmpDateOffResEstDisplay)",
        "DATETIME (column: dscDateOffResEstDisplay)",
        "DATETIME (column: fldDateOffResEstDisplay)" ;
    sql:label "Reserves updated date (column: fldDateOffResEstDisplay)",
        "Resource updated date (column: dscDateOffResEstDisplay)" ;
    rdfs:range xsd:date .

npdv:dateUpdatedMax a owl:DatatypeProperty ;
    sql:column "bsns_arr_area.baaDateUpdatedMax",
        "discovery.dscDateUpdatedMax",
        "field.fldDateUpdatedMax",
        "licence.prlDateUpdatedMax",
        "wellbore_development_all.wlbDateUpdatedMax",
        "wellbore_exploration_all.wlbDateUpdatedMax",
        "wellbore_shallow_all.wlbDateUpdatedMax" ;
    sql:comment "Date when any information about this business area was last updated or inserted for the first time. The date also will bli change if some of the data in the 'Sub levels' in the tab 'BAA' will be changed. (column: baaDateUpdatedMax)",
        "Date when any information about this discovery was last updated or inserted for the first time. The date also will bli change if any change has happed in: 'Located in', 'Owners', 'Operatorship'. (column: dscDateUpdatedMax)",
        "Date when any information about this field was last updated or inserted for the first time. The date also will bli change if any change has happed in : 'Activity status', ' Discoveries included', 'Owners', 'Operators', 'Licensees' (column: fldDateUpdatedMax)",
        "Date when any information about this production licences was last updated or inserted for the first time. The date also will bli change if some of the data in the 'Sub levels' in the tab 'Licence' will be changed. (column: prlDateUpdatedMax)",
        "Date when any information about this wellbore was last updated or inserted for the first time. The date also will bli change if some of the data in the 'Sub levels' in the tab 'Wellbore' will be changed. (column: wlbDateUpdatedMax)" ;
    sql:datatype "DATETIME (column: baaDateUpdatedMax)",
        "DATETIME (column: dscDateUpdatedMax)",
        "DATETIME (column: fldDateUpdatedMax)",
        "DATETIME (column: prlDateUpdatedMax)",
        "DATETIME (column: wlbDateUpdatedMax)" ;
    sql:label "Date all updated (column: baaDateUpdatedMax)",
        "Date all updated (column: dscDateUpdatedMax)",
        "Date all updated (column: fldDateUpdatedMax)",
        "Date all updated (column: prlDateUpdatedMax)",
        "Date all updated (column: wlbDateUpdatedMax)" ;
    rdfs:range xsd:date .

npdv:drillPermit a owl:DatatypeProperty ;
    sql:column "wellbore_development_all.wlbDrillPermit",
        "wellbore_exploration_all.wlbDrillPermit",
        "wellbore_shallow_all.wlbDrillPermit" ;
    sql:comment "The drilling permit number together with the version of the drilling permit as stated in the drilling permit granted by the NPD. (column: wlbDrillPermit)" ;
    sql:datatype "VARCHAR(10) (column: wlbDrillPermit)" ;
    sql:label "Drill permit (column: wlbDrillPermit)" ;
    rdfs:range xsd:string .

npdv:recoverableCondensate a owl:DatatypeProperty ;
    sql:column "company_reserves.cmpRecoverableCondensate",
        "discovery_reserves.dscRecoverableCondensate",
        "field_reserves.fldRecoverableCondensate" ;
    sql:comment "Original recoverable condensate [mill Sm3] (column: fldRecoverableCondensate)",
        "Recoverable condensate [mill Sm3] (column: dscRecoverableCondensate)" ;
    sql:datatype "DECIMAL(13,6) (column: cmpRecoverableCondensate)",
        "DECIMAL(13,6) (column: dscRecoverableCondensate)",
        "DECIMAL(13,6) (column: fldRecoverableCondensate)" ;
    sql:label "Orig. recoverable cond. [mill Sm3] (column: fldRecoverableCondensate)",
        "Rec. cond. [mill Sm3] (column: dscRecoverableCondensate)" ;
    rdfs:range xsd:decimal .

npdv:recoverableGas a owl:DatatypeProperty ;
    sql:column "company_reserves.cmpRecoverableGas",
        "discovery_reserves.dscRecoverableGas",
        "field_reserves.fldRecoverableGas" ;
    sql:comment "Original recoverable gas [bill Sm3] (column: fldRecoverableGas)",
        "Recoverable gas [bill Sm3] (column: dscRecoverableGas)" ;
    sql:datatype "DECIMAL(13,6) (column: cmpRecoverableGas)",
        "DECIMAL(13,6) (column: dscRecoverableGas)",
        "DECIMAL(13,6) (column: fldRecoverableGas)" ;
    sql:label "Orig. recoverable gas [bill Sm3] (column: fldRecoverableGas)",
        "Rec. gas [bill Sm3] (column: dscRecoverableGas)" ;
    rdfs:range xsd:decimal .

npdv:recoverableNGL a owl:DatatypeProperty ;
    sql:column "company_reserves.cmpRecoverableNGL",
        "discovery_reserves.dscRecoverableNGL",
        "field_reserves.fldRecoverableNGL" ;
    sql:comment "Original recoverable NGL [mill tonnes] (column: fldRecoverableNGL)",
        "Recoverable NGL [mill tonnes] (column: dscRecoverableNGL)" ;
    sql:datatype "DECIMAL(13,6) (column: cmpRecoverableNGL)",
        "DECIMAL(13,6) (column: dscRecoverableNGL)",
        "DECIMAL(13,6) (column: fldRecoverableNGL)" ;
    sql:label "Orig. recoverable NGL [mill tonn] (column: fldRecoverableNGL)",
        "Rec. NGL [mill tonn] (column: dscRecoverableNGL)" ;
    rdfs:range xsd:decimal .

npdv:recoverableOil a owl:DatatypeProperty ;
    sql:column "company_reserves.cmpRecoverableOil",
        "discovery_reserves.dscRecoverableOil",
        "field_reserves.fldRecoverableOil" ;
    sql:comment "Original recoverable oil [mill Sm3] (column: fldRecoverableOil)",
        "Recoverable oil [mill Sm3] (column: dscRecoverableOil)" ;
    sql:datatype "DECIMAL(13,6) (column: cmpRecoverableOil)",
        "DECIMAL(13,6) (column: dscRecoverableOil)",
        "DECIMAL(13,6) (column: fldRecoverableOil)" ;
    sql:label "Orig. recoverable oil [mill Sm3] (column: fldRecoverableOil)",
        "Rec. oil [mill Sm3] (column: dscRecoverableOil)" ;
    rdfs:range xsd:decimal .

npdv:wellboreAgeHc a owl:ObjectProperty ;
    rdfs:domain npdv:Wellbore ;
    rdfs:range gts-30:GeochronologicEra .

npdv:wellboreCompletionYear a owl:DatatypeProperty ;
    sql:column "wellbore_development_all.wlbCompletionYear",
        "wellbore_exploration_all.wlbCompletionYear",
        "wellbore_shallow_all.wlbCompletionYear" ;
    sql:comment "The year when the anchor handling started. In case of jack-ups: the year the jacking-down started. (column: wlbCompletionYear)" ;
    sql:datatype "INTEGER (column: wlbCompletionYear)" ;
    sql:label "Completion year (column: wlbCompletionYear)" ;
    rdfs:range xsd:integer .

npdv:wellboreEntryYear a owl:DatatypeProperty ;
    sql:column "wellbore_development_all.wlbEntryYear",
        "wellbore_exploration_all.wlbEntryYear",
        "wellbore_shallow_all.wlbEntryYear" ;
    sql:comment "The year when the drill bit penetrated the earth's crust / sea floor. (column: wlbEntryYear)" ;
    sql:datatype "INTEGER (column: wlbEntryYear)" ;
    sql:label "Entry year (column: wlbEntryYear)" ;
    rdfs:range xsd:integer .

npdv:wellboreForField a owl:ObjectProperty ;
    rdfs:domain npdv:Wellbore ;
    rdfs:range npdv:Field .

npdv:wellboreFormationHc a owl:ObjectProperty .

npdv:wellboreNamePart1 a owl:DatatypeProperty ;
    sql:column "wellbore_development_all.wlbNamePart1",
        "wellbore_exploration_all.wlbNamePart1",
        "wellbore_shallow_all.wlbNamePart1" ;
    sql:comment "Part 1 of the wellbore name. Tells quadrant number on the Norwegian Continental Shelf the wellbore was drilled in. Based on NPD guidelines for designation of wells and wellbores. (column: wlbNamePart1)" ;
    sql:datatype "INTEGER (column: wlbNamePart1)" ;
    sql:label "Wellbore name, part 1 (column: wlbNamePart1)" ;
    rdfs:range xsd:integer .

npdv:wellboreNamePart2 a owl:DatatypeProperty ;
    sql:column "wellbore_development_all.wlbNamePart2",
        "wellbore_exploration_all.wlbNamePart2",
        "wellbore_shallow_all.wlbNamePart2" ;
    sql:comment "Part 2 of the wellbore name. Tells the block number the wellbore was drilled in. Based on NPD guidelines for designation of wells and wellbores. (column: wlbNamePart2)" ;
    sql:datatype "INTEGER (column: wlbNamePart2)" ;
    sql:label "Wellbore name, part 2 (column: wlbNamePart2)" ;
    rdfs:range xsd:integer .

npdv:wellboreNamePart4 a owl:DatatypeProperty ;
    sql:column "wellbore_development_all.wlbNamePart4",
        "wellbore_exploration_all.wlbNamePart4",
        "wellbore_shallow_all.wlbNamePart4" ;
    sql:comment "Part 4 of the wellbore name. Serial number for the wellbore. Based on NPD guidelines for designation of wells and wellbores. (column: wlbNamePart4)" ;
    sql:datatype "INTEGER (column: wlbNamePart4)" ;
    sql:label "Wellbore name, part 4 (column: wlbNamePart4)" ;
    rdfs:range xsd:integer .

npdv:wellboreTotalDepth a owl:DatatypeProperty ;
    sql:column "wellbore_development_all.wlbTotalDepth",
        "wellbore_exploration_all.wlbTotalDepth",
        "wellbore_shallow_all.wlbTotalDepth" ;
    sql:comment "Total measured length of wellbore from kelly bushing to total depth (driller's depth). (column: wlbTotalDepth)" ;
    sql:datatype "DECIMAL(13,6) (column: wlbTotalDepth)" ;
    sql:label "Total depth (MD) [m RKB] (column: wlbTotalDepth)" ;
    rdfs:range xsd:decimal .

npdv:wellboreWaterDepth a owl:DatatypeProperty ;
    sql:column "wellbore_development_all.wlbWaterDepth",
        "wellbore_exploration_all.wlbWaterDepth",
        "wellbore_shallow_all.wlbWaterDepth" ;
    sql:comment "Depth in metres betweem mean sea level and sea floor. (column: wlbWaterDepth)" ;
    sql:datatype "DECIMAL(13,6) (column: wlbWaterDepth)" ;
    sql:label "Water depth [m] (column: wlbWaterDepth)" ;
    rdfs:range xsd:decimal .

ptl:ProductionLicence a owl:Class ;
    sql:columns "cmpLongName,cmpNpdidCompany,dateSyncNPD,prlNpdidLicence,ptlName,ptlOperDateUpdated (table: licence_petreg_licence_oper)",
        "dateSyncNPD,prlNpdidLicence,ptlDateAwarded,ptlDateUpdated,ptlDateUpdatedMax,ptlDateValidFrom,ptlDateValidTo,ptlName (table: licence_petreg_licence)" ;
    sql:label "Production Licence: Petroleum register (table: licence_petreg_licence)",
        "Production Licence: Petroleum register, Operators (table: licence_petreg_licence_oper)" ;
    sql:table "licence_petreg_licence",
        "licence_petreg_licence_oper" ;
    rdfs:isDefinedBy "http://sws.ifi.uio.no/vocab/version/20130919/npd-org" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty npdv:dateSyncNPD ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty ptl:dateLicenceValidFrom ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty ptl:name ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty ptl:dateLicenceValidTo ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty ptl:licenceOperatorCompany ;
            owl:someValuesFrom npdv:Company ],
        [ a owl:Restriction ;
            owl:onProperty ptl:dateAwarded ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty ptl:dateUpdatedMax ;
            owl:someValuesFrom rdfs:Literal ],
        npdv:Agent .

<http://www.ifomis.org/bfo/1.1#Entity> a owl:Class ;
    rdfs:label "entity"^^xsd:string .

<http://www.ifomis.org/bfo/1.1/snap#DependentContinuant> a owl:Class ;
    rdfs:label "dependent_continuant"^^xsd:string ;
    rdfs:comment "Definition: A continuant [snap:Continuant] that is either dependent on one or other independent continuant [snap:IndependentContinuant] bearers or inheres in or is borne by other entities."^^xsd:string ;
    rdfs:subClassOf <http://www.ifomis.org/bfo/1.1/snap#Continuant> ;
    owl:disjointWith <http://www.ifomis.org/bfo/1.1/snap#IndependentContinuant>,
        <http://www.ifomis.org/bfo/1.1/snap#SpatialRegion> .

<http://www.ifomis.org/bfo/1.1/snap#SpecificallyDependentContinuant> a owl:Class ;
    rdfs:label "specifically_dependent_continuant"^^xsd:string ;
    rdfs:comment "Definition: A continuant [snap:Continuant] that inheres in or is borne by other entities. Every instance of A requires some specific instance of B which must always be the same."^^xsd:string,
        "Examples: the mass of a cloud, the smell of mozzarella, the liquidity of blood, the color of a tomato, the disposition of fish to decay, the role of being a doctor, the function of the heart in the body: to pump blood, to receive de-oxygenated and oxygenated blood, etc."^^xsd:string,
        "Synonyms: property, trope, mode"^^xsd:string ;
    rdfs:subClassOf <http://www.ifomis.org/bfo/1.1/snap#DependentContinuant> .

<http://www.ifomis.org/bfo/1.1/snap#ZeroDimensionalRegion> a owl:Class ;
    rdfs:label "zero_dimensional_region"^^xsd:string ;
    rdfs:comment "Definition: A spatial region [snap:SpatialRegion] with no dimensions."^^xsd:string,
        "Examples: a point"^^xsd:string ;
    rdfs:subClassOf <http://www.ifomis.org/bfo/1.1/snap#SpatialRegion> .

<http://www.ifomis.org/bfo/1.1/span#ConnectedTemporalRegion> a owl:Class ;
    rdfs:label "connected_temporal_region"^^xsd:string ;
    rdfs:comment "Definition: A temporal region [span:TemporalRegion] every point of which is mediately or immediately connected with every other point of which."^^xsd:string,
        "Examples: the 1970s years, the time from the beginning to the end of a heart attack, the time taken up by cellular meiosis"^^xsd:string ;
    rdfs:subClassOf <http://www.ifomis.org/bfo/1.1/span#TemporalRegion> ;
    owl:disjointWith <http://www.ifomis.org/bfo/1.1/span#ScatteredTemporalRegion> .

<http://www.ifomis.org/bfo/1.1/span#ProcessBoundary> a owl:Class ;
    rdfs:label "process_boundary"^^xsd:string ;
    rdfs:comment "Definition: A processual entity [span:ProcessualEntity] that is the fiat or bona fide instantaneous temporal process boundary."^^xsd:string,
        "Examples: birth, death, the forming of a synapse, the onset of REM sleep, the detaching of a finger in an industrial accident, the final separation of two cells at the end of cell-division, the incision at the beginning of a surgery"^^xsd:string ;
    rdfs:subClassOf <http://www.ifomis.org/bfo/1.1/span#ProcessualEntity> ;
    owl:disjointWith <http://www.ifomis.org/bfo/1.1/span#ProcessualContext> .

<http://www.ifomis.org/bfo/1.1/span#SpatiotemporalRegion> a owl:Class ;
    rdfs:label "spatiotemporal_region"^^xsd:string ;
    rdfs:comment "Comment: All instances of occurrent [span:Occurrent] are spatiotemporal entities, that is, they enter in the relation of (spatiotemporal) location with spatiotemporal region [span:SpatiotemporalRegion] entities. As a particular case, the exact spatiotemporal location of a spatiotemporal region [span:SpatiotemporalRegion] is this region itself."^^xsd:string,
        "Comment: An instance of the spatiotemporal region [span:SpatiotemporalRegion] is a part of spacetime. All parts of spacetime are spatiotemporal region [span:SpatiotemporalRegion] entities and only spatiotemporal region [span:SpatiotemporalRegion] entities are parts of spacetime. In particular, neither spatial region [snap:SpatialRegion] entities nor temporal region [span:TemporalRegion] entities are in BFO parts of spacetime. Spacetime is the entire extent of the spatiotemporal universe, a designated individual, which is thus itself a spatiotemporal region [span:SpatiotemporalRegion]. Spacetime is among occurrents the analogous of space among continuant [snap:Continuant] entities."^^xsd:string,
        "Comment: Spacetime and spatiotemporal region [span:SpatiotemporalRegion] entities are entities in their own rights which exist independently of any entities which can be located at them. This view of spacetime can be called \"absolutist\" or \"the container view\". In BFO, the class processual context [span:ProcessualContext] allows for a so-called relational view of spacetime, that is to say, a view according to which spatiotemporality is a matter of relative location between entities and not a matter of being tied to spacetime. In BFO, the bridge between these two views is secured through the fact that instances of processual context [span:ProcessualContext] are too spatiotemporal entities."^^xsd:string,
        "Definition: An occurrent [span:Occurrent] at or in which processual entity [span:ProcessualEntity] entities can be located."^^xsd:string,
        "Examples: the spatiotemporal region occupied by a human life, the spatiotemporal region occupied by the development of a cancer tumor, the spatiotemporal context occupied by a process of cellular meiosis"^^xsd:string ;
    rdfs:subClassOf <http://www.ifomis.org/bfo/1.1/span#Occurrent> ;
    owl:disjointWith <http://www.ifomis.org/bfo/1.1/span#TemporalRegion> .

<http://www.opengis.net/ont/gml#AbstractGeometry> a owl:Class ;
    rdfs:label "Abstract Geometry"@en ;
    rdfs:isDefinedBy <http://www.opengis.net/ont/gml> ;
    rdfs:subClassOf geo:Geometry .

<http://www.opengis.net/ont/gml#AbstractGriddedSurface> a owl:Class ;
    rdfs:label "Abstract Gridded Surface"@en ;
    rdfs:isDefinedBy <http://www.opengis.net/ont/gml> ;
    rdfs:subClassOf <http://www.opengis.net/ont/gml#AbstractParametricCurveSurface> .

<http://www.opengis.net/ont/gml#Composite> a owl:Class ;
    rdfs:label "Composite"@en ;
    rdfs:isDefinedBy <http://www.opengis.net/ont/gml> ;
    rdfs:subClassOf <http://www.opengis.net/ont/gml#GeometricComplex> .

<http://www.opengis.net/ont/sf#GeometryCollection> a owl:Class ;
    rdfs:label "Geometry Collection"@en ;
    rdfs:comment """
A GeometryCollection is a geometric object that is a collection of some number of geometric objects.
All the elements in a GeometryCollection shall be in the same Spatial Reference System. This is also the Spatial Reference System for the GeometryCollection.
GeometryCollection places no other constraints on its elements. Subclasses of GeometryCollection may restrict membership based on dimension and may also place other constraints on the degree of spatial overlap between elements.
    """@en ;
    rdfs:isDefinedBy <http://www.opengis.net/ont/sf> ;
    rdfs:subClassOf <http://www.opengis.net/ont/sf#Geometry> .

isc:BaseArchean a gts-30:StandardGlobalNumericalAge,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Base of Archean"@en ;
    temporal:position isc:BaseArcheanTime ;
    gtrs-30:nextEra isc:Archean,
        isc:Eoarchean ;
    gtrs-30:previousEra isc:Hadean .

isc:BaseHolocene a gts-30:GeochronologicBoundary,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Base of Holocene"@en ;
    temporal:position isc:BaseHoloceneTime ;
    gtrs-30:nextEra isc:Holocene ;
    gtrs-30:previousEra isc:Pleistocene,
        isc:UpperPleistocene ;
    gts-30:stratotype isc:GSSPBaseHolocene ;
    rdfs:comment "NorthGRIP ice core, central Greenland |  75.1000 N 42.3200 W |  1492.45m depth in Borehole NGRIP2 |  Climatic  End of the Younger Dryas cold spell, which is reflected in a shift in deuterium excess values |  Ratified 2008 |  Episodes 31/2, 2008 J. Quaternary Sci., Vol. 24 pp. 317, 2009 | http://stratigraphy.science.purdue.edu/references/HoloceneGSSP_JQuatSci090.pdf"@en .

isc:BaseLopingian a gts-30:GeochronologicBoundary,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Base of Lopingian"@en ;
    temporal:position isc:BaseLopingianTime ;
    gtrs-30:nextEra isc:Lopingian,
        isc:Wuchiapingian ;
    gtrs-30:positionalUncertainty isc:BaseLopingianUncertainty ;
    gtrs-30:previousEra isc:Guadalupian ;
    gts-30:stratotype isc:GSSPBaseLopingian .

isc:BasePridoli a gts-30:GeochronologicBoundary,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Base of Pridoli"@en ;
    temporal:position isc:BasePridoliPosition ;
    gtrs-30:nextEra isc:Pridoli ;
    gtrs-30:positionalUncertainty isc:BasePridoliUncertainty ;
    gtrs-30:previousEra isc:Ludfordian,
        isc:Ludlow ;
    gts-30:stratotype isc:GSSPBasePridoli .

