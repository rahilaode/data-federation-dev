npdv:Wellbore a owl:Class ;
    npdv:definition "Designates the location of the well from one termination point to the wellhead. A wellbore may consistof one or more well tracks.  Source: http://www.npd.no/Global/Norsk/5-Regelverk/Tematiske-veiledninger/B_og_b_betegnelser_og_klassifisering.pdf " ;
    sql:columns "dateSyncNPD,wlbNpdidWellbore,wlbWell,wlbWellType,wlbWellboreName (table: wellbore_npdid_overview)" ;
    sql:label "Wellbore: NPDID (table: wellbore_npdid_overview)" ;
    sql:table "wellbore_npdid_overview" ;
    rdfs:isDefinedBy "http://sws.ifi.uio.no/vocab/version/20130919/npd-well" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty npdv:belongsToWell ;
            owl:someValuesFrom owl:Thing ],
        [ a owl:Restriction ;
            owl:onProperty npdv:name ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:name ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:onProperty npdv:dateSyncNPD ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:idNPD ;
            owl:someValuesFrom rdfs:Literal ],
        <http://www.ifomis.org/bfo/1.1/snap#Continuant> .

