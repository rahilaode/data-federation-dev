        "DATETIME (column: prlLicenseeDateUpdated)",
        "DATETIME (column: prlOperDateUpdated)",
        "DATETIME (column: prlPhaseDateUpdated)",
        "DATETIME (column: prlTaskDateUpdated)",
        "DATETIME (column: prlTransferDateUpdated)",
        "DATETIME (column: wlbCasingDateUpdated)",
