npdv:ProductionLicenceTransfer a owl:Class ;
    sql:columns "cmpLongName,cmpNpdidCompany,dateSyncNPD,prlName,prlNpdidLicence,prlTransferDateUpdated,prlTransferDateValidFrom,prlTransferDirection,prlTransferKind,prlTransferSdfi,prlTransferredInterest (table: licence_transfer_hst)" ;
