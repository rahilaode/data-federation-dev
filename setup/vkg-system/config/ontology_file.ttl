npdv:idNPD a owl:DatatypeProperty ;
    sql:column "baaArea.baaNpdidBsnsArrAreaPoly",
        "bsns_arr_area.baaNpdidBsnsArrArea",
        "company.cmpNpdidCompany",
        "discovery.dscNpdidDiscovery",
