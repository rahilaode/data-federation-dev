        "discovery_reserves.dscReservesDateUpdated",
        "facility_fixed.fclDateUpdated",
        "facility_moveable.fclDateUpdated",
        "field.fldDateUpdated",
        "field_activity_status_hst.fldStatusDateUpdated",
        "field_licensee_hst.fldLicenseeDateUpdated",
        "field_operator_hst.fldOperatorDateUpdated",
        "field_owner_hst.fldOwnerDateUpdated",
        "licence.prlDateUpdated",
        "licence_area_poly_hst.prlAreaDateUpdated",
        "licence_licensee_hst.prlLicenseeDateUpdated",
        "licence_oper_hst.prlOperDateUpdated",
        "licence_phase_hst.prlPhaseDateUpdated",
