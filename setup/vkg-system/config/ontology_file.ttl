npdv:Agent a owl:Class ;
    rdfs:subClassOf <http://www.ifomis.org/bfo/1.1/snap#DependentContinuant> .

npdv:Well a owl:Class ;
    npdv:definition "Borehole which is drilled in order to discover or delimit a petroleum deposit and/ or to produce petroleum or water for injection purposes, to inject gas, water or other medium, or to map or monitor well parameters. There are several categories of wells. A well may consist of one or several wellbores (well paths) and may have one or several termination poins.  Source: http://www.npd.no/Global/Norsk/5-Regelverk/Tematiske-veiledninger/B_og_b_betegnelser_og_klassifisering.pdf" ;
    sql:label "Wellbore: NPDID (extra table: wellbore_npdid_overview)" ;
    sql:table "wellbore_npdid_overview (ex)" ;
    rdfs:isDefinedBy "http://sws.ifi.uio.no/vocab/version/20130919/npd-well" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty npdv:dateSyncNPD ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:wellType ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:name ;
            owl:someValuesFrom xsd:string ],
        <http://www.ifomis.org/bfo/1.1/snap#Continuant> .

npdv:WellboreCasingAndLeakoffTest a owl:Class ;
    sql:columns "dateSyncNPD,wlbCasingDateUpdated,wlbCasingDepth,wlbCasingDiameter,wlbCasingType,wlbHoleDepth,wlbHoleDiameter,wlbLotMudDencity,wlbName,wlbNpdidWellbore (table: wellbore_casing_and_lot)" ;
    sql:label "Wellbore: Casing and leak-off tests (table: wellbore_casing_and_lot)" ;
    sql:table "wellbore_casing_and_lot" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty npdv:wellboreHoleDepth ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:dateSyncNPD ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:LOTForWellbore ;
            owl:someValuesFrom npdv:Wellbore ],
        [ a owl:Restriction ;
            owl:onProperty npdv:LOTMudDensity ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:casingDepth ;
            owl:someValuesFrom rdfs:Literal ],
        <http://www.ifomis.org/bfo/1.1/snap#Continuant> .

npdv:WellboreDrillingMudSample a owl:Class ;
    sql:columns "dateSyncNPD,wlbMD,wlbMudDateMeasured,wlbMudDateUpdated,wlbMudType,wlbMudViscosityAtMD,wlbMudWeightAtMD,wlbName,wlbNpdidWellbore,wlbYieldPointAtMD (table: wellbore_mud)" ;
    sql:label "Wellbore: Drilling mud (table: wellbore_mud)" ;
    sql:table "wellbore_mud" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty npdv:mudMeasuredDepth ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:mudViscosity ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:mudYieldPoint ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:mudTestForWellbore ;
            owl:someValuesFrom npdv:Wellbore ],
        [ a owl:Restriction ;
            owl:onProperty npdv:dateSyncNPD ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:mudWeight ;
            owl:someValuesFrom rdfs:Literal ],
        <http://www.ifomis.org/bfo/1.1/snap#Continuant> .

<http://www.ifomis.org/bfo/1.1/snap#ObjectAggregate> a owl:Class ;
    rdfs:label "object_aggregate"^^xsd:string ;
    rdfs:comment "Definition: A material entity [snap:MaterialEntity] that is a mereological sum of separate object [snap:Object] entities and possesses non-connected boundaries."^^xsd:string,
        "Examples: a heap of stones, a group of commuters on the subway, a collection of random bacteria, a flock of geese, the patients in a hospital"^^xsd:string,
        "Synonyms: substance aggregate"^^xsd:string ;
    rdfs:subClassOf <http://www.ifomis.org/bfo/1.1/snap#MaterialEntity> ;
    owl:disjointWith <http://www.ifomis.org/bfo/1.1/snap#ObjectBoundary>,
        <http://www.ifomis.org/bfo/1.1/snap#Site> .

