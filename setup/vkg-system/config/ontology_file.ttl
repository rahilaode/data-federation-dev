        "wellbore_formation_top.lsuNpdidLithoStrat",
        "wellbore_npdid_overview.wlbNpdidWellbore",
        "wellbore_shallow_all.wlbNpdidWellbore" ;
    sql:comment "NPD's unique id for business arrangement areas (column: baaNpdidBsnsArrArea)",
        "NPD's unique id for companies (column: cmpNpdidCompany)",
        "NPD's unique id for facilities (column: fclNpdidFacility)",
        "NPD's unique id for lithostratigraphic units. (extra column: wellbore_formation_top.lsuNpdidLithoStrat)",
        "NPD's unique id for production licences (column: prlNpdidLicence)",
        "NPD's unique id for the discovery. (column: dscNpdidDiscovery)",
        "NPD's unique id for the field. (column: fldNpdidField)",
        "NPD's unique id for the seismic survey. (column: seaNpdidSurvey)",
        "NPD's unique id for the wellbore. (column: wlbNpdidWellbore)",
        "NPD's unique id for transportation and utilisation facilities (column: tufNpdidTuf)" ;
    sql:datatype "INTEGER",
        "INTEGER (column: baaNpdidBsnsArrArea)",
        "INTEGER (column: baaNpdidBsnsArrAreaPoly)",
        "INTEGER (column: cmpNpdidCompany)",
        "INTEGER (column: dscNpdidDiscovery)",
        "INTEGER (column: fclNpdidFacility)",
        "INTEGER (column: fldNpdidField)",
        "INTEGER (column: pipNpdidPipe)",
        "INTEGER (column: prlNpdidLicence)",
        "INTEGER (column: seaNpdidSurvey)",
        "INTEGER (column: tufNpdidTuf)",
        "INTEGER (column: wlbNpdidWellbore)" ;
    sql:label "NPDID Bsns. Arr. Area (column: baaNpdidBsnsArrArea)",
        "NPDID company (column: cmpNpdidCompany)",
        "NPDID discovery (column: dscNpdidDiscovery)",
        "NPDID facility (column: fclNpdidFacility)",
        "NPDID field (column: fldNpdidField)",
        "NPDID for survey (column: seaNpdidSurvey)",
        "NPDID lithostrat. unit (extra column: wellbore_formation_top.lsuNpdidLithoStrat)",
        "NPDID production licence (column: prlNpdidLicence)",
        "NPDID tuf (column: tufNpdidTuf)",
        "NPDID wellbore (column: wlbNpdidWellbore)" ;
    rdfs:range xsd:integer .

npdv:SeismicSurvey a owl:Class ;
    npdv:definition "Seismic profiles are acquired by transmitting sound waves from a source above or in the substratum. The sound waves travel through the rock layers which reflect them up to sensors on the sea bed or at the surface, or down in a borehole. This enables an image of formations in the substratum to be formed. The seismic mapping of the Norwegian continental shelf started in 1962.  Source: http://www.npd.no/en/About-us/Information-services/Dictionary/" ;
    sql:columns "dateSyncNPD,sea3DKm2,seaBoatTotalKm,seaCdpTotalKm,seaCompanyReported,seaDateFinalized,seaDateStarting,seaGeographicalArea,seaGeotechnical,seaName,seaNpdidSurvey,seaPlanFromDate,seaPlanToDate,seaSampling,seaShallowDrilling,seaStatus,seaSurveyTypeMain,seaSurveyTypePart (table: seis_acquisition)" ;
    sql:label "Seismic Surveys (table: seis_acquisition)" ;
    sql:table "seis_acquisition" ;
    rdfs:isDefinedBy "http://sws.ifi.uio.no/vocab/version/20130919/npd-seismic" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty npdv:dateSurveyPlannedStart ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:dateSyncNPD ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:dateSurveyPlannedCompleted ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:idNPD ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:surveyType ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:currentStatus ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:reportingCompany ;
            owl:someValuesFrom npdv:Company ],
        [ a owl:Restriction ;
            owl:onProperty npdv:mainAreaLocation ;
            owl:someValuesFrom owl:Thing ],
        [ a owl:Restriction ;
            owl:onProperty npdv:name ;
            owl:someValuesFrom rdfs:Literal ],
        npdv:Survey .

