            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:transferredLicence ;
            owl:someValuesFrom npdv:ProductionLicence ],
        [ a owl:Restriction ;
            owl:onProperty npdv:transferredInterest ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:transferDirection ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:dateSyncNPD ;
            owl:someValuesFrom rdfs:Literal ],
        npdv:Transfer .

npdv:RecoveryWell a owl:Class ;
    npdv:definition "A well used for production or injection.  Source: http://www.npd.no/en/About-us/Information-services/Dictionary/" ;
    rdfs:isDefinedBy "http://sws.ifi.uio.no/vocab/version/20130919/npd-well" ;
    rdfs:subClassOf npdv:DevelopmentWell .

npdv:SeismicSurveyCoordinate a owl:Class ;
    sql:columns "dateSyncNPD,seaNpdidSurvey,seaPolygonEWDeg,seaPolygonEWMin,seaPolygonEWSec,seaPolygonNSDeg,seaPolygonNSMin,seaPolygonNSSec,seaPolygonPointNumber,seaSurveyName (table: seis_acquisition_coordinates_inc_turnarea)" ;
    sql:label "Seismic Surveys: Coordinates (table: seis_acquisition_coordinates_inc_turnarea)" ;
    sql:table "seis_acquisition_coordinates_inc_turnarea" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty npdv:minutesEW ;
