npdv:Kick a owl:Class ;
    npdv:definition "Loss of control over a well, resulting in uncontrolled backflow of drilling liquid. It is an indication of a blow-out due to the well taking in gas, oil or water.  Source: http://www.npd.no/en/About-us/Information-services/Dictionary/" ;
    rdfs:isDefinedBy "http://sws.ifi.uio.no/vocab/version/20130919/npd-well" ;
    rdfs:subClassOf <http://www.ifomis.org/bfo/1.1/span#Occurrent> .

npdv:KickOffPoint a owl:Class ;
    rdfs:isDefinedBy "http://sws.ifi.uio.no/vocab/version/20130919/npd-well" ;
    rdfs:subClassOf <http://www.ifomis.org/bfo/1.1/snap#Continuant> .

npdv:LandfallFacility a owl:Class ;
    rdfs:subClassOf npdv:Facility .

npdv:LicencedAcreage a owl:Class ;
    npdv:definition "The acreage awarded in a production licence. Only exploration drilling and production may take place in an area covered by a production licence.  Source: http://www.npd.no/en/About-us/Information-services/Dictionary/" ;
    rdfs:isDefinedBy "http://sws.ifi.uio.no/vocab/version/20130919/npd-geometry" ;
    rdfs:subClassOf npdv:Area .

npdv:LiquefiedNaturalGas a owl:Class ;
    npdv:definition "Mainly methane (CH4) transformed into liquid form by cooling.  Source: http://www.npd.no/en/About-us/Information-services/Dictionary/" ;
    rdfs:isDefinedBy "http://sws.ifi.uio.no/vocab/version/20130919/npd-prod" ;
    rdfs:subClassOf npdv:Gas .

npdv:LiquefiedPetroleumGas a owl:Class ;
    npdv:definition "Mainly propane (C3H8) and butane (C4H10) transformed into liquid by raising the pressure or cooling.  Source: http://www.npd.no/en/About-us/Information-services/Dictionary/" ;
    rdfs:isDefinedBy "http://sws.ifi.uio.no/vocab/version/20130919/npd-prod" ;
    rdfs:subClassOf npdv:Gas .

npdv:LoadingSystemFacility a owl:Class ;
    rdfs:subClassOf npdv:Facility .

npdv:MergerTakeoverTransfer a owl:Class ;
    rdfs:subClassOf npdv:Transfer .

npdv:MonotowerFacility a owl:Class ;
    rdfs:subClassOf npdv:Facility .

