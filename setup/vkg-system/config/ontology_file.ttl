npdv:polygonLicenceComment a owl:AnnotationProperty ;
    sql:column "prlArea.prlAreaPolyVertLimEn",
        "prlArea.prlAreaPolyVertLimNo",
        "prlAreaSplitByBlock.prlAreaPolyVertLimEn",
        "prlAreaSplitByBlock.prlAreaPolyVertLimNo" ;
    sql:datatype "TEXT (column: prlAreaPolyVertLimEn)",
        "TEXT (column: prlAreaPolyVertLimNo)" .

npdv:pressReleaseURL a owl:ObjectProperty ;
    sql:column "wellbore_exploration_all.wlbPressReleaseUrl" ;
    sql:datatype "VARCHAR(200) (column: wlbPressReleaseUrl)" ;
    rdfs:domain npdv:ExplorationWellbore .

npdv:productionFacility a owl:ObjectProperty ;
    sql:column "wellbore_development_all.fclNpdidFacilityProducing" ;
    sql:comment "NPD's unique id for the production facility, for development wellbores. (column: fclNpdidFacilityProducing)" ;
    sql:datatype "INTEGER (column: fclNpdidFacilityProducing)" ;
    sql:label "NPDID production facility (column: fclNpdidFacilityProducing)" ;
    rdfs:domain npdv:DevelopmentWellbore .

npdv:productionForDiscovery a owl:ObjectProperty .

npdv:productionForField a owl:ObjectProperty .

npdv:shallowWellboreForField a owl:ObjectProperty ;
    rdfs:subPropertyOf npdv:wellboreForField .

npdv:sourceNumber a owl:DatatypeProperty ;
    sql:column "seaArea.seaSourceNumber",
        "seaMultiline.seaSourceNumber" ;
    sql:comment "Total number of sources (column: seaSourceNumber)" ;
    sql:datatype "VARCHAR(100) (column: seaSourceNumber)" ;
    sql:label "Number of sources (column: seaSourceNumber)" ;
    rdfs:range rdfs:Literal .

npdv:sourcePressure a owl:DatatypeProperty ;
    sql:column "seaArea.seaSourcePressure",
        "seaMultiline.seaSourcePressure" ;
    sql:comment "Pressure used. Example of legal values: '2000 PSI'. (column: seaSourcePressure)" ;
    sql:datatype "VARCHAR(100) (column: seaSourcePressure)" ;
    sql:label "Source pressure (column: seaSourcePressure)" ;
    rdfs:range rdfs:Literal .

npdv:sourceSize a owl:DatatypeProperty ;
    sql:column "seaArea.seaSourceSize",
        "seaMultiline.seaSourceSize" ;
    sql:comment "Size of the source. Can be a volume or a amperage. Example of legal values: '5085 cu.in', '1000A' (column: seaSourceSize)" ;
    sql:datatype "VARCHAR(100) (column: seaSourceSize)" ;
    sql:label "Source size (column: seaSourceSize)" ;
    rdfs:range rdfs:Literal .

npdv:surveyProgressDescription a owl:AnnotationProperty ;
    sql:column "seis_acquisition_progress.seaProgressDescription",
        "seis_acquisition_progress.seaProgressText" ;
    sql:datatype "TEXT (column: seaProgressDescription)",
        "TEXT (column: seaProgressText)" ;
    rdfs:domain npdv:SeismicSurveyProgress .

npdv:surveySubType a owl:DatatypeProperty ;
    sql:column "seis_acquisition.seaSurveyTypePart" ;
    sql:comment "Sub-type of seismic acquistion. Legal values are: '2D', '3D', '4D', 'OBS'. (column: seaSurveyTypePart)" ;
    sql:datatype "VARCHAR(100) (column: seaSurveyTypePart)" ;
    sql:label "Sub type (column: seaSurveyTypePart)" ;
    rdfs:domain npdv:SeismicSurvey ;
    rdfs:range xsd:string .

npdv:wellboreAgeHcLevel1 a owl:ObjectProperty ;
    sql:column "wellbore_exploration_all.wlbAgeWithHc1" ;
    sql:comment "Age of lithostratigraphic unit, 1st level, where hydrocarbons were encountered. Examples of legal values: CRETACEOUS, EARLY CRETACEOUS, LATE JURASSIC, EOCENE. See also NPD bulletins. (column: wlbAgeWithHc1)" ;
    sql:datatype "VARCHAR(20) (column: wlbAgeWithHc1)" ;
    sql:label "1st level with HC, age (column: wlbAgeWithHc1)" ;
    rdfs:domain npdv:ExplorationWellbore ;
    rdfs:subPropertyOf npdv:wellboreAgeHc .

npdv:wellboreAgeHcLevel2 a owl:ObjectProperty ;
    sql:column "wellbore_exploration_all.wlbAgeWithHc2" ;
    sql:comment "Age of lithostratigraphic unit, 2nd level, where hydrocarbons were encountered. Examples of legal values: CRETACEOUS, EARLY CRETACEOUS, LATE JURASSIC, EOCENE. (column: wlbAgeWithHc2)" ;
    sql:datatype "VARCHAR(20) (column: wlbAgeWithHc2)" ;
    sql:label "2nd level with HC, age (column: wlbAgeWithHc2)" ;
    rdfs:domain npdv:ExplorationWellbore ;
    rdfs:subPropertyOf npdv:wellboreAgeHc .

npdv:wellboreAgeHcLevel3 a owl:ObjectProperty ;
    sql:column "wellbore_exploration_all.wlbAgeWithHc3" ;
    sql:comment "Age of lithostratigraphic unit, 3rd level, where hydrocarbons were encountered. Examples of legal values: CRETACEOUS, EARLY CRETACEOUS, LATE JURASSIC, EOCENE. (column: wlbAgeWithHc3)" ;
    sql:datatype "CHAR(20) (column: wlbAgeWithHc3)" ;
    sql:label "3rd level with HC, age (column: wlbAgeWithHc3)" ;
    rdfs:domain npdv:ExplorationWellbore ;
    rdfs:subPropertyOf npdv:wellboreAgeHc .

npdv:wellboreAgeTD a owl:ObjectProperty ;
    sql:column "wellbore_exploration_all.wlbAgeAtTd" ;
    sql:comment "Age (according to Geologic Time Scale 2004 by F. M. Gradstein, et al. (2004)) of the oldest penetrated formation. May differ from age at TD for example in deviated wellbores. Examples of legal values: CRETACEOUS, EARLY CRETACEOUS, LATE JURASSIC, EARLY PERMIAN, EARLY TRIASSIC, EOCENE. (column: wlbAgeAtTd)" ;
    sql:datatype "VARCHAR(40) (column: wlbAgeAtTd)" ;
    sql:label "Oldest penetrated age (column: wlbAgeAtTd)" ;
    rdfs:domain npdv:ExplorationWellbore .

npdv:wellboreBottomHoleTemperature a owl:DatatypeProperty ;
    sql:column "wellbore_exploration_all.wlbBottomHoleTemperature" ;
    sql:comment "Estimated temperature at final total depth of the wellbore. See discription. (column: wlbBottomHoleTemperature)" ;
    sql:datatype "INTEGER (column: wlbBottomHoleTemperature)" ;
    sql:label "Bottom hole temperature [°C] (column: wlbBottomHoleTemperature)" ;
    rdfs:domain npdv:ExplorationWellbore ;
    rdfs:range xsd:integer .

npdv:wellboreContent a owl:DatatypeProperty ;
    sql:column "wellbore_development_all.wlbContent",
        "wellbore_exploration_all.wlbContent" ;
    sql:comment "For exploration wellbores, status of discovery. Examples of legal values: DRY, SHOWS (trace amounts of hydrocarbons), GAS, GAS/CONDENSATE, OIL or OIL/GAS. SHOWS (GAS SHOWS, OIL SHOWS or OIL/GAS SHOWS) are detected as fluorescent cut (organic extract), petroleum odour, or visual stain on cuttings or cores, or as increased gas reading on the mud-loggers gas detection equipment. For development wellbores, type of produced/injected fluid. Examples of legal values: WATER, CUTTINGS, NOT AVAILABLE, OIL, GAS/CONDENSATE, OIL/GAS, CO2, GAS, WATER/GAS, NOT APPLICABLE.  (column: wlbContent)" ;
    sql:datatype "VARCHAR(40) (column: wlbContent)" ;
    sql:label "Content (column: wlbContent)" ;
    rdfs:range xsd:string .

npdv:wellboreFinalVerticalDepth a owl:DatatypeProperty ;
    sql:column "wellbore_development_all.wlbFinalVerticalDepth",
        "wellbore_exploration_all.wlbFinalVerticalDepth" ;
    sql:comment "Vertical elevation from total depth to kelly bushing. Often referred to as true vertical depth (TVD). (column: wlbFinalVerticalDepth)" ;
    sql:datatype "DECIMAL(6,2) (column: wlbFinalVerticalDepth)" ;
    sql:label "Final vertical depth (TVD) [m RKB] (column: wlbFinalVerticalDepth)" ;
    rdfs:range xsd:decimal .

npdv:wellboreFormationHcLevel1 a owl:ObjectProperty ;
    rdfs:subPropertyOf npdv:wellboreFormationHc .

npdv:wellboreFormationHcLevel2 a owl:ObjectProperty ;
    rdfs:subPropertyOf npdv:wellboreFormationHc .

npdv:wellboreFormationHcLevel3 a owl:ObjectProperty ;
    rdfs:subPropertyOf npdv:wellboreFormationHc .

npdv:wellboreFormationTD a owl:ObjectProperty .

npdv:wellboreHoleDiameter a owl:DatatypeProperty ;
    sql:column "wellbore_casing_and_lot.wlbHoleDiameter" ;
    sql:comment "Diameter of wellbore (the drill bit). (column: wlbHoleDiameter)" ;
    sql:datatype "VARCHAR(6) (column: wlbHoleDiameter)" ;
    sql:label "Hole diam. [inch] (column: wlbHoleDiameter)" ;
    rdfs:domain npdv:WellboreCasingAndLeakoffTest ;
    rdfs:range rdfs:Literal .

npdv:wellboreMaxInclation a owl:DatatypeProperty ;
    sql:column "wellbore_exploration_all.wlbMaxInclation" ;
    sql:comment "Maximum deviation, in degrees, from a vertical well path. (column: wlbMaxInclation)" ;
    sql:datatype "DECIMAL(6,2) (column: wlbMaxInclation)" ;
    sql:label "Maximum inclination [°] (column: wlbMaxInclation)" ;
    rdfs:domain npdv:ExplorationWellbore ;
    rdfs:range xsd:decimal .

npdv:wellboreNamePart5 a owl:DatatypeProperty ;
    sql:column "wellbore_development_all.wlbNamePart5",
        "wellbore_exploration_all.wlbNamePart5",
        "wellbore_shallow_all.wlbNamePart5" ;
    sql:comment "Part 5 of the wellbore name. Used to indicate exploration wells planned deviated (S), sidetracks (A, B,...), re-entries (R) or planned multilaterals (Y). Based on NPD guidelines for designation of wells and wellbores. (column: wlbNamePart5)" ;
    sql:datatype "VARCHAR(2) (column: wlbNamePart5)" ;
    sql:label "Wellbore name, part 5 (column: wlbNamePart5)" ;
    rdfs:range xsd:string .

npdv:wellboreNamePart6 a owl:DatatypeProperty ;
    sql:column "wellbore_development_all.wlbNamePart6",
        "wellbore_exploration_all.wlbNamePart6",
        "wellbore_shallow_all.wlbNamePart6" ;
    sql:comment "Part 6 of the wellbore name. Serial number of re-entries or serial number of the well tracks in multilatrals. Based on NPD guidelines for designation of wells and wellbores. (column: wlbNamePart6)" ;
    sql:datatype "VARCHAR(2) (column: wlbNamePart6)" ;
    sql:label "Wellbore name, part 6 (column: wlbNamePart6)" ;
    rdfs:range xsd:string .

npdv:wellboreParent a owl:DatatypeProperty ;
    sql:column "wellbore_development_all.wlbDiskosWellboreParent",
        "wellbore_exploration_all.wlbDiskosWellboreParent" ;
    sql:comment "Wellbore parent - applicable for DISKOS. (column: wlbDiskosWellboreParent)" ;
    sql:datatype "VARCHAR(40) (column: wlbDiskosWellboreParent)" ;
    sql:label "DISKOS Wellbore Parent (column: wlbDiskosWellboreParent)" .

npdv:wellborePlannedContent a owl:DatatypeProperty ;
    sql:column "wellbore_development_all.wlbContentPlanned" ;
    sql:comment "Only relevant for development wellbores, planned type of produced or injected fluid. Examples of legal values: CO2, CUTTINGS, GAS, NOT APPLICABLE, NOT AVAILABLE, WATER, WATER/GAS (column: wlbContentPlanned)" ;
    sql:datatype "VARCHAR(40) (column: wlbContentPlanned)" ;
    sql:label "Content - planned (column: wlbContentPlanned)" ;
    rdfs:domain npdv:DevelopmentWellbore ;
    rdfs:range xsd:string .

npdv:wellboreReentryExplorationActivity a owl:DatatypeProperty ;
    sql:column "wellbore_exploration_all.wlbReentryExplorationActivity" ;
    sql:comment "Reason for reentry of the wellbore. Only relevant for exploration wellbores. Example of legal values: DRILLING, DRILLING/PLUGGING, LOGGING, PLUGGING, TESTING, TESTING/PLUGGING. (column: wlbReentryExplorationActivity)" ;
    sql:datatype "VARCHAR(40) (column: wlbReentryExplorationActivity)" ;
    sql:label "Reentry activity (column: wlbReentryExplorationActivity)" ;
    rdfs:domain npdv:ExplorationWellbore ;
    rdfs:range xsd:string .

npdv:wellboreSeismicLocation a owl:DatatypeProperty ;
    sql:column "wellbore_exploration_all.wlbSeismicLocation",
        "wellbore_shallow_all.wlbSeismicLocation" ;
    sql:comment "Position of wellbore on seismic survey lines. SP: shotpoint. (column: wlbSeismicLocation)" ;
    sql:datatype "VARCHAR(200) (column: wlbSeismicLocation)" ;
    sql:label "Seismic location (column: wlbSeismicLocation)" ;
    rdfs:range xsd:string .

npdv:wellboreWellType a owl:DatatypeProperty ;
    sql:column "wellbore_npdid_overview.wlbWellType" ;
    sql:comment "Wellbore type. Legal values: EXPLORATION, DEVELOPMENT, SHALLOW (column: wlbWellType)" ;
    sql:datatype "VARCHAR(20) (column: wlbWellType)" ;
    sql:label "Type (column: wlbWellType)" ;
    rdfs:domain npdv:Wellbore .

ptl:ChangedAwardNotification a owl:Class ;
    rdfs:subClassOf ptl:Notification .

ptl:DeletedEasementNotification a owl:Class ;
    rdfs:subClassOf ptl:Notification .

ptl:EasementNotification a owl:Class ;
    rdfs:subClassOf ptl:Notification .

ptl:NewAwardNotification a owl:Class ;
    rdfs:subClassOf ptl:Notification .

ptl:dateUpdated a owl:DatatypeProperty ;
    sql:column "licence_petreg_licence.ptlDateUpdated",
        "licence_petreg_licence_licencee.ptlLicenseeDateUpdated",
        "licence_petreg_licence_oper.ptlOperDateUpdated",
        "licence_petreg_message.ptlMessageDateUpdated",
        "tuf_petreg_licence.ptlDateUpdated",
        "tuf_petreg_licence_licencee.ptlLicenseeDateUpdated",
        "tuf_petreg_licence_oper.ptlOperDateUpdated",
        "tuf_petreg_message.ptlMessageDateUpdated" ;
    sql:comment "Dato for når informasjon om denne Petroleumsregister tillatelsen ble oppdatert sist eller lagt inn for første gang. Datoen vil bare bli forandret dersom data i 'Hovednivå' blir forandret. (column: ptlDateUpdated)",
        "Dato når denne posten ble oppdatert sist eller lagt inn for første gang. (column: ptlLicenseeDateUpdated)",
        "Dato når denne posten ble oppdatert sist eller lagt inn for første gang. (column: ptlMessageDateUpdated)",
        "Dato når denne posten ble oppdatert sist eller lagt inn for første gang. (column: ptlOperDateUpdated)" ;
    sql:datatype "DATETIME (column: ptlDateUpdated)",
        "DATETIME (column: ptlLicenseeDateUpdated)",
        "DATETIME (column: ptlMessageDateUpdated)",
        "DATETIME (column: ptlOperDateUpdated)" ;
    sql:label "Dato hovednivå oppdatert (column: ptlDateUpdated)",
        "Dato oppdatert (column: ptlLicenseeDateUpdated)",
        "Dato oppdatert (column: ptlMessageDateUpdated)",
        "Dato oppdatert (column: ptlOperDateUpdated)" ;
    rdfs:range xsd:date .

ptl:message a owl:AnnotationProperty ;
    sql:column "licence_petreg_message.ptlMessage",
        "tuf_petreg_message.ptlMessage" ;
    sql:comment "Utdrag av dokumentet, orginal dokumentet er registert i OD (column: ptlMessage)" ;
    sql:datatype "TEXT (column: ptlMessage)" ;
    sql:label "Utdrag av dokument (column: ptlMessage)" .

