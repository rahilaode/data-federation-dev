npdv:NaturalGasLiquid a owl:Class ;
    npdv:definition "A collective term for the petroleum qualities, ethane, propane, isobutane, normal butane and naphtha. NGL are partially liquid at normal pressure.  Source: http://www.npd.no/en/About-us/Information-services/Dictionary/" ;
    rdfs:isDefinedBy "http://sws.ifi.uio.no/vocab/version/20130919/npd-prod" ;
    rdfs:subClassOf npdv:Petroleum .

npdv:NorwegianContinentalShelf a owl:NamedIndividual ;
    npdv:definition "The sea bed and its substrata in the maritime areas which extend beyond Norwegian territorial waters over the entire natural continuation of the land territory to the outermost extent of the continental margin, but not less than 200 nautical miles from the sea boundaries from which the breadth of the territorial waters is measured, yet not beyond the centre line relative to another nation." ;
    rdfs:isDefinedBy "http://sws.ifi.uio.no/vocab/version/20130919/npd-geometry" .

npdv:ObservationWell a owl:Class ;
    npdv:definition "Production or test production well used to measure specific well parameters.  Source: http://www.npd.no/en/About-us/Information-services/Dictionary/" ;
    rdfs:isDefinedBy "http://sws.ifi.uio.no/vocab/version/20130919/npd-well" ;
    rdfs:subClassOf npdv:DevelopmentWell .

npdv:ObservationWellbore a owl:Class ;
    rdfs:subClassOf npdv:Wellbore .

npdv:OilEquivalents a owl:Class ;
    npdv:definition "Used when oil, gas, condensate and NGL are to be totalled. The term is either linked to the amount of energy liberated by combustion of the various types of petroleum or to the sales values, so that everything can be compared with oil.   Source: http://www.npd.no/en/About-us/Information-services/Dictionary/" ;
    rdfs:isDefinedBy "http://sws.ifi.uio.no/vocab/version/20130919/npd-prod" ;
    rdfs:subClassOf <http://www.ifomis.org/bfo/1.1/snap#ObjectAggregate> .

npdv:OilGasPipeline a owl:Class ;
    rdfs:subClassOf npdv:Pipeline .

npdv:OilPipeline a owl:Class ;
    rdfs:subClassOf npdv:Pipeline .

npdv:OnshoreFacility a owl:Class ;
    rdfs:subClassOf npdv:Facility .

npdv:OtherSurvey a owl:Class ;
    rdfs:subClassOf npdv:Survey .

npdv:PAWellbore a owl:Class ;
    rdfs:subClassOf npdv:Wellbore .

npdv:ParcellBAA a owl:Class ;
    rdfs:subClassOf npdv:BAA .

npdv:PetroleumActivity a owl:Class ;
    npdv:definition "All activity linked to subsea petroleum deposits, including investigation, exploratory drilling, recovery, transport, utilisation and termination, and also the planning of such activities, but not the transportation of petroleum in bulk by ship.  Source: http://www.npd.no/en/About-us/Information-services/Dictionary/" ;
    rdfs:isDefinedBy "http://sws.ifi.uio.no/vocab/version/20130919/npd-org" ;
    rdfs:subClassOf <http://www.ifomis.org/bfo/1.1/span#ProcessualEntity> .

npdv:PetroleumDeposit a owl:Class ;
    npdv:definition "An accumulation of petroleum in a geological unit, delimited by rock types at structural or stratigraphical boundaries, contact surfaces between petroleum and water in the formation, or a combination of these, such that the petroleum concerned is everywhere in pressure communication through liquid or gas.  Source: http://www.npd.no/en/About-us/Information-services/Dictionary/" ;
    rdfs:isDefinedBy "http://sws.ifi.uio.no/vocab/version/20130919/npd-geology" ;
    rdfs:subClassOf <http://www.ifomis.org/bfo/1.1/snap#ObjectAggregate> .

npdv:PlanForDevelopmentAndOperationOfPetroleumDeposits a owl:Class ;
    rdfs:isDefinedBy "http://sws.ifi.uio.no/vocab/version/20130919/npd-org" ;
    rdfs:subClassOf npdv:Plan .

npdv:PlanForInstallationAndOperation a owl:Class ;
    npdv:definition "PIO" ;
    rdfs:isDefinedBy "http://sws.ifi.uio.no/vocab/version/20130919/npd-org" ;
    rdfs:subClassOf npdv:Plan .

npdv:Play a owl:Class ;
    npdv:definition "A geographically and stratigraphically delimited area where a specific set of geological factors is present so that petroleum should be able to be proven in producible volumes. Such geological factors are a reservoir rock, trap, mature source rock, migration routes, and that the trap was formed before the migration of petroleum ceased. All discoveries and prospects in the same play are characterised by the play's specific set of geological factors.  Source: http://www.npd.no/en/About-us/Information-services/Dictionary/" ;
    rdfs:isDefinedBy "http://sws.ifi.uio.no/vocab/version/20130919/npd-geology" ;
    rdfs:subClassOf <http://www.ifomis.org/bfo/1.1/snap#Site> .

