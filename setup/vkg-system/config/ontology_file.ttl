        [ a owl:Restriction ;
            owl:onProperty npdv:lengthPlannedBoatKm ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:sensorLength ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:sensorType ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty geo:asWKT ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:sensorNumbers ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:isMarketAvailable ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:sourceType ;
            owl:someValuesFrom rdfs:Literal ],
        npdv:Area .

npdv:SuspReenteredLaterWellbore a owl:Class ;
    rdfs:subClassOf npdv:Wellbore .

npdv:SuspendedWellbore a owl:Class ;
    rdfs:subClassOf npdv:Wellbore .

npdv:TUFacility a owl:Class ;
    sql:table "tuf_operator_hst (ex)",
        "tuf_owner_hst (ex)" ;
