    dc:source "Episodes 8/2, p. 101 103, 1985"^^xsd:string,
        "Silurian Times No. 14 (2006)"^^xsd:string ;
    gts-30:primaryGuidingCriterion "Dobs Linn, Scotland | 1.6m above thebase of the Birkhill Shale Formation  | Graptolite FAD Akidograptus ascensus"@en ;
    gts-30:status "Ratified 1984"@en .

isc:GSSPBaseSinemurian a gts-30:GlobalStratotypePoint,
        owl:NamedIndividual ;
    rdfs:label "GSSP of Base Sinemurian"@en ;
    sampling:shape isc:BaseSinemurian-location ;
    dc:source "Episodes 25/1, p. 22 28, 2002"^^xsd:string ;
    gts-30:primaryGuidingCriterion "East Quantoxhead, SW England | 0.90 m above the base of Bed 145 | Ammonite FAD Vermiceras quantoxense, Vermiceras palmeri"@en ;
    gts-30:status "Ratified 2000"@en ;
    rdfs:seeAlso <http://stratigraphy.science.purdue.edu/references/Sinemurian.pdf> .

isc:GSSPBaseThanetian a gts-30:GlobalStratotypePoint,
        owl:NamedIndividual ;
    rdfs:label "GSSP of Base Thanetian"@en ;
    sampling:shape isc:BaseThanetian-location ;
    gts-30:primaryGuidingCriterion "Zumaia section, northern Spain | 30.5m above the base of Itzurun Formation | Magnetic Base of Chron C26n"@en ;
    gts-30:status "Ratified 2008"@en .

isc:GSSPBaseTortonian a gts-30:GlobalStratotypePoint,
        owl:NamedIndividual ;
    rdfs:label "GSSP of Base Tortonian"@en ;
    sampling:shape isc:BaseTortonian-location ;
    dc:source "Episodes 28/1, p. 6  17, 2005"^^xsd:string ;
    gts-30:primaryGuidingCriterion "Monte dei Corvi Beach, near Ancona, Italy | mid-point of sapropel layer of basic cycle number 76. Calcareous nannofossil last common occurrence of Discoaster kugleri"@en ;
    gts-30:status "Ratified 2003"@en .

isc:GSSPBaseTuronian a gts-30:GlobalStratotypePoint,
        owl:NamedIndividual ;
    rdfs:label "GSSP of Base Turonian"@en ;
    sampling:shape isc:BaseTuronian-location ;
    dc:source "Episodes 28/2,p. 93  104, 2005"^^xsd:string ;
    gts-30:primaryGuidingCriterion "Pueblo, Colorado, USA |  base of Bed 86 of the Bridge Creek Limestone Member | Ammonite FAD Watinoceras devonense"@en ;
    gts-30:status "Ratified 2003 "@en .

isc:GSSPBaseUpperCretaceous a gts-30:GlobalStratotypePoint,
        owl:NamedIndividual ;
    rdfs:label "GSSP of Base Upper Cretaceous"@en ;
    sampling:shape isc:BaseUpperCretaceous-location ;
    dc:source "Episodes 27/1, p. 21 32, 2004"^^xsd:string ;
    gts-30:primaryGuidingCriterion "Mount Risou, Hautes Alpes, France | 36 meters below the top of the Marnes Bleues Formation on the south side of Mont Risou | Planktonic foraminifer FAD Rotalipora globotruncanoides"@en ;
    gts-30:status "Ratified 2002"@en .

isc:GSSPBaseUpperDevonian a gts-30:GlobalStratotypePoint,
        owl:NamedIndividual ;
    rdfs:label "GSSP of Base Upper Devonian"@en ;
    sampling:shape isc:BaseUpperDevonian-location ;
    dc:source "Episodes 10/2, p. 97101, 1987"^^xsd:string ;
    gts-30:primaryGuidingCriterion "Col du Puech de la Suque, Montage Noire, France | base of Bed 42  at Col du Puech de la Suque section E |Conodont FAD Ancyrodella rotundiloba"@en ;
    gts-30:status "Ratified 1986"@en .

isc:GSSPBaseUpperOrdovician a gts-30:GlobalStratotypePoint,
        owl:NamedIndividual ;
    rdfs:label "GSSP of Base Upper Ordovician"@en ;
    sampling:shape isc:BaseUpperOrdovician-location ;
    dc:source "Episodes 23/2, p. 102 109, 2000"^^xsd:string ;
    gts-30:primaryGuidingCriterion "Sularp Brook, Fagelsang, Sweden | 1.4m below a phosphorite marker bed in the E14b outcrop | Graptolite FAD Nemagraptus gracilis"@en ;
    gts-30:status "Ratified 2002"@en .

isc:GSSPBaseUpperTriassic a gts-30:GlobalStratotypePoint,
        owl:NamedIndividual ;
    rdfs:label "GSSP of Base Upper Triassic"@en ;
    sampling:shape isc:BaseUpperTriassic-location ;
    dc:source "Albertiana 36, 2007"^^xsd:string ;
    gts-30:primaryGuidingCriterion "Prati di Stuores, Dolomites, Italy | base of marly limestone bed SW4, 45m from base of San Cassiano Formation | Near FADs ammonoid Daxatina, conodont ParagondolellatpolygnathiformistandtbivalvestHalobia.tJusttabovetbasetoftmagnetictpolarity zonetS2ntandtabovetthetmaximumtfloodingtsurface oftSequencetLadt3toftHardenboltettalt(1998)."@en ;
    gts-30:status "Ratified 2008"@en .

isc:GSSPBaseWenlock a gts-30:GlobalStratotypePoint,
        owl:NamedIndividual ;
    rdfs:label "GSSP of Base Wenlock"@en ;
    sampling:shape isc:BaseWenlock-location ;
    dc:source "Episodes 5/3, p. 21-23, 1982"^^xsd:string,
        "Geol. Series, Nat. Mus. Wales, 9, p. 51 73, 1989"^^xsd:string,
        "Lethaia 14"^^xsd:string ;
    gts-30:primaryGuidingCriterion "Hughley Brook, UK | base of the Buildwas Formation | Imprecise. Between the base of acritarch biozone 5 and LAD of conodont Pterospathodus amorphognathoides. The current GSSP does not coincide with the base of the Cyrtograptus centrifugus Biozone, as was supposed when the GSSP was defined. Restudy recommends a slightly higher and correlatable level on condonts  the Ireviken datum 2, which coincides approximately with the base of the murchisoni Graptolite Biozone"@en ;
    gts-30:status "Ratified 1980"@en .

isc:GSSPBaseWordian a gts-30:GlobalStratotypePoint,
        owl:NamedIndividual ;
    rdfs:label "GSSP of Base Wordian"@en ;
    sampling:shape isc:BaseWordian-location ;
    gts-30:primaryGuidingCriterion "Guadalupe Pass, Texas, U.S.A |  7.6m above the base of the Getaway Ledge outcrop Section of the Getaway Limestone Member of the Cherry Canyon Formation| Conodont FAD Jinogondolella aserrata"@en ;
    gts-30:status "Ratified 2001"@en .

isc:PresentTime a temporal:Coordinate,
        owl:NamedIndividual ;
    temporal:frame <http://resource.geosciml.org/classifier/cgi/geologicage/ma> .

<http://resource.geosciml.org/classifierscheme/ics/ischart/2009> a owl:NamedIndividual .

gts-30:GeologicTimescale a owl:Class .

<http://resource.geosciml.org/vocabulary/timescale/isc-2012> dc:creator "Simon J D COX"@en ;
    dc:rights <http://opendatacommons.org/licenses/by/1.0>,
        "This Ontology is made available under the Open Data Commons Attribution License: http://opendatacommons.org/licenses/by/1.0"^^xsd:string,
        "Original version Copyright © 2012 International Commission on Stratigraphy"@en,
        "RDF version Copyright © 2012 CSIRO, Arizona Geological Survey, IUGS"@en ;
    dcterms:replaces <http://resource.geosciml.org/vocabulary/timescale/isc-2010> .

npdv:Block a owl:Class ;
    npdv:definition "A geographical unit of division used in the petroleum activities on the continental shelf. The maritime areas within the outermost limit of the continental shelf are divided into blocks measuring 15 minutes of latitude and 20 minutes of longitude, unless adjacent areas of land, borders with the continental shelves of other nations, or other factors decree otherwise.  Source: http://www.npd.no/en/About-us/Information-services/Dictionary/" ;
    sql:table "wellbore_development_all (ex)",
        "wellbore_exploration_all (ex)",
        "wellbore_shallow_all (ex)" ;
    rdfs:isDefinedBy "http://sws.ifi.uio.no/vocab/version/20130919/npd-geometry" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty npdv:quadrantLocation ;
            owl:someValuesFrom owl:Thing ],
        [ a owl:Restriction ;
            owl:onProperty npdv:containsWellbore ;
            owl:someValuesFrom owl:Thing ],
        [ a owl:Restriction ;
            owl:onProperty npdv:dateSyncNPD ;
            owl:someValuesFrom rdfs:Literal ],
        npdv:Area .

npdv:CompanyReserve a owl:Class ;
    sql:columns "cmpDateOffResEstDisplay,cmpLongName,cmpNpdidCompany,cmpRecoverableCondensate,cmpRecoverableGas,cmpRecoverableNGL,cmpRecoverableOE,cmpRecoverableOil,cmpRemainingCondensate,cmpRemainingGas,cmpRemainingNGL,cmpRemainingOE,cmpRemainingOil,cmpShare,dateSyncNPD,fldName,fldNpdidField (table: company_reserves)" ;
    sql:label "Company: Reserves (table: company_reserves)" ;
    sql:table "company_reserves" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty npdv:remainingOil ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:dateResourceEstimate ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:reservesForCompany ;
            owl:someValuesFrom npdv:Company ],
        [ a owl:Restriction ;
            owl:onProperty npdv:recoverableGas ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:recoverableOilEquivalents ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:remainingCondensate ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:dateSyncNPD ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:remainingGas ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:remainingOilEquivalents ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:recoverableCondensate ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:reservesForField ;
            owl:someValuesFrom npdv:Field ],
        [ a owl:Restriction ;
            owl:onProperty npdv:recoverableNGL ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:recoverableOil ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:companyShare ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:remainingNGL ;
            owl:someValuesFrom rdfs:Literal ],
        npdv:Reserve .

npdv:DSTBottomHolePressure a owl:DatatypeProperty ;
    sql:column "wellbore_dst.wlbDstBottomHolePress" ;
    sql:comment "The downhole pressure opposite a formation of interest when the valves at the surface (or downhole) are completely closed. The pressure is transmitted by fluids which exist in a formation and are in communication with the wellbore. (column: wlbDstBottomHolePress)" ;
    sql:datatype "DECIMAL(13,6) (column: wlbDstBottomHolePress)" ;
    sql:label "Bottom hole pressure [MPa] (column: wlbDstBottomHolePress)" ;
    rdfs:domain npdv:WellboreDrillStemTest ;
    rdfs:range xsd:decimal .

npdv:DSTChokeSize a owl:DatatypeProperty ;
    sql:column "wellbore_dst.wlbDstChokeSize" ;
    sql:comment "The choke is a type of orifice installed in a well flow line for the purpose of restricting the flow and controlling the rate of production. During testing of a well, the flow will often be measured through a series of different choke diameters. (column: wlbDstChokeSize)" ;
    sql:datatype "DECIMAL(13,6) (column: wlbDstChokeSize)" ;
    sql:label "Choke size [mm] (column: wlbDstChokeSize)" ;
    rdfs:domain npdv:WellboreDrillStemTest ;
    rdfs:range xsd:decimal .

npdv:DSTDepthFrom a owl:DatatypeProperty ;
    sql:column "wellbore_dst.wlbDstFromDepth" ;
    sql:comment "Top depth of the zone that is opened up for flow, measured depth. (column: wlbDstFromDepth)" ;
    sql:datatype "DECIMAL(13,6) (column: wlbDstFromDepth)" ;
    sql:label "From depth MD [m] (column: wlbDstFromDepth)" ;
    rdfs:domain npdv:WellboreDrillStemTest ;
    rdfs:range xsd:decimal .

npdv:DSTDepthTo a owl:DatatypeProperty ;
    sql:column "wellbore_dst.wlbDstToDepth" ;
    sql:comment "Bottom depth of the zone that is opened up for flow, measured depth. (column: wlbDstToDepth)" ;
    sql:datatype "DECIMAL(13,6) (column: wlbDstToDepth)" ;
    sql:label "To depth MD [m] (column: wlbDstToDepth)" ;
    rdfs:domain npdv:WellboreDrillStemTest ;
    rdfs:range xsd:decimal .

npdv:DSTFinalFlowPressure a owl:DatatypeProperty ;
    sql:column "wellbore_dst.wlbDstFinFlowPress" ;
    sql:comment "The pressure determined at the formation face just prior to shut-in for a build-up test. (column: wlbDstFinFlowPress)" ;
    sql:datatype "DECIMAL(13,6) (column: wlbDstFinFlowPress)" ;
    sql:label "Final flow pressure [MPa] (column: wlbDstFinFlowPress)" ;
    rdfs:domain npdv:WellboreDrillStemTest ;
    rdfs:range xsd:decimal .

npdv:DSTFinalShutInPressure a owl:DatatypeProperty ;
    sql:column "wellbore_dst.wlbDstFinShutInPress" ;
    sql:comment "Pressure as recorded at the wellhead when the valve is closed and the well is shut-in in the final build-up period. (column: wlbDstFinShutInPress)" ;
    sql:datatype "DECIMAL(13,6) (column: wlbDstFinShutInPress)" ;
    sql:label "Final shut-in pressure [MPa] (column: wlbDstFinShutInPress)" ;
    rdfs:domain npdv:WellboreDrillStemTest ;
    rdfs:range xsd:decimal .

npdv:DSTForWellbore a owl:ObjectProperty ;
    sql:construction "Foreign key wellbore_dst.wlbNpdidWellbore => wellbore_npdid_overview.wlbNpdidWellbore" ;
    rdfs:domain npdv:WellboreDrillStemTest ;
    rdfs:range npdv:Wellbore .

npdv:DSTGasDensity a owl:DatatypeProperty ;
    sql:column "wellbore_dst.wlbDstGasDensity" ;
    sql:comment "Gas gravity relative to air. Air gravity is by definition = 1.0. (column: wlbDstGasDensity)" ;
    sql:datatype "DECIMAL(13,6) (column: wlbDstGasDensity)" ;
    sql:label "Gas grav. rel.air (column: wlbDstGasDensity)" ;
    rdfs:domain npdv:WellboreDrillStemTest ;
    rdfs:range xsd:decimal .

npdv:DSTGasOilRelation a owl:DatatypeProperty ;
    sql:column "wellbore_dst.wlbDstGasOilRelation" ;
    sql:comment "Gas to oil ratio. (column: wlbDstGasOilRelation)" ;
    sql:datatype "INTEGER (column: wlbDstGasOilRelation)" ;
    sql:label "GOR [m3/m3] (column: wlbDstGasOilRelation)" ;
    rdfs:domain npdv:WellboreDrillStemTest ;
    rdfs:range xsd:integer .

npdv:DSTGasProducedRate a owl:DatatypeProperty ;
    sql:column "wellbore_dst.wlbDstGasProd" ;
    sql:comment "The rate of gas produced from the formation. (column: wlbDstGasProd)" ;
    sql:datatype "INTEGER (column: wlbDstGasProd)" ;
    sql:label "Gas [Sm3/day] (column: wlbDstGasProd)" ;
    rdfs:domain npdv:WellboreDrillStemTest ;
    rdfs:range xsd:integer .

npdv:DSTOilDensity a owl:DatatypeProperty ;
    sql:column "wellbore_dst.wlbDstOilDensity" ;
    sql:comment "Oil density. (column: wlbDstOilDensity)" ;
    sql:datatype "DECIMAL(13,6) (column: wlbDstOilDensity)" ;
    sql:label "Oil density [g/cm3] (column: wlbDstOilDensity)" ;
    rdfs:domain npdv:WellboreDrillStemTest ;
    rdfs:range xsd:decimal .

npdv:DSTOilProducedRate a owl:DatatypeProperty ;
    sql:column "wellbore_dst.wlbDstOilProd" ;
    sql:comment "The rate of oil produced from the formation. (column: wlbDstOilProd)" ;
    sql:datatype "INTEGER (column: wlbDstOilProd)" ;
    sql:label "Oil [Sm3/day] (column: wlbDstOilProd)" ;
    rdfs:domain npdv:WellboreDrillStemTest ;
    rdfs:range xsd:integer .

npdv:DSTTestNo a owl:DatatypeProperty ;
    sql:column "wellbore_dst.wlbDstTestNumber" ;
    sql:comment "Usually assiciated with a specific test interval, but may also represent tests under different conditions from the same interval. (column: wlbDstTestNumber)" ;
    sql:datatype "DECIMAL(13,6) (column: wlbDstTestNumber)" ;
    sql:label "Test number (column: wlbDstTestNumber)" ;
    rdfs:domain npdv:WellboreDrillStemTest ;
    rdfs:range xsd:decimal .

npdv:DiscoveryWellbore a owl:Class ;
    rdfs:isDefinedBy "http://sws.ifi.uio.no/vocab/version/20130919/npd-well" ;
    rdfs:subClassOf npdv:Wellbore .

npdv:FacilityPoint a owl:Class ;
    sql:columns "fclBelongsToKind,fclBelongsToName,fclBelongsToS,fclCurrentOperatorName,fclDesignLifetime,fclFactMapUrl,fclFactPageUrl,fclFunctions,fclKind,fclName,fclNpdidFacility,fclPointGeometryWKT,fclStartupDate,fclSurface,fclWaterDepth (table: fclPoint)" ;
    sql:label "Fixed facilities, floating production facilities and main facilities onshore. (table: fclPoint)" ;
    sql:table "fclPoint" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty geo:asWKT ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:belongsToFacility ;
            owl:someValuesFrom ptl:TUFacility ],
        [ a owl:Restriction ;
            owl:onProperty npdv:isGeometryOfFeature ;
            owl:someValuesFrom npdv:FixedFacility ],
        npdv:Point .

npdv:FieldOwner a owl:Class ;
    sql:columns "dateSyncNPD,fldName,fldNpdidField,fldNpdidOwner,fldOwnerDateUpdated,fldOwnerKind,fldOwnerName,fldOwnershipFromDate,fldOwnershipToDate (table: field_owner_hst)" ;
    sql:label "Field: Owners (table: field_owner_hst)" ;
    sql:table "field_owner_hst" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty npdv:ownerForField ;
            owl:someValuesFrom npdv:Field ],
        [ a owl:Restriction ;
            owl:onProperty npdv:dateSyncNPD ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:dateFieldOwnerFrom ;
            owl:someValuesFrom rdfs:Literal ],
        npdv:Owner .

npdv:Formation a owl:Class ;
    rdfs:subClassOf npdv:LithostratigraphicUnit .

npdv:Group a owl:Class ;
    rdfs:subClassOf npdv:LithostratigraphicUnit .

npdv:LOTForWellbore a owl:ObjectProperty ;
    sql:construction "Foreign key wellbore_casing_and_lot.wlbNpdidWellbore => wellbore_npdid_overview.wlbNpdidWellbore" ;
    rdfs:domain npdv:WellboreCasingAndLeakoffTest ;
    rdfs:range npdv:Wellbore .

npdv:LOTMudDensity a owl:DatatypeProperty ;
    sql:column "wellbore_casing_and_lot.wlbLotMudDencity" ;
    sql:comment "A leak-off test (LOT) measures the formation's integrity by increasing the mud load to the point where the mud starts to leak into the formation. (column: wlbLotMudDencity)" ;
    sql:datatype "DECIMAL(13,6) (column: wlbLotMudDencity)" ;
    sql:label "LOT mud eqv. [g/cm3] (column: wlbLotMudDencity)" ;
    rdfs:domain npdv:WellboreCasingAndLeakoffTest ;
    rdfs:range xsd:decimal .

npdv:MainArea a owl:Class ;
    sql:columns "apaAreaGeometryEWKT,apaAreaGeometry_KML_WGS84,apaMap_no (table: apaAreaGross)" ;
    sql:label "Updated APA (Awards in predefined areas) gross areas. (table: apaAreaGross)" ;
    sql:table "apaAreaGross" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty npdv:mapNo ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty geo:asWKT ;
            owl:someValuesFrom rdfs:Literal ],
        npdv:Area .

npdv:Member a owl:Class ;
    rdfs:subClassOf npdv:LithostratigraphicUnit .

npdv:Oil a owl:Class ;
    npdv:definition "Collective term for crude oil and other liquid petroleum products.  Source: http://www.npd.no/en/About-us/Information-services/Dictionary/" ;
    rdfs:isDefinedBy "http://sws.ifi.uio.no/vocab/version/20130919/npd-prod" ;
    rdfs:subClassOf npdv:Petroleum .

npdv:Quadrant a owl:Class ;
    sql:table "wellbore_development_all (ex)",
        "wellbore_exploration_all (ex)",
        "wellbore_shallow_all (ex)" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty npdv:dateSyncNPD ;
            owl:someValuesFrom rdfs:Literal ],
        npdv:Area .

npdv:Sidetrack a owl:Class ;
    rdfs:isDefinedBy "http://sws.ifi.uio.no/vocab/version/20130919/npd-well" ;
    rdfs:subClassOf <http://www.ifomis.org/bfo/1.1/snap#Continuant> .

npdv:SurveyArea a owl:Class ;
    sql:columns "sea3DKm2,seaBoatTotalKm,seaCdpTotalKm,seaCompanyReported,seaDateFinalized,seaDateStarting,seaFactMapUrl,seaFactPageUrl,seaGeographicalArea,seaMarketAvailable,seaNpdidSurvey,seaPlanBoatKm,seaPlanCdpKm,seaPlanFromDate,seaPlanToDate,seaPolyGeometryWKT,seaPolygonKind,seaSensorLength,seaSensorNumbers,seaSensorType,seaSourceNumber,seaSourcePressure,seaSourceSize,seaSourceType,seaStatus,seaSurveyName,seaSurveyTypeMain,seaSurveyTypePart (table: seaArea)" ;
    sql:label "Areas with planned survey after 1.1. 2009. The dataset contains both gross (included turn area for the boat) and net (acquisition area) for seismic, electromagnetic, site and basement surveys. (table: seaArea)" ;
    sql:table "seaArea" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty npdv:isTurnAreaIncluded ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:isGeometryOfFeature ;
            owl:someValuesFrom npdv:SeismicSurvey ],
        [ a owl:Restriction ;
            owl:onProperty npdv:isMarketAvailable ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty geo:asWKT ;
            owl:someValuesFrom rdfs:Literal ],
        npdv:Area .

npdv:TUFOwnerShare a owl:DatatypeProperty ;
    sql:column "tuf_owner_hst.tufOwnerShare" ;
    sql:comment "The company's share in percent. (column: tufOwnerShare)" ;
    sql:datatype "DECIMAL(13,6) (column: tufOwnerShare)" ;
    sql:label "Share [%] (column: tufOwnerShare)" ;
    rdfs:domain npdv:TUFOwner ;
    rdfs:range xsd:decimal .

npdv:WellboreCoordinate a owl:Class ;
    sql:columns "dateSyncNPD,wlbCompletionDate,wlbContent,wlbDrillingOperator,wlbEntryDate,wlbEwCode,wlbEwDeg,wlbEwDesDeg,wlbEwMin,wlbEwSec,wlbEwUtm,wlbField,wlbGeodeticDatum,wlbMainArea,wlbNpdidWellbore,wlbNsCode,wlbNsDecDeg,wlbNsDeg,wlbNsMin,wlbNsSec,wlbNsUtm,wlbProductionLicence,wlbPurposePlanned,wlbUtmZone,wlbWellType,wlbWellboreName (table: wellbore_coordinates)" ;
    sql:label "Wellbore: Coordinates (table: wellbore_coordinates)" ;
    sql:table "wellbore_coordinates" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty npdv:degreesEW ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:decimalDegreesNS ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:secondsEW ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:coordinateForWellbore ;
            owl:someValuesFrom npdv:Wellbore ],
        [ a owl:Restriction ;
            owl:onProperty npdv:dateSyncNPD ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:secondsNS ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:minutesEW ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:decimalDegreesEW ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:utmZone ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:utmEW ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:mainAreaLocation ;
            owl:someValuesFrom owl:Thing ],
        [ a owl:Restriction ;
            owl:onProperty npdv:minutesNS ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:utmNS ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:degreesNS ;
            owl:someValuesFrom rdfs:Literal ],
        npdv:Point .

