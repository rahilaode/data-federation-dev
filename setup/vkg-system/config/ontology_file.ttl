<http://sws.ifi.uio.no/vocab/npd-v2> a owl:Ontology .

npdv:AbandonedWell a owl:Class ;
    npdv:definition "A well permanently plugged in the drilling phase for technical reasons.  Source: http://www.npd.no/en/About-us/Information-services/Dictionary/" ;
    rdfs:isDefinedBy "http://sws.ifi.uio.no/vocab/version/20130919/npd-well" ;
    rdfs:subClassOf npdv:Well .

npdv:AppraisalWell a owl:Class ;
    npdv:definition "An exploration well drilled to determine the extent and size of a petroleum deposit that has already been discovered by a wildcat well.  Source: http://www.npd.no/en/About-us/Information-services/Dictionary/ " ;
    rdfs:isDefinedBy "http://sws.ifi.uio.no/vocab/version/20130919/npd-well" ;
    rdfs:subClassOf npdv:ExplorationWell .

npdv:AppraisalWellbore a owl:Class ;
    rdfs:subClassOf npdv:Wellbore .

npdv:AreaFee a owl:Class ;
    npdv:definition "An annual fee which the licensees on the Norwegian shelf pay the Government for each square kilometre of the acreage covered by a production licence. The fee is demanded pursuant to the provisions in §4-9, paragraph 2 of the Petroleum Act.   Source: http://www.npd.no/en/About-us/Information-services/Dictionary/" ;
    rdfs:isDefinedBy "http://sws.ifi.uio.no/vocab/version/20130919/npd-org" ;
    rdfs:subClassOf <http://www.ifomis.org/bfo/1.1/snap#Continuant> .

npdv:AssociatedGas a owl:Class ;
    npdv:definition "Natural gas dissolved in oil.  Source: http://www.npd.no/en/About-us/Information-services/Dictionary/" ;
    rdfs:isDefinedBy "http://sws.ifi.uio.no/vocab/version/20130919/npd-prod" ;
    rdfs:subClassOf npdv:Gas .

npdv:Award a owl:Class ;
    npdv:definition "Companies that are approved as operators or licensees on the Norwegian shelf may apply to be awarded production licences. The awards take place through licensing rounds and annual allocations in predefined areas. The authorities decide which areas of the Norwegian shelf are to be opened for petroleum activity and which companies are to be awarded production licences.  Source: http://www.npd.no/en/About-us/Information-services/Dictionary/" ;
    rdfs:isDefinedBy "http://sws.ifi.uio.no/vocab/version/20130919/npd-org" ;
    rdfs:subClassOf <http://www.ifomis.org/bfo/1.1/snap#Continuant> .

npdv:BlowOut a owl:Class ;
    npdv:definition "Sudden, powerful, uncontrolled discharge of gas, oil, drilling mud and water from a well.  Source: http://www.npd.no/en/About-us/Information-services/Dictionary/" ;
    rdfs:isDefinedBy "http://sws.ifi.uio.no/vocab/version/20130919/npd-well" ;
    rdfs:subClassOf <http://www.ifomis.org/bfo/1.1/span#TemporalInstant> .

npdv:BlowoutWellbore a owl:Class ;
    rdfs:subClassOf npdv:Wellbore .

npdv:ChangeOfCompanyNameTransfer a owl:Class ;
    rdfs:subClassOf npdv:Transfer .

npdv:CommercialDiscovery a owl:Class ;
    rdfs:isDefinedBy "http://sws.ifi.uio.no/vocab/version/20130919/npd-prod" ;
    rdfs:subClassOf npdv:Discovery .

npdv:CompressedNaturalGas a owl:Class ;
    npdv:definition "CNG (Compressed Natural Gas): Natural gas under pressure in tanks.   Source: http://www.npd.no/en/About-us/Information-services/Dictionary/" ;
    rdfs:isDefinedBy "http://sws.ifi.uio.no/vocab/version/20130919/npd-prod" ;
    rdfs:subClassOf npdv:Gas .

npdv:ConcreteStructureFacility a owl:Class ;
    rdfs:subClassOf npdv:Facility .

npdv:Condeep3ShaftsFacility a owl:Class ;
    rdfs:subClassOf npdv:Facility .

npdv:Condeep4ShaftsFacility a owl:Class ;
    rdfs:subClassOf npdv:Facility .

npdv:CondeepMonoshaftFacility a owl:Class ;
    rdfs:subClassOf npdv:Facility .

npdv:Condensate a owl:Class ;
    npdv:definition "A mixture of the heaviest components of natural gas. Condensate is fluid at normal pressure and temperature.  Source: http://www.npd.no/en/About-us/Information-services/Dictionary/" ;
    rdfs:isDefinedBy "http://sws.ifi.uio.no/vocab/version/20130919/npd-prod" ;
    rdfs:subClassOf npdv:Gas .

npdv:CondensatePipeline a owl:Class ;
    rdfs:subClassOf npdv:Pipeline .

npdv:ContingentResources a owl:Class ;
    npdv:definition "Recoverable petroleum volumes that have been discovered, but for which no decision has been taken, or permission given, to recover.  Source: http://www.npd.no/en/About-us/Information-services/Dictionary/" ;
    rdfs:isDefinedBy "http://sws.ifi.uio.no/vocab/version/20130919/npd-prod" ;
    rdfs:subClassOf <http://www.ifomis.org/bfo/1.1/snap#MaterialEntity> .

npdv:CrudeOil a owl:Class ;
    npdv:definition "Liquid petroleum from the reservoir. Most of the water and dissolved natural gas have been removed.  Source: http://www.npd.no/en/About-us/Information-services/Dictionary/" ;
    rdfs:isDefinedBy "http://sws.ifi.uio.no/vocab/version/20130919/npd-prod" ;
    rdfs:subClassOf npdv:Oil .

npdv:DiscoveryArea a owl:Class ;
    sql:columns "dscCurrentActivityStatus,dscFactUrl,dscHcType,dscIncludedInFld,dscName,dscNpdidDiscovery,dscNpdidResInclInDiscovery,dscResInclInDiscoveryName,fldCurrentActivityStatus,fldFactUrl,fldHcType,fldName,fldNpdidField,flddscAreaGeometryWKT_ED50,flddscLabel (table: dscArea)" ;
    sql:label "Discovery outlines - including field outlines. (table: dscArea)" ;
    sql:table "dscArea" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty geo:asWKT ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:isGeometryOfFeature ;
            owl:someValuesFrom npdv:Discovery ],
        [ a owl:Restriction ;
            owl:onProperty npdv:resourcesIncludedInDiscovery ;
            owl:someValuesFrom npdv:Discovery ],
        npdv:Area .

npdv:DorisFacility a owl:Class ;
    rdfs:subClassOf npdv:Facility .

npdv:DryGas a owl:Class ;
    npdv:definition "Almost pure methane gas, lacking water and with few heavy components.  Source: http://www.npd.no/en/About-us/Information-services/Dictionary/" ;
    rdfs:isDefinedBy "http://sws.ifi.uio.no/vocab/version/20130919/npd-prod" ;
    rdfs:subClassOf npdv:Gas .

npdv:ElectromagneticSurvey a owl:Class ;
    rdfs:subClassOf npdv:Survey .

npdv:FPSOFacility a owl:Class ;
    rdfs:subClassOf npdv:Facility .

npdv:FSUFacility a owl:Class ;
    rdfs:subClassOf npdv:Facility .

npdv:FeederPipeline a owl:Class ;
    rdfs:subClassOf npdv:Pipeline .

npdv:FieldArea a owl:Class ;
    sql:columns "dscCurrentActivityStatus,dscFactUrl,dscHcType,dscIncludedInFld,dscName,dscNpdidDiscovery,dscNpdidResInclInDiscovery,dscResInclInDiscoveryName,fldCurrentActivityStatus,fldFactUrl,fldHcType,fldName,fldNpdidField,flddscAreaGeometryWKT_ED50,flddscLabel (table: fldArea)" ;
    sql:label "Field outlines. (table: fldArea)" ;
    sql:table "fldArea" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty geo:asWKT ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:resourcesIncludedInDiscovery ;
            owl:someValuesFrom npdv:Discovery ],
        [ a owl:Restriction ;
            owl:onProperty npdv:isGeometryOfFeature ;
            owl:someValuesFrom npdv:Field ],
        [ a owl:Restriction ;
            owl:onProperty npdv:isGeometryOfFeature ;
            owl:someValuesFrom npdv:Discovery ],
        npdv:Area .

npdv:FieldMonthlyProduction a owl:Class ;
    sql:columns "prfInformationCarrier,prfMonth,prfNpdidInformationCarrier,prfPrdCondensateNetMillSm3,prfPrdGasNetBillSm3,prfPrdNGLNetMillSm3,prfPrdOeNetMillSm3,prfPrdOilNetMillSm3,prfPrdProducedWaterInFieldMillSm3,prfYear (table: field_production_monthly)" ;
    sql:label "Field: Production, monthly by field (table: field_production_monthly)" ;
    sql:table "field_production_monthly" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty npdv:producedCondensate ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:productionYear ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:producedNGL ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:producedOilEquivalents ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:producedWater ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:producedGas ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:productionMonth ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:producedOil ;
            owl:someValuesFrom rdfs:Literal ],
        <http://www.ifomis.org/bfo/1.1/span#ProcessualEntity> .

npdv:FieldReserve a owl:Class ;
    sql:columns "dateSyncNPD,fldDateOffResEstDisplay,fldName,fldNpdidField,fldRecoverableCondensate,fldRecoverableGas,fldRecoverableNGL,fldRecoverableOE,fldRecoverableOil,fldRemainingCondensate,fldRemainingGas,fldRemainingNGL,fldRemainingOE,fldRemainingOil (table: field_reserves)" ;
    sql:label "Field: Reserves (table: field_reserves)" ;
    sql:table "field_reserves" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty npdv:remainingGas ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:remainingCondensate ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:remainingOilEquivalents ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:remainingOil ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:recoverableOil ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:recoverableOilEquivalents ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:recoverableGas ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:remainingNGL ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:recoverableCondensate ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:dateResourceEstimate ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:dateSyncNPD ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:recoverableNGL ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:reservesForField ;
            owl:someValuesFrom npdv:Field ],
        [ a owl:Restriction ;
            owl:onProperty npdv:idNPD ;
            owl:someValuesFrom rdfs:Literal ],
        npdv:Reserve .

npdv:FieldYearlyProduction a owl:Class ;
    sql:columns "prfInformationCarrier,prfNpdidInformationCarrier,prfPrdCondensateNetMillSm3,prfPrdGasNetBillSm3,prfPrdNGLNetMillSm3,prfPrdOeNetMillSm3,prfPrdOilNetMillSm3,prfPrdProducedWaterInFieldMillSm3,prfYear (table: field_production_yearly)" ;
    sql:label "Field: Production, yearly by field (table: field_production_yearly)" ;
    sql:table "field_production_yearly" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty npdv:producedCondensate ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:producedOilEquivalents ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:producedWater ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:productionYear ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:producedOil ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:producedGas ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:producedNGL ;
            owl:someValuesFrom rdfs:Literal ],
        <http://www.ifomis.org/bfo/1.1/span#ProcessualEntity> .

npdv:GasPipeline a owl:Class ;
    rdfs:subClassOf npdv:Pipeline .

npdv:GroundSurvey a owl:Class ;
    rdfs:subClassOf npdv:Survey .

npdv:InitialWellbore a owl:Class ;
    npdv:definition "The first wellbore of a well?" ;
    rdfs:isDefinedBy "http://sws.ifi.uio.no/vocab/version/20130919/npd-well" ;
    rdfs:subClassOf npdv:Wellbore .

npdv:InjectionWell a owl:Class ;
    npdv:definition "A development well or test development well used for injection of gas, water or other medium.  Source: http://www.npd.no/en/Topics/Wells/Temaartikler/Well-definitions/" ;
    rdfs:isDefinedBy "http://sws.ifi.uio.no/vocab/version/20130919/npd-well" ;
    rdfs:subClassOf npdv:RecoveryWell .

npdv:InjectionWellbore a owl:Class ;
    rdfs:subClassOf npdv:Wellbore .

