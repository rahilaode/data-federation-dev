npdv:coreNo a owl:DatatypeProperty ;
    sql:column "wellbore_core.wlbCoreNumber",
        "wellbore_core_photo.wlbCoreNumber" ;
    sql:comment "Sequence number of the core sample in the wellbore. (column: wlbCoreNumber)" ;
    sql:datatype "INTEGER (column: wlbCoreNumber)" ;
    sql:label "Core sample number (column: wlbCoreNumber)" ;
    rdfs:range xsd:integer .

npdv:coresTotalLength a owl:DatatypeProperty ;
    sql:column "strat_litho_wellbore_core.lsuCoreLenght",
        "wellbore_core.wlbTotalCoreLength" ;
    sql:comment "Ca. number of metres with core sample in the lithostratigraphic unit. Core-depth-shifts are not accounted for. (column: lsuCoreLenght)" ;
    sql:datatype "DECIMAL(13,6)",
        "DECIMAL(13,6) (column: lsuCoreLenght)" ;
    sql:label "Core length [m] (column: lsuCoreLenght)" ;
    rdfs:range xsd:decimal .

npdv:country a owl:ObjectProperty ;
    sql:column "bsns_arr_area_area_poly_hst.baaAreaPolyNationCode2",
        "licence_area_poly_hst.prlAreaPolyNationCode" ;
    sql:comment "2 letter nation code (ISO) for the nation the polygon belongs to (column: baaAreaPolyNationCode2)" ;
    sql:datatype "VARCHAR(2) (column: baaAreaPolyNationCode2)",
        "VARCHAR(2) (column: prlAreaPolyNationCode)" ;
    sql:label "Nation code (column: baaAreaPolyNationCode2)" .

npdv:currentStatus a owl:DatatypeProperty ;
    sql:column "licence.prlPhaseCurrent",
        "pipLine.pipCurrentPhase",
        "seis_acquisition.seaStatus" ;
    sql:comment "Current phase for the production licence. Examples of legal values: INITIAL; INITIAL EXTENDED; PRODUCTION; PRODUCTION EXTENDED. (column: prlPhaseCurrent)",
        "Status for the seismic acquistion . Example of legal values: 'Høring', 'Planlagt', 'Pågående', 'Pause','Ferdig'. (column: seaStatus)" ;
    sql:datatype "VARCHAR(100) (column: seaStatus)",
        "VARCHAR(40) (column: pipCurrentPhase)",
        "VARCHAR(40) (column: prlPhaseCurrent)" ;
    sql:label "Phase - current (column: prlPhaseCurrent)",
        "Status (column: seaStatus)" ;
    rdfs:range xsd:string .

