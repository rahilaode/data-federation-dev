npdv:LithostratigraphicUnit a owl:Class ;
    sql:label "Wellbore: Lithostratigraphy (extra table: wellbore_formation_top)" ;
    sql:table "wellbore_formation_top (ex)" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty npdv:stratigraphicParent ;
            owl:someValuesFrom owl:Thing ],
        [ a owl:Restriction ;
            owl:onProperty npdv:stratigraphicLevel ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:geochronologicEra ;
            owl:someValuesFrom owl:Thing ],
        [ a owl:Restriction ;
            owl:onProperty npdv:dateSyncNPD ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:dateUpdated ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:idNPD ;
            owl:someValuesFrom rdfs:Literal ],
        <http://www.ifomis.org/bfo/1.1/snap#Site> .

npdv:Survey a owl:Class ;
    rdfs:subClassOf <http://www.ifomis.org/bfo/1.1/span#Occurrent> .

npdv:Transfer a owl:Class ;
    rdfs:isDefinedBy "http://sws.ifi.uio.no/vocab/version/20130919/npd-org" ;
    rdfs:subClassOf npdv:Transfer,
        <http://www.ifomis.org/bfo/1.1/span#ProcessualEntity> .

npdv:WellboreDocument a owl:Class ;
    sql:columns "dateSyncNPD,wlbDocumentDateUpdated,wlbDocumentFormat,wlbDocumentName,wlbDocumentSize,wlbDocumentType,wlbDocumentUrl,wlbName,wlbNpdidWellbore (table: wellbore_document)" ;
    sql:label "Wellbore: Documents (table: wellbore_document)" ;
    sql:table "wellbore_document" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty npdv:documentFormat ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:documentForWellbore ;
            owl:someValuesFrom npdv:Wellbore ],
        [ a owl:Restriction ;
            owl:onProperty npdv:documentURL ;
            owl:someValuesFrom owl:Thing ],
        [ a owl:Restriction ;
            owl:onProperty npdv:documentName ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:dateSyncNPD ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:documentSize ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:documentType ;
            owl:someValuesFrom rdfs:Literal ],
        <http://www.ifomis.org/bfo/1.1/snap#Continuant> .

npdv:status a owl:DatatypeProperty ;
    sql:column "discovery.dscCurrentActivityStatus",
        "facility_fixed.fclPhase",
        "field.fldCurrentActivitySatus",
        "field_activity_status_hst.fldStatus",
        "licence_phase_hst.prlPhase",
        "licence_task.prlTaskStatusEn",
        "licence_task.prlTaskStatusNo",
        "wellbore_exploration_all.wlbStatus" ;
    sql:comment "Current activity status of the discovery. Example of legal values: SHUT DOWN, PRODUCING, PDO APPROVED, DECIDED BY THE LICENSEES, PLANNING PHASE, DEV. LIKELY BUT NOT CLARIFIED, DEVELOPMENT NOT VERY LIKELY, NEW DISCOVERIES, INCLUDED IN OTHER DISCOVERY (column: dscCurrentActivityStatus)",
        "Current activity status of the field. Example of legal values: SHUT DOWN, PRODUCING, PDO APPROVED (column: fldCurrentActivitySatus)",
        "Current phase for the facility. Example of legal values: ABANDONED IN PLACE, DECOMMISSIONED, FABRICATION, FUTURE, IN SERVICE, INSTALLATION, LAID UP, REMOVED (column: fclPhase)",
        "Field activity status. Examples of legal values: PDO APPROVED, PRODUCING, SHUT DOWN (column: fldStatus)",
        "Phase. Example of legal values: INITIAL, INITIAL EXTENDED, PRODUCTION, PRODUCTION EXTENDED (column: prlPhase)",
        "Present wellbore status. Legal values: P&A (plugged and abandoned), RE-CLASS TO DEV (reclassified to development well), JUNKED (abandoned due to technical problems), SUSPENDED (temporarily abandoned), SUSP.REENTERED LATER (completed before planned depth (TD) , will be re-entered later). (column: wlbStatus)",
        "Task status. Example of legal values: Approved; Dropped; Not to be drilled, Will be drilled. (column: prlTaskStatusEn)" ;
    sql:datatype "VARCHAR(100) (column: prlTaskStatusNo)",
        "VARCHAR(40) (column: dscCurrentActivityStatus)",
        "VARCHAR(40) (column: fclPhase)",
        "VARCHAR(40) (column: fldCurrentActivitySatus)",
        "VARCHAR(40) (column: fldStatus)",
        "VARCHAR(40) (column: prlPhase)",
        "VARCHAR(40) (column: prlTaskStatusEn)",
        "VARCHAR(40) (column: wlbStatus)" ;
    sql:label "Current activity status (column: dscCurrentActivityStatus)",
        "Current activity status (column: fldCurrentActivitySatus)",
        "Phase (column: fclPhase)",
        "Phase (column: prlPhase)",
        "Status (column: fldStatus)",
        "Status (column: wlbStatus)",
        "Task status (column: prlTaskStatusEn)" ;
    rdfs:range xsd:string .

<http://www.ifomis.org/bfo/1.1/snap#SpatialRegion> a owl:Class ;
    rdfs:label "spatial_region"^^xsd:string ;
    rdfs:comment "Comment: All instances of continuant [snap:Continuant] are spatial entities, that is, they enter in the relation of (spatial) location with spatial region [snap:SpatialRegion] entities. As a particular case, the exact spatial location of a spatial region [snap:SpatialRegion] is this region itself."^^xsd:string,
        "Comment: An instance of spatial region [snap:SpatialRegion] is a part of space. All parts of space are spatial region [snap:SpatialRegion] entities and only spatial region [snap:SpatialRegion] entities are parts of space. Space is the entire extent of the spatial universe, a designated individual, which is thus itself a spatial region [snap:SpatialRegion]."^^xsd:string,
        "Comment: Space and spatial region [snap:SpatialRegion] entities are entities in their own rights which exist independently of any entities which can be located at them. This view of space is sometimes called \"absolutist\" or \"the container view\". In BFO, the class site [snap:Site] allows for a so-called relational view of space, that is to say, a view according to which spatiality is a matter of relative location between entities and not a matter of being tied to space. The bridge between these two views is secured through the fact that while instances of site [snap:Site] are not spatial region [snap:SpatialRegion] entities, they are nevertheless spatial entities."^^xsd:string,
        "Definition: A continuant [snap:Continuant] that is neither bearer of quality [snap:Quality] entities nor inheres in any other entities."^^xsd:string,
        "Examples: the sum total of all space in the universe, parts of the sum total of all space in the universe"^^xsd:string ;
    rdfs:subClassOf <http://www.ifomis.org/bfo/1.1/snap#Continuant> .

<http://www.opengis.net/ont/gml#AbstractGeometricPrimitive> a owl:Class ;
