npdv:isGeometryOfFeature a owl:ObjectProperty ;
    sql:construction "Foreign key baaArea.baaNpdidBsnsArrArea => bsns_arr_area.baaNpdidBsnsArrArea",
        "Foreign key bsns_arr_area_area_poly_hst.baaNpdidBsnsArrArea => bsns_arr_area.baaNpdidBsnsArrArea",
        "Foreign key dscArea.dscNpdidDiscovery => discovery.dscNpdidDiscovery",
        "Foreign key fclPoint.fclNpdidFacility => facility_fixed.fclNpdidFacility",
        "Foreign key fldArea.dscNpdidDiscovery => discovery.dscNpdidDiscovery",
        "Foreign key fldArea.fldNpdidField => field.fldNpdidField",
        "Foreign key licence_area_poly_hst.prlNpdidLicence => licence.prlNpdidLicence",
        "Foreign key prlArea.prlNpdidLicence => licence.prlNpdidLicence",
        "Foreign key prlAreaSplitByBlock.prlNpdidLicence => licence.prlNpdidLicence",
        "Foreign key seaArea.seaNpdidSurvey => seis_acquisition.seaNpdidSurvey",
        "Foreign key seaMultiline.seaSurveyName => seis_acquisition.seaName",
        "Foreign key wlbPoint.wlbNpdidWellbore => wellbore_npdid_overview.wlbNpdidWellbore" ;
    rdfs:comment "Note: There is no geos:hasFeature. This property is created for reasons of convenience." ;
    rdfs:isDefinedBy "http://sws.ifi.uio.no/vocab/version/20130919/npd-geometry" ;
    owl:inverseOf geo:hasGeometry .

ptl:TUFacility a owl:Class ;
    sql:columns "Textbox2,Textbox42,cmpLongName,cmpNpdidCompany,dateSyncNPD,ptlName,ptlOperDateUpdated,tufName,tufNpdidTuf (table: tuf_petreg_licence_oper)",
        "dateSyncNPD,ptlDateUpdated,ptlDateUpdatedMax,ptlDateValidFrom,ptlDateValidTo,ptlName,tufName,tufNpdidTuf (table: tuf_petreg_licence)" ;
    sql:label "Transportation and Utilization Facilities: Petroleum register (table: tuf_petreg_licence)",
        "Transportation and Utilization Facilities: Petroleum register, Operators (table: tuf_petreg_licence_oper)" ;
    sql:table "tuf_petreg_licence",
        "tuf_petreg_licence_oper" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ptl:TUFOperatorCompany ;
            owl:someValuesFrom npdv:Company ],
        [ a owl:Restriction ;
            owl:onProperty npdv:dateSyncNPD ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty ptl:dateUpdatedMax ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty ptl:dateLicenceValidFrom ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty ptl:dateLicenceValidTo ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:name ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:idNPD ;
            owl:someValuesFrom rdfs:Literal ],
        npdv:Facility .

