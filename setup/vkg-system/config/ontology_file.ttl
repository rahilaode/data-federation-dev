npdv:taskID a owl:DatatypeProperty ;
    sql:column "licence_task.prlTaskID" ;
    sql:comment "Unique identification of the task. (column: prlTaskID)" ;
    sql:datatype "INTEGER (column: prlTaskID)" ;
    sql:label "Task ID (column: prlTaskID)" ;
    rdfs:domain npdv:ProductionLicenceWorkObligation ;
    rdfs:range xsd:integer .

npdv:taskType a owl:DatatypeProperty ;
    sql:column "licence_task.prlTaskTypeEn",
        "licence_task.prlTaskTypeNo" ;
    sql:comment "Type of task. Examples of legal values:Relinquishment report;Seismic acquisition;Seismic reprocessing;EM acquisition;Status workobligations to MPE/NPD;Study of geology and geophysics;Seismology - collecting, reprocessing, interpretation;Decision to drill;Drilling;Decision to prepare a plan for development;Hand in plan for development;The expiry of initial period. (column: prlTaskTypeEn)" ;
    sql:datatype "VARCHAR(100) (column: prlTaskTypeNo)",
        "VARCHAR(200) (column: prlTaskTypeEn)" ;
    sql:label "Type of task (column: prlTaskTypeEn)" ;
    rdfs:domain npdv:ProductionLicenceWorkObligation ;
    rdfs:range xsd:string .

npdv:transferredBAA a owl:ObjectProperty ;
    sql:construction "Foreign key bsns_arr_area_transfer_hst.baaNpdidBsnsArrArea => bsns_arr_area.baaNpdidBsnsArrArea" ;
    rdfs:domain npdv:BAATransfer ;
    rdfs:range npdv:BAA .

