npdv:Discovery a owl:Class ;
    npdv:definition "A petroleum deposit, or several petroleum deposits combined, discovered in the same well, and which testing, sampling or logging have shown probably contain mobile petroleum. The definition covers both commercial and technical discoveries. The discovery receives the status of a field, or becomes part of an existing field when a Plan for Development and Operation (PDO) is approved by the authorities (see Field).  Source: http://www.npd.no/en/About-us/Information-services/Dictionary/" ;
    sql:columns "cmpLongName,dateSyncNPD,dscCurrentActivityStatus,dscDateFromInclInField,dscDateUpdated,dscDateUpdatedMax,dscDiscoveryYear,dscFactMapUrl,dscFactPageUrl,dscHcType,dscName,dscNpdidDiscovery,dscOwnerKind,dscOwnerName,dscResInclInDiscoveryName,fldName,fldNpdidField,nmaName,wlbName,wlbNpdidWellbore (table: discovery)" ;
    sql:comment "Discoveries on the Norwegian continental shelf. (table: discovery)" ;
    sql:label "Discovery (table: discovery)" ;
    sql:table "discovery" ;
    rdfs:isDefinedBy "http://sws.ifi.uio.no/vocab/version/20130919/npd-prod" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty npdv:dateSyncNPD ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:factMapURL ;
            owl:someValuesFrom owl:Thing ],
        [ a owl:Restriction ;
            owl:onProperty npdv:discoveryWellbore ;
            owl:someValuesFrom npdv:Wellbore ],
        [ a owl:Restriction ;
            owl:onProperty npdv:status ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:idNPD ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:includedInField ;
            owl:someValuesFrom npdv:Field ],
        [ a owl:Restriction ;
            owl:onProperty npdv:name ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:factPageURL ;
            owl:someValuesFrom owl:Thing ],
        [ a owl:Restriction ;
            owl:onProperty npdv:discoveryYear ;
            owl:someValuesFrom rdfs:Literal ],
        <http://www.ifomis.org/bfo/1.1/snap#Continuant> .

