        "wellbore_mud.wlbMudDateUpdated",
        "wellbore_oil_sample.wlbOilSampleDateUpdated",
        "wellbore_shallow_all.wlbDateUpdated" ;
    sql:comment "Date when information about this business agreement area was last updated or inserted for the first time.The date will only be changed if the data in the 'Main level' in the tab 'BAA' will be changed. (column: baaDateUpdated)",
        "Date when information about this discovery was last updated or inserted for the first time.The date will only be changed if the data in the 'Main level' in the tab 'Discovery' will be changed. (column: dscDateUpdated)",
        "Date when information about this facility was last updated or inserted for the first time. (column: fclDateUpdated)",
        "Date when information about this field was last updated or inserted for the first time.The date will only be changed if the data in the 'Main level' in the tab 'Field' will be changed. (column: fldDateUpdated)",
        "Date when information about this wellbore was last updated or inserted for the first time.The date will only be changed if the data in the 'Main level' in the tab 'Wellbore' will be changed. (column: wlbDateUpdated)",
        "Date when this production licences was last updated or inserted for the first time.The date will only be changed if the data in the 'Main level' in the tab 'Licence' will be changed. (column: prlDateUpdated)",
        "Date when this record was updated last or inserted the first time. (column: baaAreaPolyDateUpdated)",
        "Date when this record was updated last or inserted the first time. (column: baaLicenseeDateUpdated)",
        "Date when this record was updated last or inserted the first time. (column: baaOperatorDateUpdated)",
        "Date when this record was updated last or inserted the first time. (column: baaTransferDateUpdated)",
        "Date when this record was updated last or inserted the first time. (column: fldLicenseeDateUpdated)",
        "Date when this record was updated last or inserted the first time. (column: fldOperatorDateUpdated)",
        "Date when this record was updated last or inserted the first time. (column: fldOwnerDateUpdated)",
        "Date when this record was updated last or inserted the first time. (column: prlAreaDateUpdated)",
        "Date when this record was updated last or inserted the first time. (column: prlLicenseeDateUpdated)",
        "Date when this record was updated last or inserted the first time. (column: prlOperDateUpdated)",
        "Date when this record was updated last or inserted the first time. (column: prlPhaseDateUpdated)",
        "Date when this record was updated last or inserted the first time. (column: prlTaskDateUpdated)",
        "Date when this record was updated last or inserted the first time. (column: prlTransferDateUpdated)",
        "Date when this record was updated last or inserted the first time. (column: wlbCasingDateUpdated)",
        "Date when this record was updated last or inserted the first time. (column: wlbCoreDateUpdated)",
        "Date when this record was updated last or inserted the first time. (column: wlbCorePhotoDateUpdated)",
        "Date when this record was updated last or inserted the first time. (column: wlbDocumentDateUpdated)",
        "Date when this record was updated last or inserted the first time. (column: wlbDstDateUpdated)",
        "Date when this record was updated last or inserted the first time. (column: wlbMudDateUpdated)",
        "Date when this record was updated last or inserted the first time. (column: wlbOilSampleDateUpdated)" ;
    sql:datatype "DATETIME",
        "DATETIME (column: baaAreaPolyDateUpdated)",
        "DATETIME (column: baaDateUpdated)",
        "DATETIME (column: baaLicenseeDateUpdated)",
        "DATETIME (column: baaOperatorDateUpdated)",
        "DATETIME (column: baaTransferDateUpdated)",
