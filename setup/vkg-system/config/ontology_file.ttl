    rdfs:subClassOf npdv:Facility .

npdv:Jacket4LegsFacility a owl:Class ;
    rdfs:subClassOf npdv:Facility .

npdv:Jacket6LegsFacility a owl:Class ;
    rdfs:subClassOf npdv:Facility .

