        npdv:Facility .

npdv:TechnicalDiscovery a owl:Class ;
    rdfs:isDefinedBy "http://sws.ifi.uio.no/vocab/version/20130919/npd-prod" ;
    rdfs:subClassOf npdv:Discovery .

npdv:TechnicalSideTrack a owl:Class ;
    npdv:definition "Technical sidetracking: necessary drilling sideways (new well track) in order to bypass unforeseen obstacles in the well and where the geological and drilling operational well target remains unaltered.  Source: http://www.npd.no/en/Topics/Wells/Temaartikler/Well-definitions/" ;
    rdfs:isDefinedBy "http://sws.ifi.uio.no/vocab/version/20130919/npd-well" ;
    rdfs:subClassOf npdv:Sidetrack .

npdv:TerminationPlan a owl:Class ;
    npdv:definition "Plan to be presented to the authorities by the licensees before a production permit or a permit to install and operate installations for transport and utilisation of petroleum expires or is relinquished, or the use of an installation finally ceases. The plan must include proposals for continued production or shutdown of production and how installations are to be disposed of.  Source: http://www.npd.no/en/About-us/Information-services/Dictionary/" ;
    rdfs:isDefinedBy "http://sws.ifi.uio.no/vocab/version/20130919/npd-org" ;
    rdfs:subClassOf npdv:Plan .

npdv:TerminationPoint a owl:Class ;
    rdfs:isDefinedBy "http://sws.ifi.uio.no/vocab/version/20130919/npd-well" ;
    rdfs:subClassOf npdv:Point .

npdv:TestProductionWell a owl:Class ;
    rdfs:isDefinedBy "http://sws.ifi.uio.no/vocab/version/20130919/npd-well" ;
    rdfs:subClassOf npdv:DevelopmentWell .

npdv:TlpConcreteFacility a owl:Class ;
    rdfs:subClassOf npdv:Facility .

npdv:TlpSteelFacility a owl:Class ;
    rdfs:subClassOf npdv:Facility .

npdv:TransportationPipeline a owl:Class ;
    rdfs:subClassOf npdv:Pipeline .

npdv:UnitizedBAA a owl:Class ;
    rdfs:subClassOf npdv:BAA .

npdv:VesselFacility a owl:Class ;
    rdfs:subClassOf npdv:Facility .

npdv:WellHead a owl:Class ;
    rdfs:isDefinedBy "http://sws.ifi.uio.no/vocab/version/20130919/npd-well" ;
    rdfs:subClassOf <http://www.ifomis.org/bfo/1.1/snap#Continuant> .

npdv:WellTarget a owl:Class ;
    npdv:definition "Geological well target: that or those geological unit(s) into which the well is to be drilled, drilling operational well target: the termination point of the well path (includes geographical coordinates and depths in meters).  Source: http://www.npd.no/en/Topics/Wells/Temaartikler/Well-definitions/" ;
    rdfs:isDefinedBy "http://sws.ifi.uio.no/vocab/version/20130919/npd-well" ;
    rdfs:subClassOf <http://www.ifomis.org/bfo/1.1/snap#Continuant> .

npdv:WellTrack a owl:Class ;
    npdv:definition "The part of a wellbore (well path) which extends from a point of drilling out on the existing wellbore (kick-off point) to a new termination point for the well.  Source: http://www.npd.no/Global/Norsk/5-Regelverk/Tematiske-veiledninger/B_og_b_betegnelser_og_klassifisering.pdf" ;
    rdfs:isDefinedBy "http://sws.ifi.uio.no/vocab/version/20130919/npd-well" ;
    rdfs:subClassOf <http://www.ifomis.org/bfo/1.1/snap#Continuant> .

npdv:WellborePoint a owl:Class ;
    sql:columns "wlbCompletionDate,wlbContent,wlbDiscoveryWellbore,wlbDrillingFacility,wlbDrillingOperator,wlbEntryDate,wlbFactMapUrl,wlbFactPageUrl,wlbField,wlbMultilateral,wlbNpdidWellbore,wlbPointGeometryWKT,wlbProductionFacility,wlbProductionLicence,wlbPurpose,wlbStatus,wlbSymbol,wlbWaterDepth,wlbWellName,wlbWellType,wlbWellboreName (table: wlbPoint)" ;
    sql:label "Wellbores - exploration, development and shallow wellbores. (table: wlbPoint)" ;
    sql:table "wlbPoint" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty geo:asWKT ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:isGeometryOfFeature ;
            owl:someValuesFrom npdv:Wellbore ],
        npdv:Point .

npdv:WellboreStratigraphicCoreSet a owl:Class ;
    sql:columns "dateSyncNPD,lsuCoreLenght,lsuLevel,lsuName,lsuNpdidLithoStrat,wlbCompletionDate,wlbName,wlbNpdidWellbore (table: strat_litho_wellbore_core)" ;
    sql:comment "Lithostratigraphic units (groups, formations and members) on the Norwegian continental shelf. Wellbores with core samples. (table: strat_litho_wellbore_core)" ;
    sql:label "Stratigraphy: Cores (table: strat_litho_wellbore_core)" ;
    sql:table "strat_litho_wellbore_core" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty npdv:inLithostratigraphicUnit ;
            owl:someValuesFrom owl:Thing ],
        [ a owl:Restriction ;
            owl:onProperty npdv:coreForWellbore ;
            owl:someValuesFrom npdv:Wellbore ],
        [ a owl:Restriction ;
            owl:onProperty npdv:dateSyncNPD ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:coresTotalLength ;
            owl:someValuesFrom rdfs:Literal ],
        npdv:WellboreCoreSet .

npdv:WetGas a owl:Class ;
    npdv:definition "A mixture of gas mainly in liquid phase.   Source: http://www.npd.no/en/About-us/Information-services/Dictionary/" ;
    rdfs:isDefinedBy "http://sws.ifi.uio.no/vocab/version/20130919/npd-prod" ;
    rdfs:subClassOf npdv:Gas .

npdv:WildcatWell a owl:Class ;
    npdv:definition "An exploration well drilled to find out whether petroleum exists in a prospect.  Source: http://www.npd.no/en/About-us/Information-services/Dictionary/" ;
    rdfs:isDefinedBy "http://sws.ifi.uio.no/vocab/version/20130919/npd-well" ;
    rdfs:subClassOf npdv:ExplorationWell .

npdv:WildcatWellbore a owl:Class ;
    rdfs:subClassOf npdv:Wellbore .

npdv:areaSize3DKm2 a owl:DatatypeProperty ;
    sql:column "seaArea.sea3DKm2",
        "seis_acquisition.sea3DKm2" ;
    sql:comment "Planned net area - calculated by NPD map tool if 3D or 4D. (column: sea3DKm2)" ;
    sql:datatype "DECIMAL(13,6) (column: sea3DKm2)" ;
    sql:label "Total net area - planned 3D/4D [km2] (column: sea3DKm2)" ;
    rdfs:range xsd:decimal .

npdv:casingDiameter a owl:DatatypeProperty ;
    sql:column "wellbore_casing_and_lot.wlbCasingDiameter" ;
    sql:comment "Inner diameter of casing. (column: wlbCasingDiameter)" ;
    sql:datatype "VARCHAR(6) (column: wlbCasingDiameter)" ;
    sql:label "Casing diam. [inch] (column: wlbCasingDiameter)" ;
    rdfs:domain npdv:WellboreCasingAndLeakoffTest ;
    rdfs:range xsd:string .

npdv:casingType a owl:DatatypeProperty ;
    sql:column "wellbore_casing_and_lot.wlbCasingType" ;
    sql:comment "A typical wellbore will be cased with CONDUCTOR and SURFACE CONDUCTOR types of casing in the upper section, INTERMEDIATE casing through non-reservoir sections, and a PRODUCTION or plastic LINER types of casing, or even OPEN HOLE, in potential reservoir sections towards final total depth of the wellbore. (column: wlbCasingType)" ;
    sql:datatype "VARCHAR(10) (column: wlbCasingType)" ;
    sql:label "Casing type (column: wlbCasingType)" ;
    rdfs:domain npdv:WellboreCasingAndLeakoffTest ;
    rdfs:range xsd:string .

npdv:companyGroup a owl:DatatypeProperty ;
    sql:column "company.cmpGroup" ;
    sql:comment "Designation of company group that the company is associated with. This attribute was 1.2.2013 marked as NA (not applicable) because of data quality issue. Because of backwards compatibility the attrinute has not been deleted. (column: cmpGroup)" ;
    sql:datatype "VARCHAR(100) (column: cmpGroup)" ;
    sql:label "Group (column: cmpGroup)" ;
    rdfs:domain npdv:Company ;
    rdfs:range xsd:string .

npdv:coreIntervalBottom a owl:DatatypeProperty ;
    sql:column "wellbore_core.wlbCoreIntervalBottom" ;
    sql:comment "Bottom depth of core sample. (column: wlbCoreIntervalBottom)" ;
    sql:datatype "DECIMAL(13,6) (column: wlbCoreIntervalBottom)" ;
    sql:label "Core sample - bottom depth (column: wlbCoreIntervalBottom)" ;
    rdfs:domain npdv:WellboreCore ;
    rdfs:range xsd:decimal .

npdv:coreIntervalTop a owl:DatatypeProperty ;
    sql:column "wellbore_core.wlbCoreIntervalTop" ;
    sql:comment "Top depth of core sample. (column: wlbCoreIntervalTop)" ;
    sql:datatype "DECIMAL(13,6) (column: wlbCoreIntervalTop)" ;
    sql:label "Core sample - top depth (column: wlbCoreIntervalTop)" ;
    rdfs:domain npdv:WellboreCore ;
    rdfs:range xsd:decimal .

npdv:coreIntervalUOM a owl:DatatypeProperty ;
    rdfs:range xsd:string .

npdv:coreTotalLength a owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

npdv:coresIntervalUOM a owl:DatatypeProperty .

npdv:currentAreaSize a owl:DatatypeProperty .

