        "facility_fixed.fclNpdidFacility",
        "facility_moveable.fclNpdidFacility",
        "field.fldNpdidField",
        "field_reserves.fldNpdidField",
        "licence.prlNpdidLicence",
        "pipLine.pipNpdidPipe",
        "seis_acquisition.seaNpdidSurvey",
        "tuf_operator_hst.tufNpdidTuf",
        "tuf_owner_hst.tufNpdidTuf",
        "tuf_petreg_licence.tufNpdidTuf",
        "wellbore_development_all.wlbNpdidWellbore",
