npdv:FixedFacility a owl:Class ;
    npdv:definition "A facility or installation permanently located on the field during the lifetime of the field. Production ships are covered by this definition if they are intended to be permanently placed on the field.  Source: http://www.npd.no/en/About-us/Information-services/Dictionary/" ;
    sql:columns "dateSyncNPD,fclBelongsToKind,fclBelongsToName,fclBelongsToS,fclCurrentOperatorName,fclDateUpdated,fclDesignLifetime,fclEwCode,fclEwDeg,fclEwMin,fclEwSec,fclFactMapUrl,fclFactPageUrl,fclFunctions,fclGeodeticDatum,fclKind,fclName,fclNpdidFacility,fclNsCode,fclNsDeg,fclNsMin,fclNsSec,fclPhase,fclStartupDate,fclSurface,fclWaterDepth (table: facility_fixed)" ;
    sql:comment "'Permanently placed facility' is a generic term for all facilities that are placed on a field permanently. Floating production facilities, which in principle are mobile, come under this definition as they are meant to be permanently placed on the field. (table: facility_fixed)" ;
    sql:label "Facility: Fixed (table: facility_fixed)" ;
    sql:table "facility_fixed" ;
    rdfs:isDefinedBy "http://sws.ifi.uio.no/vocab/version/20130919/npd-facility" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty npdv:waterDepth ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:facilityType ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:status ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:idNPD ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:factPageURL ;
            owl:someValuesFrom owl:Thing ],
        [ a owl:Restriction ;
            owl:onProperty npdv:isSurfaceFacility ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:codeNS ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:dateSyncNPD ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:codeEW ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:factMapURL ;
            owl:someValuesFrom owl:Thing ],
        [ a owl:Restriction ;
            owl:onProperty npdv:name ;
            owl:someValuesFrom rdfs:Literal ],
        npdv:Facility .

npdv:Licensee a owl:Class ;
    npdv:definition "A physical or legal person, or several such persons, who, under the terms of the Petroleum Act or earlier jurisdiction, has a licence to search for, recover, transport or utilise petroleum. If a licence is awarded to several such persons together the expression licensee can cover both the licensees combined and the individual participant.  Source: http://www.npd.no/en/About-us/Information-services/Dictionary/" ;
    rdfs:isDefinedBy "http://sws.ifi.uio.no/vocab/version/20130919/npd-org" ;
    rdfs:subClassOf npdv:Agent .

npdv:Point a owl:Class ;
    rdfs:isDefinedBy "http://sws.ifi.uio.no/vocab/version/20130919/npd-geometry" ;
    rdfs:subClassOf geo:SpatialObject .

npdv:ProductionLicenceWorkObligation a owl:Class ;
    sql:columns "cmpLongName,cmpNpdidCompany,dateSyncNPD,prlDateValidTo,prlLicensingActivityName,prlName,prlNpdidLicence,prlTaskDateUpdated,prlTaskExpiryDate,prlTaskID,prlTaskName,prlTaskRefID,prlTaskStatusEn,prlTaskStatusNo,prlTaskTypeEn,prlTaskTypeNo,wlbName (table: licence_task)" ;
    sql:label "Production Licence: Work obligations (table: licence_task)" ;
    sql:table "licence_task" ;
    rdfs:isDefinedBy "http://sws.ifi.uio.no/vocab/version/20130919/npd-org" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty npdv:taskForLicence ;
            owl:someValuesFrom npdv:ProductionLicence ],
        [ a owl:Restriction ;
            owl:onProperty npdv:dateSyncNPD ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:name ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:status ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:dateTaskExpiry ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:taskType ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:taskID ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:taskForCompany ;
            owl:someValuesFrom npdv:Company ],
        <http://www.ifomis.org/bfo/1.1/span#Occurrent> .

npdv:TUFOwner a owl:Class ;
    sql:columns "cmpLongName,cmpNpdidCompany,dateSyncNPD,tufName,tufNpdidTuf,tufOwnerDateValidFrom,tufOwnerDateValidTo,tufOwnerShare (table: tuf_owner_hst)" ;
    sql:label "Transportation and Utilization Facilities: Owners (table: tuf_owner_hst)" ;
    sql:table "tuf_owner_hst" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty npdv:dateSyncNPD ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:TUFOwnerShare ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty ptl:TUFOwnerForLicence ;
            owl:someValuesFrom ptl:TUFacility ],
        [ a owl:Restriction ;
            owl:onProperty npdv:dateTUFOwnerValidFrom ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty ptl:TUFOwnerCompany ;
            owl:someValuesFrom npdv:Company ],
        npdv:Owner .

npdv:dateUpdated a owl:DatatypeProperty ;
    sql:column "bsns_arr_area.baaDateUpdated",
        "bsns_arr_area_area_poly_hst.baaAreaPolyDateUpdated",
        "bsns_arr_area_licensee_hst.baaLicenseeDateUpdated",
