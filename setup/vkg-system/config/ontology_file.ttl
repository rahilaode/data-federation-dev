        isc:Jurassic,
        isc:LowerJurassic ;
    gtrs-30:positionalUncertainty isc:BaseJurassicUncertainty ;
    gtrs-30:previousEra isc:Rhaetian,
        isc:Triassic,
        isc:UpperTriassic ;
    gts-30:stratotype isc:GSSPBaseJurassic .

