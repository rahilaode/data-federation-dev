npdv:ZValueTo a owl:DatatypeProperty ;
    sql:column "prlArea.prlAreaPolyToZvalue",
        "prlAreaSplitByBlock.prlAreaPolyToZvalue" ;
    sql:datatype "INTEGER (column: prlAreaPolyToZvalue)" ;
    rdfs:range xsd:integer .

