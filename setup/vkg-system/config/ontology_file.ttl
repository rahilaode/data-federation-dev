        "Foreign key wellbore_formation_top.wlbNpdidWellbore => wellbore_npdid_overview.wlbNpdidWellbore" ;
    rdfs:domain npdv:WellboreStratum ;
    rdfs:range npdv:Wellbore .

npdv:surveyType a owl:DatatypeProperty ;
    sql:column "seis_acquisition.seaSurveyTypeMain" ;
    sql:comment "Main type of seismic acquistion. Legal values are: 'Dyp seismikk', 'Grunn seismikk', 'Elektro magnetisk' (column: seaSurveyTypeMain)" ;
    sql:datatype "VARCHAR(100) (column: seaSurveyTypeMain)" ;
    sql:label "Main type (column: seaSurveyTypeMain)" ;
    rdfs:domain npdv:SeismicSurvey ;
    rdfs:range xsd:string .

