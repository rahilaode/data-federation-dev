npdv:BAA a owl:Class ;
    sql:columns "baaDateApproved,baaDateUpdated,baaDateUpdatedMax,baaDateValidFrom,baaDateValidTo,baaFactMapUrl,baaFactPageUrl,baaKind,baaName,baaNpdidBsnsArrArea,dateSyncNPD (table: bsns_arr_area)",
