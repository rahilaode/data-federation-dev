npdv:Field a owl:Class ;
    npdv:definition "One discovery, or a number of concentrated discoveries, which the licensees have decided to develop and for which the authorities have approved, or granted exemption for, a Plan for Development and Operation (PDO).  Source: http://www.npd.no/en/About-us/Information-services/Dictionary/" ;
    sql:columns "cmpLongName,cmpNpdidCompany,dateSyncNPD,fldCurrentActivitySatus,fldDateUpdated,fldDateUpdatedMax,fldFactMapUrl,fldFactPageUrl,fldName,fldNpdidField,fldNpdidOwner,fldOwnerKind,fldOwnerName,wlbCompletionDate,wlbName,wlbNpdidWellbore (table: field)" ;
    sql:comment "Fields on the Norwegian continental shelf. (table: field)" ;
    sql:label "Field (table: field)" ;
    sql:table "field" ;
    rdfs:isDefinedBy "http://sws.ifi.uio.no/vocab/version/20130919/npd-prod" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty npdv:currentFieldOperator ;
            owl:someValuesFrom npdv:Company ],
        [ a owl:Restriction ;
            owl:onProperty npdv:idNPD ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:factPageURL ;
            owl:someValuesFrom owl:Thing ],
        [ a owl:Restriction ;
            owl:onProperty npdv:discoveryWellbore ;
            owl:someValuesFrom npdv:Wellbore ],
        [ a owl:Restriction ;
            owl:onProperty npdv:name ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:status ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:dateSyncNPD ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:currentFieldOwner ;
            owl:someValuesFrom npdv:ProductionLicence ],
        [ a owl:Restriction ;
            owl:onProperty npdv:factMapURL ;
            owl:someValuesFrom owl:Thing ],
        <http://www.ifomis.org/bfo/1.1/snap#IndependentContinuant> .

