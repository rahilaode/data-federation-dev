npdv:degreesEW a owl:DatatypeProperty ;
    sql:column "facility_fixed.fclEwDeg",
        "seis_acquisition_coordinates_inc_turnarea.seaPolygonEWDeg",
        "wellbore_coordinates.wlbEwDeg",
        "wellbore_development_all.wlbEwDeg",
        "wellbore_exploration_all.wlbEwDeg",
        "wellbore_shallow_all.wlbEwDeg" ;
    sql:comment "Coordinate, east-west degrees (column: fclEwDeg)",
        "East West degrees for the point. (column: seaPolygonEWDeg)",
        "Geographic coordinate of the wellhead, east-west degrees. (column: wlbEwDeg)" ;
    sql:datatype "INTEGER (column: fclEwDeg)",
        "INTEGER (column: seaPolygonEWDeg)",
        "INTEGER (column: wlbEwDeg)" ;
    sql:label "EW degrees (column: fclEwDeg)",
        "EW degrees (column: seaPolygonEWDeg)",
        "EW degrees (column: wlbEwDeg)" ;
    rdfs:range xsd:integer .

npdv:degreesNS a owl:DatatypeProperty ;
    sql:column "facility_fixed.fclNsDeg",
        "seis_acquisition_coordinates_inc_turnarea.seaPolygonNSDeg",
