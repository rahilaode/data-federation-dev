npdv:BAAArea a owl:Class ;
    sql:columns "baaActive,baaAreaGeometryWKT,baaAreaPolyActive,baaAreaPolyDateValidFrom,baaAreaPolyDateValidTo,baaDateApproved,baaDateValidFrom,baaDateValidTo,baaFactMapUrl,baaFactPageUrl,baaKind,baaName,baaNpdidBsnsArrArea,baaNpdidBsnsArrAreaPoly (table: baaArea)",
        "baaAreaPolyArea,baaAreaPolyBlockName,baaAreaPolyDateUpdated,baaAreaPolyDateValidFrom,baaAreaPolyDateValidTo,baaAreaPolyNationCode2,baaAreaPolyNo,baaName,baaNpdidBsnsArrArea,dateSyncNPD (table: bsns_arr_area_area_poly_hst)" ;
    sql:label "Business Arrangement Area: Area (table: bsns_arr_area_area_poly_hst)",
        "Business arrangement areas with complete history for each area. (table: baaArea)" ;
    sql:table "baaArea",
        "bsns_arr_area_area_poly_hst" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty npdv:isActive ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:idNPD ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty geo:asWKT ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:polygonNo ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:dateSyncNPD ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:isGeometryOfFeature ;
            owl:someValuesFrom npdv:BAA ],
        [ a owl:Restriction ;
            owl:onProperty npdv:dateBaaAreaValidFrom ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:areaSize ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty npdv:country ;
            owl:someValuesFrom owl:Thing ],
        npdv:Area .

npdv:BAATransfer a owl:Class ;
    sql:columns "baaName,baaNpdidBsnsArrArea,baaTransferDateUpdated,baaTransferDateValidFrom,baaTransferDirection,baaTransferKind,baaTransferSdfi,baaTransferredInterest,cmpLongName,cmpNpdidCompany,dateSyncNPD (table: bsns_arr_area_transfer_hst)" ;
    sql:label "Business Arrangement Area: Transfers (table: bsns_arr_area_transfer_hst)" ;
