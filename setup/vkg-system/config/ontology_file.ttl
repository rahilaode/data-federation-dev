        "licence_transfer_hst.prlTransferDateUpdated",
        "wellbore_casing_and_lot.wlbCasingDateUpdated",
        "wellbore_core.wlbCoreDateUpdated",
        "wellbore_core_photo.wlbCorePhotoDateUpdated",
        "wellbore_development_all.wlbDateUpdated",
        "wellbore_document.wlbDocumentDateUpdated",
        "wellbore_dst.wlbDstDateUpdated",
