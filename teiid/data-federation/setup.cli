connect

# Deploy JDBC Drivers
deploy /opt/jboss/jdbc/mysql-connector-java-8.0.21.jar   
/subsystem=datasources/data-source=mysql-ds:add(jndi-name=java:/mysql-uni1, enabled=true, use-java-context=true, driver-name=mysql-connector-java-8.0.21.jar, connection-url="jdbc:mysql://mysql:3306/uni1",user-name=uni1, password=uni1pwd)
/subsystem=datasources/data-source=mysql-ds:enable

deploy /opt/jboss/jdbc/postgresql-42.2.14.jre7.jar
/subsystem=datasources/data-source=pgsql-ds:add(jndi-name=java:/pgsql-uni2, enabled=true, use-java-context=true, driver-name=postgresql-42.2.14.jre7.jar, connection-url="jdbc:postgresql://pgsql:5432/uni2",user-name=uni2, password=uni2pwd)
/subsystem=datasources/data-source=pgsql-ds:enable

# MongoDB Resource Adapter Configuration
# Note: mongodb resource adapter already exists, we just add connection definition
/subsystem=resource-adapters/resource-adapter=mongodb/connection-definitions=mongoDS:add(jndi-name="java:/mongoDS", class-name=org.teiid.resource.adapter.mongodb.MongoDBManagedConnectionFactory, enabled=true, use-java-context=true)
/subsystem=resource-adapters/resource-adapter=mongodb/connection-definitions=mongoDS/config-properties=RemoteServerList:add(value="mongo:27017")
/subsystem=resource-adapters/resource-adapter=mongodb/connection-definitions=mongoDS/config-properties=Username:add(value="root")
/subsystem=resource-adapters/resource-adapter=mongodb/connection-definitions=mongoDS/config-properties=Password:add(value="example")
/subsystem=resource-adapters/resource-adapter=mongodb/connection-definitions=mongoDS/config-properties=Database:add(value="people_db")
/subsystem=resource-adapters/resource-adapter=mongodb/connection-definitions=mongoDS/config-properties=AuthDatabase:add(value="admin")
/subsystem=resource-adapters/resource-adapter=mongodb:activate

# Deploy VDBs
deploy /opt/jboss/data-federation/universities-vdb.xml
# deploy /opt/jboss/data-federation/people-vdb.xml